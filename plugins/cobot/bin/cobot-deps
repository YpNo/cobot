#!/usr/bin/env python3
"""cobot-deps: dependency currency of the repository, through the ecosystems' own tools, cached.

Commands
  check [--fresh] [--json]   run the outdated and advisory tools (cached for 7 days while the lockfiles hold)
  brief                      one line from the cache, never runs a tool (the session brief)
  path                       the cache file

Reports, never upgrades (decision 21). Tools that are not installed are named, not installed.
"""

from __future__ import annotations

import json
import os
import sys
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # python3 -I drops the script dir
from _cobot_common import HelpRequested, UsageError, parse_cli, repo_root  # noqa: E402
from _cobot_deps import brief, cache_path, check, report  # noqa: E402


VALUE_OPTIONS: dict[str, set[str]] = {}
SWITCHES = {"check": {"fresh", "json"}}


def main(argv: list[str]) -> int:
    try:
        positional, _, flags = parse_cli(argv, VALUE_OPTIONS, SWITCHES)
    except HelpRequested:
        print(__doc__.strip())
        return 0
    except UsageError as error:
        print(f"cobot-deps: {error}\n\n{__doc__.strip()}", file=sys.stderr)
        return 2
    command = positional[0] if positional else ""
    root = repo_root(os.getcwd())
    today = date.today()
    if command == "check":
        data = check(root, today, force="fresh" in flags)
        print(json.dumps(data, indent=1) if "json" in flags else report(data, today))
    elif command == "brief":
        print(brief(root, today))
    elif command == "path":
        print(cache_path(root))
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
