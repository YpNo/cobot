#!/usr/bin/env python3
"""cobot-memory: the committed memory of a repository (.agent/), read and written for the orchestrator.

Commands
  path                             the resolved .agent directory (worktree-aware)
  init [--profile P] [--foreign] [--add-identity] [--trust-root]
                                   create CONTEXT, JOURNAL, FINDINGS from the templates; never overwrites
  stamp                            ok <sha> | missing — <reason>: is HEAD covered by the last verified stamp
  trust                            trusted: <reason> | untrusted: <reason>
  check                            mode, trust, files, journal order, brief size; exit 1 on a bad debug record
  debug list [--open]              the debug records, newest first: status, name, title
  debug check [FILE]               a debug record (or every one) without secret-shaped lines or excerpts over
                                   20 lines or 2000 characters; exit 1 naming file and line
  brief [--budget N] [--no-trust-check]   the session brief (default budget 6000 chars)
  journal add [ENTRY]              append the entry (argument or stdin): ## YYYY-MM-DD — title, then the fields
  findings add "<seen>" "<observation>" [--goes-to X] | findings list [--open] | findings close F-nn "<reason>"
  noticed add [TEXT] | noticed list | noticed clear
                                   builders' Noticed: items parked by the report hook, one per line, for wrap
                                   --goes-to records where a finding is headed (open → X); it stays open
                                   until findings close
  learn [--dry-run] [--keep-assumed] [JSON]  apply a knowledge delta (argument or stdin) to .agent/knowledge/<topic>.md
  learn --promote [--source DIR] [--in-place] [JSON|TOPIC]
                                   also carry the general entries (or a topic's pending general lines) into the
                                   cobot checkout: a learn/<topic> branch in a worktree, or in place
  knowledge [--stale] [--json] [--brief] [SKILL]   dated knowledge lines per skill: age, stale, reported
  compact [--keep N] [--summary TEXT] [--dry-run] [--force]
                                   once JOURNAL.md passes 400 lines, fold every entry but the last N (10) into one
                                   dated entry (a model summary when given, else a digest); the raw text goes to
                                   .agent/JOURNAL-archive.md
  risks add RULE FILE SYMBOL --why TEXT [--by WHO] [--days N]   accept a sweep finding for at most 90 days
  risks list                       accepted risks with their expiry state

-h/--help after any command prints this usage and runs nothing; an unknown option ends with exit 2;
-- ends the options, so a payload may start with dashes.

Project entries go to .agent/; general entries reach the plugin only through --promote (an ask action).
"""

from __future__ import annotations

import json
import os
import re
import shlex
import sys
import unicodedata
import urllib.parse
from datetime import date
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # python3 -I drops the script dir
from _cobot_common import (  # noqa: E402
    SECRET_RE,
    HelpRequested,
    UsageError,
    checkout_root,
    cobot_config_dir,
    config_dir,
    data_dir,
    debug_record_problems,
    external_memory,
    git,
    git_bytes,
    host_owner_repo,
    memory_dir,
    parse_cli,
    plugin_root,
    read_lines,
    remote_owners,
    remotes,
    repo_root,
    repo_trust,
    root_commits,
)
from _cobot_knowledge import (  # noqa: E402
    STATUSES,
    Index,
    brief_line,
    claim_key,
    format_line,
    place,
    promote,
    report,
    scan_memory,
    scan_plugin,
    source_checkout,
    summaries,
)

DEFAULT_BUDGET = 6000
CONTEXT_CAP = 2500  # the least CONTEXT.md gets in the brief
# what a capped brief keeps first, in this order of priority; each only when it fits
KEPT_SECTIONS = ("verified commands", "constraints", "environment")
CONTEXT_MAX = 4000  # the most, when a short journal leaves room
ENTRY_CAP = 1200
SPECS_SHOWN = 3  # the brief names the newest specs only; the folder lists them all
SPEC_HEAD_CHARS = 400  # where a spec's header line, with its date, sits
SPEC_DATE_RE = re.compile(r"\bdate: (\d{4}-\d{2}-\d{2})\b")
# a debug record's head (skills/debug/template.md): its status and its title (spec debug-path, story 6)
DEBUG_STATUS_RE = re.compile(r"(?im)^status:\s*([a-z]+)")
DEBUG_TITLE_RE = re.compile(r"(?m)^# (?:Debug\s*[—–-]\s*)?(.+)$")
FINDINGS_FLOOR = 400
SECTION_MARKER_RESERVE = 120
BLOCK_SEPARATORS = 80  # headings and blank lines between the brief's blocks
PART_SEPARATOR = "\n\n"  # between the text, the findings and each tail line
KNOWLEDGE_CAP = 80
ENTRY_RE = re.compile(r"^## (\d{4}-\d{2}-\d{2})\b", re.M)
STAMP_RE = re.compile(r"^verified: (?:(tree) )?([0-9a-f]{7,64})(\+working-tree)?( · .*)?$", re.M)
DOC_ONLY_PREFIXES = (".agent/", "docs/", "CHANGELOG.md", "README.md")
DOC_ROOT_ENTRIES = frozenset({".agent", "docs", "CHANGELOG.md", "README.md"})  # the same, as root entries
FINDING_RE = re.compile(r"^\| *(F-\d+) *\|(.*?)\|(.*?)\|(.*?)\|\s*$")
OPEN_RE = re.compile(r"(?i)open(?![a-z])")  # "", "open", "open → E2" are open; "opened issue 12" is a reason
ROUTED = "open → "
TRUST_NOT_RECORDED = "trust not recorded:"  # init exits 1 when its output holds this
# the CONTEXT template's verified rows (claiming nothing), and the row init writes on a new tree
PLACEHOLDER_ROWS = (
    "| unit tests | `<command>` | <not run yet> | — |\n"
    "| lint | `<command>` | <not run yet> | — |\n"
    "| build | `<command>` | <not run yet> | — |\n"
)
NONE_YET_ROW = "| — | none yet: the first spec's scaffold task records them | — | {{DATE}} |\n"
NOTICED_FILE = "noticed.md"  # builders' notices the report hook parked for wrap (memory-and-ship)
NOTICED_HEAD = "# Noticed\n\nBuilders' notices waiting for /cobot:wrap: file each as a finding, or drop it.\n"
NOTICED_LINE_RE = re.compile(r"^- \d{4}-\d{2}-\d{2} · (.+)$", re.M)
NOTICE_LIMIT = 300  # characters an item keeps
KNOWN_AGENT_FILES = frozenset({"CONTEXT.md", "JOURNAL.md", "FINDINGS.md", "JOURNAL-archive.md", NOTICED_FILE})
AGENT_FILE_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\.md")
HEADER_FIELD_RE = re.compile(r"(?m)^([a-z]+):")
DROPPED_RE = re.compile(r"sections dropped: (.*)")
FIELD_PRIORITY = ("Open", "Next", "Changed", "Why", "Proof")
FIELD_START = re.compile(r"[A-Z][A-Za-z ]{0,30}:")  # "Changed:", "Not done:"; indented lines continue
JOURNAL_COMPACT_LINES = 400
OLD_RULES_NAME = "partner.rules"  # the name before ADR-0004; still reported by check
# what Antigravity (agy) loads from a customization root, and .agent/ is one (a legacy path,
# scanned one level deep): cobot never writes these there, so check names any it finds
AGY_DISCOVERED = ("hooks.json", "plugins", "plugins.json", "rules", "skills", "skills.json", "workflows")
COMPACT_KEEP = 10
RISK_RE = re.compile(r"^\| *(R-\d+) *\|(.*?)\|(.*?)\|(.*?)\|(.*?)\|(.*?)\|(.*?)\|\s*(\d{4}-\d{2}-\d{2})\s*\|\s*$")
RISK_MAX_DAYS = 90


class Memory:
    def __init__(self, cwd: str | None = None) -> None:
        self.cwd = Path(os.environ.get("COBOT_RULES_PROJECT_DIR") or cwd or os.getcwd())
        self.root = repo_root(cwd)
        self.checkout = checkout_root(cwd)  # HEAD of the branch at hand, a worktree's own
        self.dir = memory_dir(cwd)
        self._tree: str | None = None

    def tree(self) -> str:
        """tree_state of the working directory, computed once per Memory."""
        if self._tree is None:
            self._tree = tree_state(self.cwd)
        return self._tree

    # ---------------------------------------------------------------- trust

    def external_path(self) -> Path | None:
        return external_memory(self.root)

    def trust(self) -> tuple[bool, str]:
        return repo_trust(self.checkout, self.dir)  # a submodule's own remotes, not its superproject's

    # ---------------------------------------------------------------- files

    def read(self, name: str) -> str:
        path = self.dir / name
        return path.read_text(encoding="utf-8") if path.is_file() else ""

    def journal_entries(self) -> list[tuple[str, str]]:
        """(date, text) per entry, newest first; ties keep the later position first."""
        text = self.read("JOURNAL.md")
        starts = [m.start() for m in ENTRY_RE.finditer(text)]
        entries = []
        for i, start in enumerate(starts):
            end = starts[i + 1] if i + 1 < len(starts) else len(text)
            chunk = text[start:end].strip()
            entries.append((chunk[3:13], chunk))
        indexed = list(enumerate(entries))
        indexed.sort(key=lambda item: (item[1][0], item[0]), reverse=True)
        return [entry for _, entry in indexed]

    def findings(self) -> list[tuple[str, str, str, str]]:
        rows = [m.groups() for line in self.read("FINDINGS.md").splitlines() if (m := FINDING_RE.match(line))]
        return [tuple(cell.strip() for cell in row) for row in rows]

    def open_findings(self) -> list[tuple[str, str, str, str]]:
        return [f for f in self.findings() if not f[3] or OPEN_RE.match(f[3])]

    def knowledge_topics(self) -> list[str]:
        folder = self.dir / "knowledge"
        return sorted(p.stem for p in folder.glob("*.md")) if folder.is_dir() else []

    def debug_records(self) -> list[tuple[str, str, str]]:
        """``(name, status, title)`` for each record under ``debug/``, newest first (the names are
        dated); a record without a ``status:`` line reads ``unknown``."""
        folder = self.dir / "debug"
        records = []
        for path in sorted(folder.glob("*.md"), reverse=True) if folder.is_dir() else []:
            head = path.read_text(encoding="utf-8", errors="replace")[:SPEC_HEAD_CHARS]
            status = DEBUG_STATUS_RE.search(head)
            title = DEBUG_TITLE_RE.search(head)
            records.append((path.stem, status.group(1).lower() if status else "unknown",
                            title.group(1).strip() if title else path.stem))  # fmt: skip
        return records

    def specs(self) -> list[str]:
        folder = self.dir / "specs"
        return sorted(p.stem for p in folder.glob("*.md")) if folder.is_dir() else []

    def specs_by_date(self) -> list[str]:
        """Spec names, newest first by the ``date:`` in their head; undated ones last, by name."""
        dated, undated = [], []
        for name in self.specs():
            head = (self.dir / "specs" / f"{name}.md").read_text(encoding="utf-8", errors="replace")[:SPEC_HEAD_CHARS]
            found = SPEC_DATE_RE.search(head)
            if found:
                dated.append((found.group(1), name))
            else:
                undated.append(name)
        return [name for _, name in sorted(dated, reverse=True)] + undated


# ---------------------------------------------------------------- tree state (new projects)

TREE_NOT_REPOSITORY = "not a git repository"
TREE_INSIDE_ANOTHER = "inside another repository"
TREE_EXISTING = "existing"
TREE_NEW_NO_COMMIT = "new (no commit)"
TREE_NEW_BOOTSTRAP = "new (bootstrap files only)"
BOOTSTRAP_DIRS = (".agent", ".claude")
BOOTSTRAP_ROOT_FILE = re.compile(
    r"(?i)\.gitignore|\.gitattributes|\.editorconfig|(readme|changelog)(\.(md|markdown|txt|rst|adoc))?"
    r"|(licen[cs]e|copying)(-[a-z0-9.-]+)?(\.(md|txt))?"
)
# _cobot_common.git turns core.fsmonitor off: an untracked scan would run the repository's program
UNTRACKED = ["--others", "--exclude-standard", "--directory", "--no-empty-directory"]


def listed_paths(top: Path) -> list[str] | None:
    """Tracked and untracked, non-ignored paths; an untracked directory is one ``dir/`` entry."""
    out = git(["ls-files", "-z", "--cached", *UNTRACKED], top)
    return None if out is None else sorted({path for path in out.split("\0") if path})


def is_bootstrap(path: str) -> bool:
    head = path.split("/", 1)[0]
    if head in BOOTSTRAP_DIRS:
        return True
    return "/" not in path.rstrip("/") and BOOTSTRAP_ROOT_FILE.fullmatch(path) is not None


def inside_some_repository(folder: Path) -> bool:
    return any((parent / ".git").exists() for parent in (folder, *folder.parents))


def repository_probe(here: Path) -> str | None:
    """TREE_NOT_REPOSITORY, TREE_EXISTING when git did not answer inside a repository, or None for
    a work tree. Cheap: no file scan, so it may run before the trust check."""
    probe = git(["rev-parse", "--is-inside-work-tree"], here)
    if probe is None:
        return TREE_EXISTING if inside_some_repository(here) else TREE_NOT_REPOSITORY
    return None if probe == "true" else TREE_NOT_REPOSITORY  # a bare repository, or inside .git


def nothing_below(here: Path) -> bool:
    """No tracked and no untracked, non-ignored file under a subfolder (a dotfiles repository at ~)."""
    tracked = git(["ls-files", "--", "."], here)
    untracked = git(["ls-files", *UNTRACKED, "--", "."], here)
    return tracked == "" and untracked == ""


def tree_state(cwd: Path) -> str:
    """One fixed label (never a file name: the tree is repository content). New is decided on the
    files alone: every listed path is a bootstrap file. Any git failure reads as existing, so a
    slow or broken git never turns an existing codebase into a new project."""
    here = Path(cwd).resolve()
    early = repository_probe(here)
    if early:
        return early
    top = git(["rev-parse", "--show-toplevel"], here)
    if top is None:
        return TREE_EXISTING
    if Path(top).resolve() != here:
        return TREE_INSIDE_ANOTHER if nothing_below(here) else TREE_EXISTING
    paths = listed_paths(here)
    if paths is None or not all(is_bootstrap(path) for path in paths):
        return TREE_EXISTING
    has_commit = git(["rev-parse", "--verify", "--quiet", "HEAD"], here) is not None
    return TREE_NEW_BOOTSTRAP if has_commit else TREE_NEW_NO_COMMIT


# ---------------------------------------------------------------- brief


def context_head(text: str, limit: int = CONTEXT_CAP) -> str:
    kept: list[str] = []
    for line in text.splitlines():
        if line.startswith("## Shape") or line.startswith("## Applies"):
            break
        kept.append(line)
    return cap_sections("\n".join(kept).strip(), limit)


TRUNCATED_MARKER = "\n…(truncated)"


def cap(text: str, limit: int) -> str:
    if len(text) <= limit:
        return text
    return text[: limit - len(TRUNCATED_MARKER)].rstrip() + TRUNCATED_MARKER


def section_name(section: str) -> str:
    return section.splitlines()[0].lstrip("# ").strip() if section.startswith("## ") else "preamble"


def cap_sections(text: str, limit: int) -> str:
    """Cap on ``## `` boundaries: the preamble, then the sections in KEPT_SECTIONS in their
    priority order, get room first, each only when it fits (a huge Environment never displaces the
    commands); then the others in document order until one does not fit. Kept sections keep their
    document order; the rest are dropped and named, so the owner can see what the brief no longer
    carries and reorder CONTEXT.md if it matters."""
    if len(text) <= limit:
        return text
    sections = [section for section in re.split(r"(?m)^(?=## )", text) if section]
    budget = limit - SECTION_MARKER_RESERVE
    priority = {name: rank for rank, name in enumerate(KEPT_SECTIONS)}
    kept_names = [i for i, s in enumerate(sections) if i and section_name(s).lower() in priority]
    first = [0, *sorted(kept_names, key=lambda i: priority[section_name(sections[i]).lower()])]
    chosen: set[int] = set()
    used = 0
    for i in first:
        if used + len(sections[i]) <= budget:
            chosen.add(i)
            used += len(sections[i])
    for i, section in enumerate(sections):
        if i in chosen or i in first:
            continue
        if used + len(section) > budget:
            break
        chosen.add(i)
        used += len(section)
    kept = [s for i, s in enumerate(sections) if i in chosen]
    dropped = [section_name(s) for i, s in enumerate(sections) if i not in chosen]
    if not kept:
        return cap(text, limit)
    names = ", ".join(dropped)
    if len(names) > SECTION_MARKER_RESERVE - 30:
        names = names[: SECTION_MARKER_RESERVE - 31] + "…"
    return "".join(kept).rstrip() + f"\n…(truncated) sections dropped: {names}"


def trim_entry(entry: str) -> str:
    """Keep the heading, then Open and Next, then the rest, inside ENTRY_CAP."""
    if len(entry) <= ENTRY_CAP:
        return entry
    lines = entry.splitlines()
    heading, body = lines[0], lines[1:]

    def rank(block: list[str]) -> int:
        for i, field in enumerate(FIELD_PRIORITY):
            if block[0].startswith(f"{field}:"):
                return i
        return len(FIELD_PRIORITY)

    # a field and its continuation lines move together (legacy entries indent them)
    blocks: list[list[str]] = []
    for line in body:
        if blocks and not FIELD_START.match(line):
            blocks[-1].append(line)
        else:
            blocks.append([line])
    ordered = [line for block in sorted(blocks, key=rank) for line in block]
    out, used = [heading], len(heading)
    for line in ordered:
        if used + len(line) + 1 > ENTRY_CAP:
            out.append("…(entry truncated)")
            break
        out.append(line)
        used += len(line) + 1
    return "\n".join(out)


def other_agent_files(mem: Memory) -> list[str]:
    """Markdown files in .agent/ beyond the ones the brief reads (ARCHITECTURE.md, a legacy
    HANDOFF.md): named, never loaded."""
    if not mem.dir.is_dir():
        return []
    names = (p.name for p in mem.dir.glob("*.md") if p.is_file())
    return sorted(n for n in names if n not in KNOWN_AGENT_FILES and AGENT_FILE_RE.fullmatch(n))


ONBOARD_ASK = "Ask the owner to type /cobot:onboard."


NOT_A_REPOSITORY_LINE = "cobot memory: not a git repository; nothing loaded."


def no_memory_line(mem: Memory) -> str:
    """The brief of a folder without CONTEXT.md, by tree state."""
    state = mem.tree()
    if state == TREE_NOT_REPOSITORY:
        return NOT_A_REPOSITORY_LINE
    if state == TREE_INSIDE_ANOTHER:
        return f"cobot memory: none yet (inside another repository: {mem.root}). {ONBOARD_ASK}"
    label = "new project" if state.startswith("new") else "existing repository"
    return f"cobot memory: none yet ({label}). {ONBOARD_ASK}"


def build_brief(mem: Memory, budget: int, trust_check: bool = True) -> str:
    has_context = (mem.dir / "CONTEXT.md").is_file()
    if not has_context and repository_probe(mem.cwd.resolve()) == TREE_NOT_REPOSITORY:
        return NOT_A_REPOSITORY_LINE
    if trust_check:
        trusted, reason = mem.trust()
        if not trusted:  # no file scan before trust
            return f"cobot memory: UNTRUSTED repository ({reason}); .agent/ not loaded. {ONBOARD_ASK}"
    if not has_context:
        return no_memory_line(mem)
    entries = mem.journal_entries()[:2]
    journal_block = "## JOURNAL (latest)\n" + "\n\n".join(trim_entry(e[1]) for e in entries) if entries else ""
    findings = mem.open_findings()
    open_debug = sum(1 for _, status, _ in mem.debug_records() if status == "open")
    debug_note = f"; debug: {open_debug} open" if open_debug else ""
    findings_block = f"## FINDINGS open: 0{debug_note}" if debug_note else ""
    if findings:
        rows = "\n".join(f"| {a} | {b} | {c} | {d} |" for a, b, c, d in findings[-3:])
        findings_block = f"## FINDINGS open: {len(findings)}{debug_note}\n{rows}"
    tail = []
    if mem.knowledge_topics():
        tail.append("knowledge: " + ", ".join(mem.knowledge_topics()))
    specs = mem.specs_by_date()
    if len(specs) > SPECS_SHOWN:
        tail.append(f"specs: {len(specs)}, latest {', '.join(specs[:SPECS_SHOWN])}; all in .agent/specs/")
    elif specs:
        tail.append("specs: " + ", ".join(sorted(specs)))
    others = other_agent_files(mem)
    if others:
        tail.append("also in .agent (read on demand): " + ", ".join(others))
    tail_room = sum(len(PART_SEPARATOR) + len(t) for t in tail)  # the tail is never cut
    findings_room = len(PART_SEPARATOR) + min(FINDINGS_FLOOR, len(findings_block)) if findings_block else 0
    reserve = findings_room + tail_room
    room = budget - reserve - len(journal_block) - BLOCK_SEPARATORS
    context = context_head(mem.read("CONTEXT.md"), max(CONTEXT_CAP, min(CONTEXT_MAX, room)))
    blocks = [block for block in ("## CONTEXT\n" + context if context else "", journal_block) if block]
    text = cap("\n\n".join(blocks), max(budget - reserve, 200))
    parts = [text]
    if findings_block:
        left = budget - len(text) - len(PART_SEPARATOR) - tail_room
        parts.append(cap(findings_block, max(left, FINDINGS_FLOOR)))
    parts.extend(tail)
    return PART_SEPARATOR.join(p for p in parts if p)


# ---------------------------------------------------------------- writes


def template(name: str, profile: str, repo_name: str, new_tree: bool = False) -> str:
    """A memory template filled in; on a new tree, CONTEXT.md's verified table holds the one
    ``none yet`` row instead of the placeholders (F-38: nothing ran, so nothing is claimed)."""
    text = (plugin_root() / "skills" / "onboard" / "templates" / name).read_text(encoding="utf-8")
    if new_tree and name == "CONTEXT.md":
        text = text.replace(PLACEHOLDER_ROWS, NONE_YET_ROW)
    return text.replace("{{PROFILE}}", profile).replace("{{NAME}}", repo_name).replace("{{DATE}}", date.today().isoformat())


def never_push_rules(remote_map: dict[str, str]) -> list[str]:
    """Project-layer lines denying a push to every remote except origin, by name and by URL stem."""
    rules: list[str] = []
    for name, url in sorted(remote_map.items()):
        if name == "origin":
            continue
        rules.append(f"never Bash(git push {name}*)")
        stem = url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1].removesuffix(".git")
        if stem and stem != name:
            rules.append(f"never Bash(git push *{stem}*)")
    return rules


def write_never_push_rules(mem: Memory, external: Path) -> list[str]:
    """Append the never-push lines to the external memory's cobot.rules; report what was added."""
    rules = never_push_rules(remotes(mem.root))
    if not rules:
        return []
    path = external / "cobot.rules"
    if not path.exists():
        path.write_text("# cobot project rules (foreign mode): remotes other than origin are never push targets\n")
    added = [rule for rule in rules if append_unique(path, rule)]
    return [f"rules: {rule} ({path})" for rule in added]


def cmd_init(mem: Memory, options: dict[str, str], flags: set[str]) -> str:
    if "trust-root" in flags and not root_commits(mem.root):
        return (
            "init: --trust-root found no commit (or git did not answer); nothing written. Make the first "
            'commit (git commit --allow-empty -m "chore: initial commit"), then run init --trust-root again.'
        )
    lines = []
    if "foreign" in flags:
        external = mem.external_path()
        if external is None:
            return "init: --foreign needs an origin remote to derive the external path"
        external.mkdir(parents=True, exist_ok=True)
        if mem.dir.exists() and not mem.dir.is_symlink():
            return f"init: {mem.dir} exists and is not a symlink; move it aside first"
        if not mem.dir.is_symlink():
            mem.dir.symlink_to(external, target_is_directory=True)
        exclude = mem.root / ".git" / "info" / "exclude"
        if exclude.parent.is_dir() and ".agent" not in read_lines(exclude):
            with exclude.open("a", encoding="utf-8") as handle:
                handle.write(".agent\n")
        lines.append(f"foreign mode: {mem.dir} -> {external}; .agent excluded from git (.git/info/exclude)")
        lines.extend(write_never_push_rules(mem, external))
    mem.dir.mkdir(parents=True, exist_ok=True)
    profile = options.get("profile", "library")
    new_tree = mem.tree().startswith("new")
    for name in ("CONTEXT.md", "JOURNAL.md", "FINDINGS.md"):
        target = mem.dir / name
        if target.exists():
            lines.append(f"kept {target}")
        else:
            target.write_text(template(name, profile, mem.root.name, new_tree), encoding="utf-8")
            lines.append(f"wrote {target}")
    if "add-identity" in flags:
        lines.append(add_identity(mem))
    if "trust-root" in flags:
        lines.append(add_root_commit(mem))
    return "\n".join(lines)


def append_unique(path: Path, line: str) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    if line in read_lines(path):
        return False
    with path.open("a", encoding="utf-8") as handle:
        handle.write(line + "\n")
    return True


def trust_not_recorded(mem: Memory, path: Path, error: OSError, flag: str) -> str:
    """The owner's way out when Bash cannot write the trust files: Claude Code's sandbox keeps most
    of the config directory read-only to Bash, even with an allowWrite entry, so only the owner's
    own shell can record trust. The session never works around it."""
    return (
        f"{TRUST_NOT_RECORDED} cannot write {path} ({error.strerror}); Claude Code's sandbox keeps the"
        f" config directory read-only to Bash. The memory files above are written. The owner runs, in"
        f" their own terminal: cd {shlex.quote(str(mem.root))} && {config_prefix()}"
        f"{shlex.quote(str(Path(__file__).resolve()))} init {flag}"
    )


def config_prefix() -> str:
    """``CLAUDE_CONFIG_DIR=<dir> `` when this run has one: a command the owner runs elsewhere must
    write and read the same trust files (F-47: init and check disagreed on the folder)."""
    value = os.environ.get("CLAUDE_CONFIG_DIR")
    return f"CLAUDE_CONFIG_DIR={shlex.quote(value)} " if value else ""


def trust_file_note(trusted: bool) -> str:
    """Where trust is read, shown when it is not given."""
    return "" if trusted else f" (trust file: {cobot_config_dir()})"


def add_identity(mem: Memory) -> str:
    origin = remotes(mem.root).get("origin")
    parts = host_owner_repo(origin) if origin else None
    if not parts:
        return "identity: no origin remote to take the owner from"
    line = f"{parts[0]}/{parts[1]}"
    path = cobot_config_dir() / "identities"
    try:
        added = append_unique(path, line)
    except OSError as error:
        return trust_not_recorded(mem, path, error, "--add-identity")
    return f"identity {'added' if added else 'already present'}: {line} (in {path})"


def add_root_commit(mem: Memory) -> str:
    roots = root_commits(mem.root)
    if not roots:
        return "trust-root: no commit yet"
    path = cobot_config_dir() / "trusted"
    try:
        added = append_unique(path, f"{roots[0]} {mem.root.name}")
    except OSError as error:
        return trust_not_recorded(mem, path, error, "--trust-root")
    where = f"added to {path}" if added else f"already present in {path}"
    return f"root commit {where}: {roots[0][:12]} ({mem.root.name})"


def read_payload(positional: list[str]) -> str:
    """The payload: the remaining argument when one is given, else stdin; a terminal is not waited on."""
    if positional:
        return positional[0]
    if sys.stdin.isatty():
        return ""
    return sys.stdin.read()


def cmd_journal_add(mem: Memory, entry: str, check_only: bool = False) -> str:
    """Append a valid entry; with ``check_only``, validate and write nothing. ``main`` exits 1 on
    any other answer, so ``journal add … && git commit`` stops at an invalid entry (F-41)."""
    entry = entry.strip()
    if not re.match(r"^## \d{4}-\d{2}-\d{2} — .+", entry):
        return "journal: the entry must start with '## YYYY-MM-DD — title'"
    missing = [f for f in ("Changed:", "Why:", "Proof:") if f not in entry]
    if missing:
        return f"journal: missing fields {', '.join(missing)}"
    if check_only:
        return "journal: valid"
    path = mem.dir / "JOURNAL.md"
    text = path.read_text(encoding="utf-8") if path.is_file() else "# Journal\n"
    path.write_text(text.rstrip("\n") + "\n\n" + entry + "\n", encoding="utf-8")
    return f"journal: appended to {path}"


def noticed(mem: Memory) -> list[str]:
    return NOTICED_LINE_RE.findall(mem.read(NOTICED_FILE))


def noticed_refusal(mem: Memory) -> str:
    """Why ``noticed.md`` may not be touched: an untrusted or absent memory, or a file that is a
    symlink or resolves outside the memory folder (a merged link would make the hook write
    elsewhere). Empty when it may."""
    trusted, _ = mem.trust()
    if not trusted or not mem.dir.is_dir():
        return "noticed: untrusted or absent memory, nothing parked"
    path = mem.dir / NOTICED_FILE
    if path.is_symlink() or (path.exists() and not path.resolve().is_relative_to(mem.dir.resolve())):
        return "noticed: refused, .agent/noticed.md is a link; remove it"
    return ""


def cmd_noticed_add(mem: Memory, text: str) -> str:
    """Park each line of ``text`` as a dated notice, once; in a trusted memory only (the hook runs
    in whatever checkout the session is in)."""
    refusal = noticed_refusal(mem)
    if refusal:
        return refusal
    seen = set(noticed(mem))
    fresh: list[str] = []
    for raw in text.splitlines():
        item = re.sub(r"[\x00-\x1f\x7f]", " ", raw).strip()[:NOTICE_LIMIT]
        if item and item not in seen:
            seen.add(item)
            fresh.append(item)
    if fresh:
        path = mem.dir / NOTICED_FILE
        current = path.read_text(encoding="utf-8") if path.is_file() else NOTICED_HEAD
        if current == NOTICED_HEAD:
            current += "\n"  # a blank line between the head and the first item
        today = date.today().isoformat()
        path.write_text(current + "".join(f"- {today} · {item}\n" for item in fresh), encoding="utf-8")
    return f"noticed: {len(fresh)} parked"


def cmd_noticed_list(mem: Memory) -> str:
    refusal = noticed_refusal(mem)
    if refusal:
        return refusal
    items = noticed(mem)
    return "\n".join(items) if items else "noticed: none"


def cmd_noticed_clear(mem: Memory) -> str:
    refusal = noticed_refusal(mem)
    if refusal:
        return refusal
    path = mem.dir / NOTICED_FILE
    if path.is_file():
        path.write_text(NOTICED_HEAD, encoding="utf-8")
    return "noticed: cleared"


def next_finding_number(mem: Memory) -> int:
    numbers = [int(f[0][2:]) for f in mem.findings()]
    return max(numbers, default=0) + 1


def cmd_findings_add(mem: Memory, seen: str, observation: str, goes_to: str) -> str:
    path = mem.dir / "FINDINGS.md"
    if not path.is_file():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(template("FINDINGS.md", "", mem.root.name), encoding="utf-8")
    number = f"F-{next_finding_number(mem):02d}"
    clean = [s.replace("|", "/").replace("\n", " ").strip() for s in (seen, observation, goes_to)]
    if clean[2] and not OPEN_RE.match(clean[2]):
        clean[2] = ROUTED + clean[2]
    with path.open("a", encoding="utf-8") as handle:
        handle.write(f"| {number} | {clean[0]} | {clean[1]} | {clean[2]} |\n")
    return f"findings: {number} added"


def cmd_findings_list(mem: Memory, only_open: bool) -> str:
    rows = mem.open_findings() if only_open else mem.findings()
    if not rows:
        return "findings: none" + (" open" if only_open else "")
    return "\n".join(f"{a} · {b} · {c} · {d or 'open'}" for a, b, c, d in rows)


def cmd_findings_close(mem: Memory, number: str, reason: str) -> str:
    path = mem.dir / "FINDINGS.md"
    lines = path.read_text(encoding="utf-8").splitlines() if path.is_file() else []
    for i, line in enumerate(lines):
        match = FINDING_RE.match(line)
        if match and match.group(1) == number:
            lines[i] = f"| {number} | {match.group(2)} | {match.group(3)} | {reason.replace('|', '/')} |"
            path.write_text("\n".join(lines) + "\n", encoding="utf-8")
            return f"findings: {number} -> {reason}"
    return f"findings: {number} not found"


def knowledge_line(entry: dict) -> str:
    return format_line(entry, date.today())


def is_general(entry: dict) -> bool:
    return entry.get("scope") in ("general", "plugin")


def pending_general(mem: Memory, topic: str) -> list[dict]:
    """Lines tagged ``(general)`` in ``.agent/knowledge/<topic>.md``, as delta entries."""
    entries = []
    for line in scan_memory(mem.dir).get(f"knowledge/{topic}", []):
        if line.claim.endswith("(general)"):
            claim = re.sub(r"\s*\(general\)\s*$", "", line.claim)
            entries.append({"claim": claim, "status": line.status, "source": line.source, "checked": line.checked.isoformat(), "scope": "general"})
    return entries


def filter_delta(delta: dict, keep_assumed: bool) -> tuple[list[dict], list[str]]:
    kept, skipped = [], []
    seen: set[str] = set()
    for entry in delta.get("entries", []):
        claim = str(entry.get("claim", "")).strip()
        status = str(entry.get("status", "")).strip()
        key = claim_key(claim)
        if not claim or status not in STATUSES:
            skipped.append(f"malformed: {claim[:50] or '<empty>'}")
        elif status == "assumed" and not keep_assumed:
            skipped.append(f"assumed, not written: {claim[:50]}")
        elif key in seen:
            skipped.append(f"duplicate in delta: {claim[:50]}")
        elif status != "assumed" and not str(entry.get("source", "")).strip():
            skipped.append(f"no source: {claim[:50]}")
        else:
            seen.add(key)
            kept.append({**entry, "claim": claim, "status": status})
    return kept, skipped


def slug(text: str) -> str:
    return re.sub(r"[^a-z0-9-]+", "-", text.lower()).strip("-")


RUN_ID_RE = re.compile(r"(?i)(?:^|[/\s])actions/runs/\d+|/pipelines/\d+(?:\b|/)|/-/jobs/\d+")
HOME_PATH_RE = re.compile(r"(?:/home|/Users)/(?!<)[^/\s<>]+|/root/|(?<![\w])[A-Za-z]:\\")
SNAPSHOT_RE = re.compile(
    r"(?i)\b(?:latest|newest)(?:\s+\w+)?\s+is\s+v?\d|\bas of (?:today|\d{4}-\d{2}-\d{2})\b"
)


def lint_text(text: str) -> str:
    """The text as a reader sees it: URL-decoded, and NFKC-folded (a fullwidth letter is a letter)."""
    return unicodedata.normalize("NFKC", urllib.parse.unquote(text))


def promote_lint(entries: list[dict], owners: set[str], exempt: set[str], allow_reported: bool) -> tuple[list[dict], list[str]]:
    """Entries fit for the plugin, and a reason for each refused one (spec memory-and-ship,
    story 4): a run id, a user's home path, a release snapshot, an ``owner/repo`` slug of the
    owner's (``exempt`` holds the cobot checkout's own), a secret, or ``reported`` unless allowed."""
    kept, refused = [], []
    for entry in entries:
        text = lint_text(f"{entry.get('claim', '')} {entry.get('source', '')} {entry.get('checked', '')}")
        found = (m.group(0) for owner in owners for m in re.finditer(rf"(?<![\w.-]){re.escape(owner)}/[\w.-]+", text, re.I))
        slugs = {slug.rstrip(".").lower() for slug in found}
        reasons = [
            reason
            for reason, hit in (
                ("run id", RUN_ID_RE.search(text)),
                ("home path", HOME_PATH_RE.search(text)),
                ("release snapshot", SNAPSHOT_RE.search(text)),
                ("owner slug", slugs - {s.lower() for s in exempt}),
                ("secret", SECRET_RE.search(text)),
                ("reported", entry.get("status") == "reported" and not allow_reported),
            )
            if hit
        ]
        if reasons:
            refused.append(f"  promote: refused ({', '.join(reasons)}): {str(entry.get('claim', ''))[:60]}")
        else:
            kept.append(entry)
    return kept, refused


def lint_context(mem: Memory, checkout: Path) -> tuple[set[str], set[str]]:
    """The owner names whose slugs stay out of the plugin (origin's owner, the identities), and the
    cobot checkout's own slugs, which a line may cite."""
    owners_by_remote, identities = remote_owners(mem.root)
    owners = {value.split("/", 1)[-1].lower() for value in owners_by_remote.values()}
    owners |= {identity.split("/", 1)[-1] for identity in identities}
    exempt = {f"{p[1]}/{p[2]}".lower() for url in remotes(checkout).values() if (p := host_owner_repo(url))}
    return {owner for owner in owners if owner}, exempt


def promote_entries(mem: Memory, topic: str, entries: list[dict], delta: dict, source: str | None, in_place: bool, allow_reported: bool = False) -> list[str]:
    if not entries:
        return ["  promote: no general entry"]
    checkout = source_checkout(source)
    if checkout is None:
        return ["  promote: no cobot checkout known (a directory marketplace, $COBOT_SOURCE or --source DIR)"]
    owners, exempt = lint_context(mem, checkout)
    entries, refused = promote_lint(entries, owners, exempt, allow_reported)
    if not entries:
        return [*refused, "  promote: no general entry"]
    worktrees = data_dir().parent / "promote"
    result = promote(checkout, topic, entries, delta, date.today(), in_place, worktrees)
    if isinstance(result, str):
        return [*refused, f"  {result}"]
    return [*refused, *(f"  {line}" for line in result.lines())]


def cmd_learn(mem: Memory, raw: str, dry_run: bool, keep_assumed: bool, promoting: bool = False, source: str | None = None, in_place: bool = False, allow_reported: bool = False) -> str:
    try:
        delta = json.loads(raw)
    except json.JSONDecodeError as error:
        if promoting and raw.strip() and slug(raw.strip()) == raw.strip():
            entries = pending_general(mem, raw.strip())
            return "\n".join([f"learn: topic {raw.strip()}, {len(entries)} pending general line(s)", *promote_entries(mem, raw.strip(), entries, {}, source, in_place, allow_reported)])
        return f"learn: delta is not JSON ({error})"
    if not isinstance(delta, dict):
        return "learn: delta must be a JSON object"
    topic = slug(str(delta.get("topic", "")))
    if not topic:
        return "learn: delta needs a topic"
    if SECRET_RE.search(raw):
        return "learn: refused, the delta contains a secret-like string"
    kept, skipped = filter_delta(delta, keep_assumed)
    general = [entry for entry in kept if is_general(entry)]
    if promoting:
        kept = [entry for entry in kept if not is_general(entry)]
    path = mem.dir / "knowledge" / f"{topic}.md"
    index = Index([path] if path.is_file() else [], dry=dry_run)
    room = KNOWLEDGE_CAP - len(index.lines)
    new_lines, changed = [], []
    for entry in kept:
        kind, text, _file = place(entry, index, date.today(), tag_general=True)
        if kind == "skipped":
            skipped.append(text)
        elif kind in ("redated", "superseded"):
            changed.append(f"{kind}: {text}")
        elif room <= 0:
            skipped.append(f"over the {KNOWLEDGE_CAP}-line cap, consolidate first: {text[:50]}")
        else:
            room -= 1
            new_lines.append(text)
    counts = f"learn: topic {topic}, {len(new_lines)} new line(s), {len(skipped)} skipped"
    counts += f", {len(changed)} re-dated or superseded" if changed else ""
    report = [counts + (f", {len(general)} general to promote" if promoting else "")]
    report.extend(f"  + {line}" for line in new_lines)
    report.extend(f"  ~ {line}" for line in changed)
    report.extend(f"  - {reason}" for reason in skipped)
    for item in delta.get("unverified", []):
        report.append(f"  ? unverified: {item}")
    if (new_lines or changed) and not dry_run:
        path.parent.mkdir(parents=True, exist_ok=True)
        head = path.read_text(encoding="utf-8").rstrip("\n") if path.is_file() else f"# knowledge: {topic}\n"
        if new_lines:
            path.write_text(head.rstrip("\n") + "\n" + "\n".join(new_lines) + "\n", encoding="utf-8")
        report.append(f"  written: {path}")
    if promoting and not dry_run:
        report.extend(promote_entries(mem, topic, general, delta, source, in_place, allow_reported))
    elif promoting:
        report.append(f"  promote: dry run, {len(general)} general entry(ies) would be promoted")
    return "\n".join(report)


def cmd_knowledge(mem: Memory, skill: str, stale_only: bool, as_json: bool, brief: bool) -> str:
    groups = scan_plugin(plugin_root())
    if mem.trust()[0]:
        groups.update(scan_memory(mem.dir))
    if skill:
        groups = {name: lines for name, lines in groups.items() if name in (skill, f"knowledge/{skill}")}
    items = summaries(groups, date.today())
    if brief:
        return brief_line(items, date.today())
    return report(items, date.today(), stale_only=stale_only, as_json=as_json)


def digest(entry: str) -> list[str]:
    """One or more digest lines for an entry: compacted entries keep their bullets, others give
    date, title and the first sentence of ``Changed:``."""
    heading, _, body = entry.partition("\n")
    date_text, title = heading[3:13], heading[13:].lstrip(" —-").strip()
    if title.startswith("compacted "):
        return [line for line in body.splitlines() if line.startswith(("- ", "  open: "))]
    changed = next((line.partition(":")[2].strip() for line in body.splitlines() if line.startswith("Changed:")), "")
    first = re.split(r"(?<=[.;])\s", changed, maxsplit=1)[0].strip()
    lines = [f"- {date_text} {title}: {first}" if first else f"- {date_text} {title}"]
    open_items = next((line.partition(":")[2].strip() for line in body.splitlines() if line.startswith("Open:")), "")
    if open_items and open_items not in ("—", "-", "none", "nothing"):
        lines.append(f"  open: {open_items[:300]}")
    return lines


def positional_entries(text: str) -> list[str]:
    starts = [m.start() for m in ENTRY_RE.finditer(text)]
    return [text[start : starts[i + 1] if i + 1 < len(starts) else len(text)].rstrip() for i, start in enumerate(starts)]


def cmd_compact(mem: Memory, keep: int, summary: str, dry_run: bool, force: bool) -> str:
    path = mem.dir / "JOURNAL.md"
    text = mem.read("JOURNAL.md")
    total = len(text.splitlines())
    if total <= JOURNAL_COMPACT_LINES and not force:
        return f"compact: JOURNAL.md has {total} lines (threshold {JOURNAL_COMPACT_LINES}); nothing to do"
    order = journal_order(mem)
    if order.startswith("mixed"):
        return "compact: the journal mixes both orders; normalise it first"
    entries = positional_entries(text)
    if len(entries) <= keep:
        return f"compact: {len(entries)} entries, keeping {keep}; nothing to fold"
    newest_bottom = order.startswith("newest at bottom") or order == "single entry"
    folded = entries[:-keep] if newest_bottom else entries[keep:]
    kept = entries[-keep:] if newest_bottom else entries[:keep]
    dates = sorted(e[3:13] for e in folded)
    body = summary.strip() or "\n".join(line for e in folded for line in digest(e))
    merged = f"## {dates[-1]} — compacted {dates[0]} → {dates[-1]} ({len(folded)} entries)\n{body}\nArchive: raw entries in JOURNAL-archive.md and in git history before {dates[-1]}."
    head = text[: ENTRY_RE.search(text).start()].rstrip("\n") if ENTRY_RE.search(text) else "# Journal"
    new_entries = [*kept, merged] if not newest_bottom else [merged, *kept]
    new_text = head + "\n\n" + "\n\n".join(new_entries) + "\n"
    report = [f"compact: folding {len(folded)} of {len(entries)} entries ({dates[0]} → {dates[-1]}), keeping {keep}; {total} -> {len(new_text.splitlines())} lines"]
    report.append(f"  summary: {'provided' if summary.strip() else 'mechanical digest'}")
    if dry_run:
        report.append("  dry run, nothing written")
        return "\n".join(report)
    archive = mem.dir / "JOURNAL-archive.md"
    previous = archive.read_text(encoding="utf-8") if archive.is_file() else "# Journal archive (raw entries folded by cobot-memory compact)\n"
    archive.write_text(previous.rstrip("\n") + "\n\n" + "\n\n".join(folded) + "\n", encoding="utf-8")
    path.write_text(new_text, encoding="utf-8")
    report.append(f"  written: {path}; archive: {archive}")
    return "\n".join(report)


def accepted_risks(mem: Memory) -> list[tuple[str, ...]]:
    """(id, rule, file, symbol, why, by, accepted, expires) per row of .agent/accepted-risks.md."""
    rows = []
    for line in mem.read("accepted-risks.md").splitlines():
        match = RISK_RE.match(line)
        if match:
            rows.append(tuple(cell.strip() for cell in match.groups()))
    return rows


def cmd_risks_add(mem: Memory, rule: str, file: str, symbol: str, why: str, by: str, days: int) -> str:
    if not why.strip():
        return "risks: --why is required (the reason the owner accepts it)"
    days = max(1, min(days, RISK_MAX_DAYS))
    path = mem.dir / "accepted-risks.md"
    if not path.is_file():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            (plugin_root() / "skills" / "security-sweep" / "templates" / "accepted-risks.md").read_text(encoding="utf-8"), encoding="utf-8"
        )
    number = f"R-{max((int(r[0][2:]) for r in accepted_risks(mem)), default=0) + 1:02d}"
    today = date.today()
    expires = date.fromordinal(today.toordinal() + days).isoformat()
    cells = [c.replace("|", "/").replace("\n", " ").strip() for c in (rule, file, symbol, why, by or "owner")]
    with path.open("a", encoding="utf-8") as handle:
        handle.write(f"| {number} | {cells[0]} | {cells[1]} | {cells[2]} | {cells[3]} | {cells[4]} | {today.isoformat()} | {expires} |\n")
    return f"risks: {number} accepted until {expires} ({cells[0]} · {cells[1]} · {cells[2]})"


def cmd_risks_list(mem: Memory) -> str:
    rows = accepted_risks(mem)
    if not rows:
        return "risks: none accepted"
    today = date.today().isoformat()
    return "\n".join(f"{rid} · {rule} · {file} · {symbol} · expires {expires} ({'expired' if expires < today else 'ok'}) · {why}" for rid, rule, file, symbol, why, _by, _acc, expires in rows)


def journal_order(mem: Memory) -> str:
    dates = [d for d, _ in sorted(((e[0], i) for i, e in enumerate(mem.journal_entries())), key=lambda x: x[1])]
    raw = [m.group(1) for m in ENTRY_RE.finditer(mem.read("JOURNAL.md"))]
    if len(raw) < 2:
        return "single entry" if raw else "no entries"
    if raw == sorted(raw):
        return "newest at bottom"
    if raw == sorted(raw, reverse=True):
        return "newest on top (legacy order, read correctly)"
    return "mixed order" if dates else "mixed order"


def cmd_stamp(mem: Memory) -> str:
    """`ok <sha>` when HEAD is covered by the journal's last verified stamp, else `missing — <phrase>`.

    Output is hex and fixed phrases only: the journal of an untrusted clone is repository content.
    """
    trusted, _ = mem.trust()
    if not trusted:
        return "missing — untrusted memory"
    matches = STAMP_RE.findall(mem.read("JOURNAL.md"))
    if not matches:
        return "missing — no stamp"
    kind, sha, dirty, _ = matches[-1]
    if dirty:
        return "missing — dirty-tree stamp; commit, then wrap"
    head = git(["rev-parse", "HEAD"], mem.checkout)
    if kind == "tree":
        key = tree_key(mem.checkout, "HEAD", foreign=mem.dir.is_symlink())
        if not head or not key:
            return "missing — stamp tree unknown"
        return f"ok {head[:7]}" if key.startswith(sha) else "missing — HEAD moved since the stamp"
    stamp = git(["rev-parse", "--verify", "--quiet", f"{sha}^{{commit}}"], mem.checkout)
    if not stamp or not head:
        return "missing — stamp commit unknown"
    if stamp == head:
        return f"ok {head[:7]}"
    if mem.dir.is_symlink():
        return "missing — HEAD moved since the stamp"
    changed = git(["diff", "--name-only", stamp, head], mem.checkout)
    if changed is not None and all(path.startswith(DOC_ONLY_PREFIXES) for path in changed.splitlines() if path):
        return f"ok {head[:7]}"
    return "missing — HEAD moved since the stamp"


def tree_key(checkout: Path, treeish: str, foreign: bool) -> str | None:
    """The stamp key of a tree (spec memory-and-ship, story 1): the tree with its root doc entries
    taken out, as ``git mktree`` names it, so the key is known before the commit that adds the
    journal and holds in any clone; no object needs to survive. In foreign mode, the whole tree."""
    tree = git(["rev-parse", "--verify", "--quiet", f"{treeish}^{{tree}}"], checkout)
    if not tree or foreign:
        return tree
    listing = git_bytes(["ls-tree", "-z", tree], checkout)
    if listing is None:
        return None
    doc_names = {name.encode() for name in DOC_ROOT_ENTRIES}
    kept = [entry for entry in listing.split(b"\0") if entry and entry.split(b"\t", 1)[-1] not in doc_names]
    key = git_bytes(["mktree", "-z"], checkout, stdin=b"".join(entry + b"\0" for entry in kept))
    return key.decode("ascii").strip() if key else None


def stamp_readiness(checkout: Path) -> str:
    """Why the index is not what the tests ran on: code changed but not staged, or code left
    untracked. Doc entries do not count. Empty when ready."""
    raw = git_bytes(["status", "--porcelain=v1", "-z", "--untracked-files=all"], checkout)
    if raw is None:
        return "git status failed"
    # bytes, never stripped: the first record may start with a space (" M path"); names decode
    # losslessly, so a non-UTF-8 name is named, not a crash
    records = raw.decode("utf-8", errors="surrogateescape").split("\0")
    index = 0
    while index < len(records):
        record = records[index]
        index += 1
        if len(record) < 4:
            continue
        code, path = record[:2], record[3:]
        if "R" in code or "C" in code:
            index += 1  # the next record is the rename's or copy's source path, whatever it holds
        if path.split("/", 1)[0] in DOC_ROOT_ENTRIES:
            continue
        if code == "??":
            return f"{path} is untracked"
        if code[1] != " ":
            return f"{path} has unstaged changes"
    return ""


def cmd_stamp_tree(mem: Memory) -> tuple[str, int]:
    """``tree <key>`` of the index, for a journal stamp written before the one commit."""
    why = stamp_readiness(mem.checkout)
    if why:
        return f"stamp: not ready — {why}; stage the code the tests ran on", 1
    tree = git(["write-tree"], mem.checkout)
    key = tree_key(mem.checkout, tree, foreign=mem.dir.is_symlink()) if tree else None
    if not key:
        return "stamp: not ready — git write-tree failed", 1
    return f"tree {key}", 0


def missing_header_fields(mem: Memory) -> list[str]:
    """The template's ``key:`` header lines that CONTEXT.md lacks (a legacy file, or one written
    before a field was added); empty when there is no CONTEXT.md."""
    context = mem.read("CONTEXT.md")
    if not context:
        return []
    head = template("CONTEXT.md", "", "").split("\n## ", 1)[0]
    present = set(HEADER_FIELD_RE.findall(context))
    return [key for key in HEADER_FIELD_RE.findall(head) if key not in present]


def debug_problems(mem: Memory, file: str = "") -> tuple[list[str], int]:
    """``<record>:<line>: <why>`` for each secret-shaped line or oversized excerpt in one record, or
    in every record under the memory's ``debug/`` folder, and how many records were read."""
    folder = mem.dir / "debug"
    paths = [Path(file)] if file else sorted(folder.glob("*.md")) if folder.is_dir() else []
    problems: list[str] = []
    for path in paths:
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError) as error:
            problems.append(f"{path.name}: unreadable ({type(error).__name__})")
            continue
        problems += [f"{path.name}:{line}: {why}" for line, why in debug_record_problems(text)]
    return problems, len(paths)


def cmd_debug_check(mem: Memory, file: str) -> tuple[str, int]:
    """Exit 1 on a secret-shaped line or an excerpt over the cap (spec debug-path, story 5): run it
    before ``git add``; the fix is in the record, never in the check."""
    problems, count = debug_problems(mem, file)
    if problems:
        return "\n".join([f"debug: {len(problems)} problem(s) in {count} record(s)", *problems]), 1
    return f"debug: ok, {count} record(s)", 0


def cmd_debug_list(mem: Memory, only_open: bool) -> str:
    """``<status>  <name>  <title>`` per record, newest first; ``--open`` keeps the open ones."""
    records = [r for r in mem.debug_records() if not only_open or r[1] == "open"]
    if not records:
        return "debug: no open records" if only_open else "debug: no records"
    return "\n".join(f"{status:<10}  {name}  {title}" for name, status, title in records)


def cmd_check(mem: Memory) -> str:
    trusted, reason = mem.trust()
    mode = "foreign (symlink)" if mem.dir.is_symlink() else ("committed" if mem.dir.is_dir() else "absent")
    trust = f"trust: {'trusted' if trusted else 'untrusted'} ({reason}){trust_file_note(trusted)}"
    lines = [f"memory: {mem.dir}", f"mode: {mode}", trust]
    lines.append(f"tree: {mem.tree()}")
    for name in ("CONTEXT.md", "JOURNAL.md", "FINDINGS.md", "ARCHITECTURE.md", "cobot.rules"):
        path = mem.dir / name
        if path.is_file():
            count = len(path.read_text(encoding="utf-8").splitlines())
            lines.append(f"{name}: {count} lines")
    lines.append(f"journal: {journal_order(mem)}")
    lines.append(f"findings: {len(mem.open_findings())} open / {len(mem.findings())} total")
    waiting = noticed(mem)
    if waiting:
        lines.append(f"noticed: {len(waiting)} waiting; /cobot:wrap files or drops each")
    lines.append(f"knowledge: {', '.join(mem.knowledge_topics()) or 'none'}; specs: {', '.join(mem.specs()) or 'none'}")
    problems, _ = debug_problems(mem)
    if problems:
        lines += [f"debug: {len(problems)} problem(s); fix the records", *(f"  {p}" for p in problems)]
    brief = build_brief(mem, DEFAULT_BUDGET, trust_check=False)
    lines.append(f"brief: {len(brief)} chars (budget {DEFAULT_BUDGET})")
    dropped = DROPPED_RE.search(brief)
    if dropped:
        lines.append(f"warning: the brief drops CONTEXT sections: {dropped.group(1)}; move them up or trim")
    missing = missing_header_fields(mem)
    if missing:
        lines.append(f"context: header fields missing (template): {', '.join(missing)}")
    context_lines = len(mem.read("CONTEXT.md").splitlines())
    if context_lines > 120:
        lines.append(f"warning: CONTEXT.md has {context_lines} lines (> 120), trim the Shape section")
    if len(mem.read("JOURNAL.md").splitlines()) > JOURNAL_COMPACT_LINES:
        lines.append(f"warning: JOURNAL.md over {JOURNAL_COMPACT_LINES} lines; run cobot-memory compact")
    risks = accepted_risks(mem)
    if risks:
        expired = [f"{row[0]} ({row[-1]})" for row in risks if row[-1] < date.today().isoformat()]
        lines.append(f"accepted risks: {len(risks)}" + (f"; expired: {', '.join(expired)}" if expired else ""))
    found = [name for name in AGY_DISCOVERED if (mem.dir / name).exists()]
    if found:
        lines.append(
            f"warning: .agent/ holds {', '.join(found)}: .agent/ is also an Antigravity customization"
            " root, so agy loads them; move them out unless you mean agy to"
        )
    for old in (mem.dir / OLD_RULES_NAME, config_dir() / OLD_RULES_NAME):
        if old.is_file():
            lines.append(f"warning: {old} is not read since the rename (ADR-0004); rename it to cobot.rules")
    return "\n".join(lines)


# ---------------------------------------------------------------- CLI


VALUE_OPTIONS = {
    "init": {"profile"},
    "brief": {"budget"},
    "findings": {"goes-to"},
    "learn": {"source"},
    "compact": {"keep", "summary"},
    "risks": {"why", "by", "days"},
}
SWITCHES = {
    "init": {"foreign", "add-identity", "trust-root"},
    "brief": {"no-trust-check"},
    "findings": {"open"},
    "debug": {"open"},
    "learn": {"dry-run", "keep-assumed", "promote", "in-place", "allow-reported"},
    "knowledge": {"stale", "json", "brief"},
    "compact": {"dry-run", "force"},
    "stamp": {"tree"},
    "journal": {"check"},
}
PROFILES = ("spike", "script", "cli", "library", "service", "infra")


def parse(argv: list[str]) -> tuple[list[str], dict[str, str], set[str]]:
    """Raises HelpRequested or UsageError; see parse_cli."""
    positional, options, flags = parse_cli(argv, VALUE_OPTIONS, SWITCHES)
    if positional[:1] == ["init"] and options.get("profile", "library") not in PROFILES:
        raise UsageError(f"profile must be one of {', '.join(PROFILES)}")
    return positional, options, flags


def main(argv: list[str]) -> int:
    try:
        positional, options, flags = parse(argv)
    except HelpRequested:
        print(__doc__.strip())
        return 0
    except UsageError as error:
        print(f"cobot-memory: {error}\n\n{__doc__.strip()}", file=sys.stderr)
        return 2
    mem = Memory()
    command = positional[0] if positional else ""
    sub = positional[1] if len(positional) > 1 else ""
    if command == "path":
        print(mem.dir)
    elif command == "init":
        out = cmd_init(mem, options, flags)
        print(out)
        if TRUST_NOT_RECORDED in out:
            return 1
    elif command == "stamp" and "tree" in flags:
        out, code = cmd_stamp_tree(mem)
        print(out)
        return code
    elif command == "stamp":
        print(cmd_stamp(mem))
    elif command == "trust":
        trusted, reason = mem.trust()
        print(f"{'trusted' if trusted else 'untrusted'}: {reason}{trust_file_note(trusted)}")
    elif command == "check":
        print(cmd_check(mem))
        if debug_problems(mem)[0]:
            return 1
    elif command == "debug" and sub == "list":
        print(cmd_debug_list(mem, "open" in flags))
    elif command == "debug" and sub == "check":
        out, code = cmd_debug_check(mem, positional[2] if len(positional) > 2 else "")
        print(out)
        return code
    elif command == "brief":
        print(build_brief(mem, int(options.get("budget", DEFAULT_BUDGET)), trust_check="no-trust-check" not in flags))
    elif command == "journal" and sub == "add":
        out = cmd_journal_add(mem, read_payload(positional[2:]), check_only="check" in flags)
        print(out)
        if not out.startswith(("journal: appended", "journal: valid")):
            return 1
    elif command == "noticed" and sub == "add":
        print(cmd_noticed_add(mem, read_payload(positional[2:])))
    elif command == "noticed" and sub == "list":
        print(cmd_noticed_list(mem))
    elif command == "noticed" and sub == "clear":
        print(cmd_noticed_clear(mem))
    elif command == "findings" and sub == "add" and len(positional) >= 4:
        print(cmd_findings_add(mem, positional[2], positional[3], options.get("goes-to", "")))
    elif command == "findings" and sub == "list":
        print(cmd_findings_list(mem, "open" in flags))
    elif command == "findings" and sub == "close" and len(positional) >= 4:
        print(cmd_findings_close(mem, positional[2], positional[3]))
    elif command == "learn":
        print(
            cmd_learn(
                mem,
                read_payload(positional[1:]),
                "dry-run" in flags,
                "keep-assumed" in flags,
                promoting="promote" in flags,
                source=options.get("source"),
                in_place="in-place" in flags,
                allow_reported="allow-reported" in flags,
            )
        )
    elif command == "knowledge":
        print(cmd_knowledge(mem, sub, "stale" in flags, "json" in flags, "brief" in flags))
    elif command == "risks" and sub == "add" and len(positional) >= 5:
        print(cmd_risks_add(mem, positional[2], positional[3], positional[4], options.get("why", ""), options.get("by", ""), int(options.get("days", RISK_MAX_DAYS))))
    elif command == "risks" and sub == "list":
        print(cmd_risks_list(mem))
    elif command == "compact":
        print(cmd_compact(mem, int(options.get("keep", COMPACT_KEEP)), options.get("summary", ""), "dry-run" in flags, "force" in flags))
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
