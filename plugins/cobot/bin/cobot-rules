TOOLCHAIN_PROXIES = frozenset({"cargo"})  # ``cargo +nightly …``: rustup picks the toolchain
FILE_TOOLS = frozenset({"Edit", "Write", "MultiEdit", "NotebookEdit"})
RULE_RE = re.compile(r"^(never|ask|allow)\s+(\S+?)\((.*)\)\s*(?:@(\S+))?\s*(?:#(.*))?$")
MCP_RULE_RE = re.compile(r"^(never|ask|allow)\s+(mcp__\S+)\s*(?:@(\S+))?\s*(?:#(.*))?$")
LAYERS = ("default", "owner", "project")
# a rule's trailing ``# comment`` joins its reason, except from the project layer: repository text
# must not speak to the owner in a permission prompt
NOTE_LAYERS = frozenset({"default", "owner"})
RULES_FILE = ".agent/cobot.rules"  # the project layer, relative to a repository root
SHOWN_TOOLS = FILE_TOOLS | {"Bash", "mcp"}  # a project row's tool a reason may name


@dataclass(frozen=True)
class Rule:
    decision: str  # never | ask | allow
    tool: str  # Bash | Edit | ... | mcp
    pattern: str
    agent: str | None
    layer: str
    line: int
    note: str = ""  # the trailing comment, default and owner layers only

    def text(self) -> str:
        scope = f" @{self.agent}" if self.agent else ""
        body = self.pattern if self.tool == "mcp" else f"{self.tool}({self.pattern})"
        return f"{self.decision} {body}{scope}"

    def shown(self) -> str:
        """The rule as a reason shows it: its text from the default and owner layers; from the
        project layer only its place, since the pattern is repository text that would speak to
        the owner in the prompt (F-29). The decision and tool come from fixed vocabularies."""
        if self.layer in NOTE_LAYERS:
            return self.text()
        tool = self.tool if self.tool in SHOWN_TOOLS else "tool"  # RULE_RE takes any name
        return f"{self.decision} {tool} rule at {RULES_FILE}:{self.line}"


MAX_NAMED_ASKS = 3  # the asks a reason names in all, its own first (F-40)
ASK_NOTE_LIMIT = 40  # a ruleless ask's note, as another ask's name


def other_asks(shown: list[str], rest: int) -> str:
    """``; also asks: a, b +N more``, or ``; +N more asks`` when none fits by name."""
    if not shown:
        return f"; +{rest} more asks" if rest else ""
    return f"; also asks: {', '.join(shown)}" + (f" +{rest} more" if rest else "")


@dataclass(frozen=True)
class Verdict:
    decision: str | None
    rule: Rule | None
    note: str = ""
    via: str = ""  # the runner invocation this verdict was resolved from, e.g. ``mise run deploy``
    also: tuple[str, ...] = ()  # the other distinct asks of the command, as ask_label names them
    session_ask: bool | None = None  # agy: True when every ask in this verdict is local repeatable dev

    def own_reason(self) -> str:
        if self.rule:
            text = f"cobot rule: {self.rule.shown()} ({self.rule.layer} layer)"
            text += f": {self.rule.note}" if self.rule.note else ""
        else:
            text = f"cobot gate: {self.note}"
        return f"{text} via {self.via}" if self.via else text

    def reason(self, budget: int = REASON_LIMIT) -> str:
        """The verdict's own reason, then the other asks (F-40): up to MAX_NAMED_ASKS named in
        all, then ``+N more``, inside ``budget``. The own reason is never cut for them: with no
        room, or no other ask, it stands alone, as before F-40."""
        first = self.own_reason()
        shown = list(self.also[: MAX_NAMED_ASKS - 1])
        while self.also:
            tail = other_asks(shown, len(self.also) - len(shown))
            if len(first) + len(tail) <= budget:
                return first + tail
            if not shown:
                break
            shown.pop()
        return first


# ---------------------------------------------------------------- rule files


def fixed_layer_paths() -> dict[str, Path]:
    """The default and owner layers: neither depends on the project."""
    return {
        "default": plugin_root() / "policy" / "default.rules",
        "owner": owner_rules_path(),
    }


def layer_paths(cwd: str | None) -> dict[str, Path]:
    return {**fixed_layer_paths(), "project": repo_root(cwd) / ".agent" / "cobot.rules"}


def shown_line(layer: str, line: str) -> str:
    """A warning's copy of the rule line: the default and owner layers only. A project line is
    repository text, and a hook's stderr may reach the owner, so it is named by its place (F-34)."""
    return f": {line}" if layer in NOTE_LAYERS else ""


def parse_rule(line: str, layer: str, number: int, warnings: list[str]) -> Rule | None:
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        return None
    match = RULE_RE.match(stripped)
    if match:
        decision, tool, pattern, agent, comment = match.groups()
    else:
        mcp = MCP_RULE_RE.match(stripped)
        if not mcp:
            warnings.append(f"{layer}:{number}: unreadable rule ignored{shown_line(layer, stripped)}")
            return None
        decision, pattern, agent, comment = mcp.groups()
        tool = "mcp"
    if layer == "project" and decision == "allow":
        warnings.append(f"{layer}:{number}: allow is not accepted from the project layer, ignored")
        return None
    note = (comment or "").strip() if layer in NOTE_LAYERS else ""
    return Rule(decision, tool, pattern, agent, layer, number, note)


def read_layer(layer: str, path: Path, rules: list[Rule], warnings: list[str]) -> None:
    if not path.is_file():
        return
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        rule = parse_rule(line, layer, number, warnings)
        if rule:
            rules.append(rule)


def load_rules(cwd: str | None) -> tuple[list[Rule], list[str], dict[str, Path]]:
    rules: list[Rule] = []
    warnings: list[str] = []
    paths = layer_paths(cwd)
    for layer, path in paths.items():
        read_layer(layer, path, rules, warnings)
    return rules, warnings, paths


def load_rules_agy(workspaces: list[str]) -> tuple[list[Rule], list[str]]:
    """The default and owner layers, and the project layer of every workspace agy names: a
    model-written Cwd cannot drop a project ``never``."""
    rules: list[Rule] = []
    warnings: list[str] = []
    for layer, path in fixed_layer_paths().items():
        read_layer(layer, path, rules, warnings)
    for project in dict.fromkeys(repo_root(w) / ".agent" / "cobot.rules" for w in workspaces):
        read_layer("project", project, rules, warnings)
    return rules, warnings


# ---------------------------------------------------------------- command analysis


LITERAL_SEMICOLON = "\x1fsemicolon\x1f"  # a ; that is text, not an operator, while shlex splits


def mark_literal_semicolons(text: str) -> str:
    """``\\;``, ``';'`` and ``";"`` are text to the shell (``find … -exec x \\;``), but shlex's
    punctuation mode splits on them like the operator, so a second ``-exec`` body became a segment
    of its own that no row read (bypass review of T01, HIGH-3). Mark them before splitting."""
    out, quote, i = [], "", 0
    while i < len(text):
        c = text[i]
        if quote == "'":
            out.append(LITERAL_SEMICOLON if c == ";" else c)
            quote = "" if c == "'" else quote
        elif c == "\\" and i + 1 < len(text):
            out.append(LITERAL_SEMICOLON if text[i + 1] == ";" else text[i : i + 2])
            i += 1
        elif quote == '"':
            out.append(LITERAL_SEMICOLON if c == ";" else c)
            quote = "" if c == '"' else quote
        else:
            out.append(c)
            quote = c if c in "'\"" else ""
        i += 1
    return "".join(out)


def shell_items(command: str) -> list[str | list[str]]:
    """The argv-like segments of a shell command and the operator tokens between them, in order."""
    joined = mark_literal_semicolons(command.replace("\\\n", " ").replace("\n", " ; "))
    lexer = shlex.shlex(joined, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    lexer.commenters = ""  # shlex would drop the rest of ``nix develop .#dev -c …`` as a comment
    items: list[str | list[str]] = []
    segment: list[str] = []
    for token in lexer:
        if LITERAL_SEMICOLON in token:  # always a word, never an operator
            segment.append(token.replace(LITERAL_SEMICOLON, ";"))
            continue
        if token in SEPARATORS or (token and set(token) <= CONTROL_CHARS):  # ``()``, ``))``
            if segment:
                items.append(shell.expand_braces(segment))
                segment = []
            items.append(token)
        else:
            segment.append(token)
    if segment:
        items.append(shell.expand_braces(segment))  # after splitting: a brace never builds an operator
    return array_assignments(items)


def array_assignments(items: list[str | list[str]]) -> list[str | list[str]]:
    """``files=(*.py)``, ``declare -a a=(…)``: the parenthesised words are an array's elements,
    data, not a subshell (``x= (cmd)`` is a syntax error). Substitutions inside are still judged
    as their own units."""
    out: list[str | list[str]] = []
    index = 0
    while index < len(items):
        item = items[index]
        opens = index + 1 < len(items) and items[index + 1] == "("
        if isinstance(item, list) and item and ARRAY_OPEN_RE.match(item[-1]) and opens:
            close, rest = closing_paren(items, index + 2)
            out.append([*item[:-1], item[-1] + "(…)"])
            if rest:
                out.append(rest)
            index = close + 1
            continue
        out.append(item)
        index += 1
    return out


def closing_paren(items: list[str | list[str]], start: int) -> tuple[int, str]:
    """The index of the operator token closing a ``(`` opened before ``start``, and what follows the
    ``)`` in that token (``);`` leaves ``;``); the end when it never closes."""
    depth = 1
    for index in range(start, len(items)):
        item = items[index]
        if isinstance(item, str):
            for offset, char in enumerate(item):
                depth += {"(": 1, ")": -1}.get(char, 0)
                if depth == 0:
                    return index, item[offset + 1 :]
    return len(items), ""


def split_segments(command: str) -> list[list[str]]:
    """Split a shell command into argv-like segments at shell operators."""
    return [item for item in shell_items(command) if isinstance(item, list)]


def strip_prefix_command(tokens: list[str]) -> list[str]:
    """``timeout -k 5 60 git push`` becomes ``git push``."""
    with_value, positional = PREFIX_COMMANDS[tokens[0]]
    rest = tokens[1:]
    while rest and rest[0].startswith("-"):
        name = rest[0].split("=", 1)[0]
        rest = rest[2:] if name in with_value and "=" not in rest[0] else rest[1:]
    return rest[positional:]


def drop_wrapper(tokens: list[str]) -> list[str] | None:
    """The tokens after one leading reserved word, function header, wrapper (with its options) or
    prefix command; None when the head is none of these."""
    head = tokens[0]
    if head in RESERVED_HEADS:
        return tokens[1:]
    if head == "function":  # ``function f { …; }``: the name is not a command
        return tokens[2:]
    if head == "coproc":  # ``coproc NAME { …; }`` or ``coproc cmd``
        return tokens[2:] if tokens[2:3] == ["{"] else tokens[1:]
    if head == "rtk" and tokens[1:2] == ["proxy"]:
        return tokens[2:]
    if head in WRAPPER_OPTIONS:
        return skip_wrapper_options(tokens[1:], *WRAPPER_OPTIONS[head])
    if head in WRAPPERS:
        return tokens[1:]
    if head in PREFIX_COMMANDS:
        return strip_prefix_command(tokens)
    return None


def skip_wrapper_options(
    rest: list[str], flags: frozenset[str], with_value: frozenset[str]
) -> list[str] | None:
    """The tokens after a wrapper's options, getopt style; None on an option it does not take."""
    while rest and rest[0].startswith("-") and rest[0] != "-":
        option = rest[0]
        if option == "--":
            return rest[1:]
        letters = [f"-{letter}" for letter in option[1:]]
        if option.startswith("--") or any(flag not in flags | with_value for flag in letters):
            return None
        if any(flag in with_value for flag in letters[:-1]):
            return None  # a value option must come last in a cluster
        rest = rest[2:] if letters[-1] in with_value else rest[1:]
    return rest


def strip_wrappers(tokens: list[str]) -> list[str]:
    """Drop reserved words, wrappers, assignments and prefix commands; basename the binary. A
    ``for``, ``select`` or ``case`` head leaves nothing: those words are data."""
    tokens = list(tokens)
    while tokens:
        head = tokens[0]
        if head == "env" and len(tokens) > 1 and tokens[1].startswith("-"):
            break  # ``env -S cmd``, ``env -i cmd``: the real command is hidden behind env's options
        if head in DATA_HEADS:
            return []
        if "=" in head and not head.startswith("-"):
            tokens.pop(0)
            continue
        rest = drop_wrapper(tokens)
        if rest is None:
            break
        tokens = rest
    if tokens and "/" in tokens[0] and not tokens[0].startswith("$"):
        tokens[0] = os.path.basename(tokens[0])
    return tokens


PUSH_VALUE_OPTIONS = {"-o", "--push-option", "--receive-pack", "--exec", "--repo"}


def expand_push_flags(tokens: list[str]) -> list[str]:
    """``git push -uf origin x`` becomes ``git push origin x -u -f``: combined flags split, options
    hoisted after the remote and refspecs so ``git push <remote>*`` rules see the remote first."""
    if tokens[:2] != ["git", "push"]:
        return tokens
    positionals: list[str] = []
    options: list[str] = []
    rest = tokens[2:]
    i = 0
    while i < len(rest):
        token = rest[i]
        if token in PUSH_VALUE_OPTIONS and i + 1 < len(rest):
            options.extend([token, rest[i + 1]])
            i += 2
            continue
        if re.fullmatch(r"-[a-zA-Z]{2,}", token):
            options.extend(f"-{flag}" for flag in token[1:])
        elif len(token) > 1 and token[0] == "-":
            options.append(token)
        else:
            positionals.append(token)
        i += 1
    return [*tokens[:2], *positionals, *options]


GCLOUD_READ_VERBS = frozenset(
    {"list", "describe", "get-iam-policy", "get-value", "get-ancestors", "read", "ls"}
)
GCLOUD_MUTATING_VERBS = frozenset(
    "create delete update ssh scp deploy submit enable disable import export apply promote rollback "
    "resize start stop reset suspend resume restart move undelete destroy upgrade patch clone failover "
    "pause cancel replace invoke install cp mv rm rsync publish execute call run login revoke "
    "activate-service-account set unset activate print-access-token print-identity-token "
    "config-helper".split()
)
GCLOUD_VERB_PREFIXES = ("add-", "remove-", "set-", "attach-", "detach-", "restore")
# environment names a read-only agent may set without disabling its read list
COSMETIC_ENV = frozenset({"NO_COLOR", "LANG", "LC_ALL", "TZ", "TERM", "COLUMNS"})
# flags that make a read command run a program the repository may supply
FOREIGN_FLAGS = frozenset(
    {
        "--post-renderer",
        "--enable-exec",
        "--enable-alpha-plugins",
        "--enable-helm",
        "--helm-command",
        "--exec-path",
    }
)
# options that load configuration able to run a program, by command word (gate-findings A1):
# git --config-env sets config like -c; cargo --config and -Z (attached too); docker --config
# loads CLI plugins from that directory
FOREIGN_BY_CLI: dict[str, frozenset[str]] = {
    "git": frozenset({"-c", "--config-env"}),
    "cargo": frozenset({"--config", "-Z", "-C"}),
    "docker": frozenset({"--config"}),
    # configuration, caches and directories the agent could choose (bypass review, 2026-11-14)
    "npm": frozenset({"--userconfig", "--globalconfig", "--cache", "--prefix"}),
    "pnpm": frozenset({"--env-file", "--npmrc-auth-file", "--store-dir", "--state-dir", "-C", "--dir"}),
    "uv": frozenset({"--config-file", "--directory", "--project"}),
}
KUBECONFIG_FLAGS: dict[str, frozenset[str]] = {
    "kubectl": frozenset({"--kubeconfig"}),
    "helm": frozenset({"--kubeconfig"}),
    "istioctl": frozenset({"--kubeconfig", "-c"}),
}


def is_gcloud_verb(token: str) -> bool:
    if token in GCLOUD_READ_VERBS or token in GCLOUD_MUTATING_VERBS:
        return True
    return token.startswith(GCLOUD_VERB_PREFIXES)


GCLOUD_TRACKS = frozenset({"alpha", "beta", "preview"})


def gcloud_words(tokens: list[str]) -> list[str]:
    """``gcloud beta secrets --project p versions access`` becomes ``gcloud secrets versions
    access``: the release track and the flags placed between the command words drop, a known
    global value flag with its value."""
    with_value, _ = GLOBAL_OPTIONS["gcloud"]
    words, skip = [tokens[0]], False
    for at, word in enumerate(tokens[1:], start=1):
        if skip:
            skip = False
        elif word.startswith("-"):
            skip = "=" not in word and word in with_value
        elif not (at == 1 and word in GCLOUD_TRACKS):
            words.append(word)
    return words


def canonical_gcloud(tokens: list[str]) -> list[str]:
    """``gcloud <group…> <verb> …`` is cut after its first verb (from the third token: the first
    two are groups such as ``run`` or ``deploy``), so an ``allow`` written without a trailing
    star matches a read verb only when it is the verb: ``gcloud pubsub topics create list`` reads
    as ``create``. A command without a known verb keeps its form."""
    if len(tokens) < 3 or tokens[0] != "gcloud":
        return tokens
    tokens = gcloud_words(tokens)
    for index in range(2, len(tokens)):
        if is_gcloud_verb(tokens[index]):
            return tokens[: index + 1]
    return tokens


def executes_foreign(tokens: list[str]) -> bool:
    """True when the segment could run a program the repository supplies: an environment
    assignment outside the cosmetic names (a pager, an editor, ``PATH``, ``KUBECONFIG``,
    ``CLOUDSDK_PYTHON`` …), ``git -c`` or ``--exec-path``, a kubeconfig flag on ``kubectl``,
    ``helm`` or ``istioctl`` in any position, or a post-renderer, exec or plugin flag. Such a
    segment never matches an agent-scoped ``allow``; the main thread is judged as before."""
    rest = list(tokens)
    while rest:
        head = rest[0]
        if "=" in head and not head.startswith("-"):
            if head.split("=", 1)[0] not in COSMETIC_ENV:
                return True
            rest.pop(0)
            continue
        after = drop_wrapper(rest)
        if after is None:
            break
        rest = after
    if not rest:
        return False
    cli = os.path.basename(rest[0])
    if cli == "rustup" or (cli in TOOLCHAIN_PROXIES and rest[1:2] and rest[1].startswith("+")):
        return True  # a toolchain may be a path: its bin/ comes first on PATH
    named = KUBECONFIG_FLAGS.get(cli, frozenset()) | FOREIGN_BY_CLI.get(cli, frozenset())
    for token in rest[1:]:
        name = token.split("=", 1)[0]
        if name in FOREIGN_FLAGS or name in named or (cli == "cargo" and token.startswith("-Z")):
            return True
    return False


# ---------------------------------------------------------------- read-only agents (gate-findings A)

SAFE_WRITE_TARGETS = frozenset({"/dev/null", "/dev/stdout", "/dev/stderr", "/dev/fd/1", "/dev/fd/2"})
READ_LIST_GAP = "the read list does not cover it"


@dataclass(frozen=True)
class Guard:
    """What makes a read-list command write a file or run a program. ``long``: getopt long names,
    read with any abbreviation and ``=value``; ``short``: getopt letters, read in any cluster;
    ``single``: ``-name`` or ``--name`` alone or with ``=``, as Go's flag and find read them;
    ``verbs``: positional words; ``suffix``: any long name ending in it; ``check``: a parser of
    its own. Each reading over-reads (a letter inside an attached value), never under-reads."""

    long: frozenset[str] = frozenset()
    short: str = ""
    single: frozenset[str] = frozenset()
    verbs: frozenset[str] = frozenset()
    suffix: str = ""
    check: object = None  # Callable[[list[str]], str | None]
    missing: str = ""  # an option without which the command writes or runs (``uv audit --frozen``)


def _words(text: str) -> frozenset[str]:
    return frozenset(text.split())


def getopt_hit(token: str, guard: Guard) -> bool:
    if token.startswith("--") and len(token) > 2:
        name = token[2:].split("=", 1)[0]
        abbreviates = any(option.startswith(name) for option in guard.long)
        return abbreviates or bool(guard.suffix and name.endswith(guard.suffix))
    return token.startswith("-") and len(token) > 1 and any(letter in guard.short for letter in token[1:])


def single_hit(token: str, guard: Guard) -> bool:
    return token.startswith("-") and token.lstrip("-").split("=", 1)[0] in guard.single


def guarded_token(tokens: list[str], guard: Guard) -> str | None:
    """The first token the guard reads as a write or a run."""
    if guard.check is not None:
        return guard.check(tokens)
    for token in tokens:
        if getopt_hit(token, guard) or single_hit(token, guard) or token in guard.verbs:
            return token
    return None


def uniq_output(tokens: list[str]) -> str | None:
    """``uniq [OPTION]… [INPUT [OUTPUT]]``: a second operand is the file it writes."""
    with_value, operands, rest = (
        {"-f", "-s", "-w", "--skip-fields", "--skip-chars", "--check-chars"},
        [],
        list(tokens),
    )
    while rest:
        arg = rest.pop(0)
        if arg == "--":
            operands.extend(rest)
            break
        if arg in with_value or (arg[:1] == "-" and arg[1:2] != "-" and arg[-1:] in "fsw"):
            rest = rest[1:]
        elif not option_word(arg) or arg == "-":
            operands.extend([arg, arg] if shell.has_sentinel(arg) else [arg])  # a glob: one or more files
    return operands[1] if len(operands) > 1 else None


BRANCH_WRITES = Guard(
    long=_words("delete move copy force set-upstream-to unset-upstream edit-description track no-track")
    | _words("create-reflog"),
    short="dDmMcCfut",
)
BRANCH_VALUES = _words("--contains --no-contains --merged --no-merged --points-at --sort --format")


def branch_write(tokens: list[str]) -> str | None:
    """``git branch``: a write option, or a name outside list mode (``-l``/``--list``) creates a
    branch. ``--color``, ``--column`` and ``--abbrev`` take a value only with ``=``."""
    listing = False
    for t in tokens:  # the last of --list and --no-list (abbreviations too) wins
        if t == "-l" or (len(t) > 3 and "--list".startswith(t)):
            listing = True
        elif len(t) > 5 and "--no-list".startswith(t):
            listing = False
    rest = list(tokens)
    while rest:
        arg = rest.pop(0)
        if getopt_hit(arg, BRANCH_WRITES):
            return arg
        if arg in BRANCH_VALUES:
            rest = rest[1:]
        elif not option_word(arg) and not listing:
            return arg
    return None


PIP_AUDIT_WRITES = Guard(long=_words("fix output"), short="o")
# pip-audit README, read 2026-11-14: options that take a value; --desc and --aliases take one of
# on|off|auto when it follows
PIP_AUDIT_VALUES = _words("-f --format -s --vulnerability-service --cache-dir --progress-spinner --timeout")
PIP_AUDIT_VALUES |= _words("--path --index-url --extra-index-url --ignore-vuln -o --output")
PIP_AUDIT_CHOICES = _words("--desc --aliases")
PIP_AUDIT_SHORT_VALUES = "fsor"


def pip_audit_resolves(tokens: list[str]) -> str | None:
    """``pip-audit`` writes with ``--fix`` or ``-o``, and resolving requirements (``-r``) or a
    project path builds source-only dependencies, running their ``setup.py``, unless both
    ``--no-deps`` and ``--disable-pip`` are given (gate-repo-config)."""
    resolves, safe, rest = None, set(), list(tokens)
    while rest:
        arg = rest.pop(0)
        name, has_value, _ = arg.partition("=")
        if arg == "--":
            resolves = resolves or (rest[0] if rest else None)
            break
        if (
            getopt_hit(arg, PIP_AUDIT_WRITES)
            if arg.startswith("--")
            else option_word(arg) and pip_audit_writes(arg)
        ):
            return arg
        if name in ("--no-deps", "--disable-pip"):
            safe.add(name)
        elif arg.startswith("--") and len(name) > 4 and "--requirement".startswith(name):
            resolves, rest = resolves or name, rest if has_value else rest[1:]
        elif name in PIP_AUDIT_VALUES and not has_value:
            rest = rest[1:]
        elif name in PIP_AUDIT_CHOICES:
            rest = rest[1:] if rest and rest[0] in ("on", "off", "auto") else rest
        elif option_word(arg) and not arg.startswith("--"):
            resolves, rest = pip_audit_cluster(arg, rest, resolves)
        elif not option_word(arg):
            resolves = resolves or arg  # a project path
    return resolves if resolves and safe != {"--no-deps", "--disable-pip"} else None


def pip_audit_writes(cluster: str) -> bool:
    """``-o`` before any other value letter of the cluster (``-vo``; not the ``o`` of ``-fjson``)."""
    for letter in cluster[1:]:
        if letter in PIP_AUDIT_SHORT_VALUES:
            return letter == "o"
    return False


def pip_audit_cluster(arg: str, rest: list[str], resolves: str | None) -> tuple[str | None, list[str]]:
    """A short cluster (``-vr req``, ``-rreq``): a value letter takes the rest or the next word."""
    for index, letter in enumerate(arg[1:], start=1):
        if letter in PIP_AUDIT_SHORT_VALUES:
            found = resolves or ("-r" if letter == "r" else None)
            return found, rest if arg[index + 1 :] else rest[1:]
    return resolves, rest


PNPM_AUDIT_OPTIONS = Guard(long=_words("fix registry userconfig globalconfig"))


def pnpm_audit_unsafe(tokens: list[str]) -> str | None:
    """``pnpm audit``: a fix, a registry or npmrc the agent picks, or any ``--config.<key>``."""
    hit = guarded_token(tokens, PNPM_AUDIT_OPTIONS)
    return hit or next((t for t in tokens if t.startswith("--config.")), None)


DOCKER_BUILD_WRITES = Guard(long=_words("output iidfile metadata-file push load builder"), short="o")


def docker_build_unsafe(tokens: list[str]) -> str | None:
    """``docker build``: a write, another builder, a Dockerfile or context on stdin, or a
    ``BUILDKIT_SYNTAX`` build argument naming the frontend image BuildKit runs."""
    written = guarded_token(tokens, DOCKER_BUILD_WRITES)
    if written:
        return written
    for index, arg in enumerate(tokens):
        following = tokens[index + 1] if index + 1 < len(tokens) else ""
        name, has_value, value = arg.partition("=")
        if name == "--build-arg" and (value if has_value else following).startswith("BUILDKIT_SYNTAX"):
            return arg
        if arg in ("-", "-f-") or (name in ("-f", "--file") and (value if has_value else following) == "-"):
            return arg
    return None


CURL_FLAGS = _words("--silent --show-error --location --fail --fail-with-body --head --include --verbose")
CURL_FLAGS |= _words("--insecure --globoff --compressed --ipv4 --ipv6 --http1.1 --http2")
CURL_VALUES = _words("--header --user-agent --referer --max-time --connect-timeout --retry --retry-delay")
CURL_VALUES |= _words("--retry-max-time --range --request --url --write-out")
CURL_SHORT_FLAGS = "sSLfIivkg46"
CURL_SHORT_VALUES = {"H": "--header", "A": "--user-agent", "e": "--referer", "m": "--max-time"}
CURL_SHORT_VALUES |= {"r": "--range", "X": "--request", "w": "--write-out"}


def curl_value_safe(option: str, value: str) -> bool:
    if option == "--request":
        return value in ("GET", "HEAD")
    if option in ("--header", "--write-out"):
        return not value.startswith("@") and "%output" not in value.lower()
    return True


def curl_unsafe(tokens: list[str]) -> str | None:
    """``curl`` keeps the read list only when every option is a read (an allow-list, Q3): uploads,
    data, file writes and config files ask. Long options are exact (curl does not abbreviate);
    a cluster is read letter by letter and a value letter ends it."""
    rest = list(tokens)
    while rest:
        arg = rest.pop(0)
        if arg == "--":
            return None
        if arg.startswith("--"):
            if arg in CURL_FLAGS:
                continue
            if arg in CURL_VALUES and rest and curl_value_safe(arg, rest[0]):
                rest = rest[1:]
                continue
            return arg
        if not option_word(arg):
            continue
        for index, letter in enumerate(arg[1:], start=1):
            if letter in CURL_SHORT_FLAGS:
                continue
            option = CURL_SHORT_VALUES.get(letter)
            if option is None:
                return arg
            attached = arg[index + 1 :]
            value = attached or (rest.pop(0) if rest else "")
            if not curl_value_safe(option, value):
                return arg
            break
    return None


# each row's source: the installed --help (version) or the upstream reference, read 2026-11-13
READ_GUARDS: dict[str, Guard] = {
    # bfs 4.1.1 and GNU findutils find(1): actions that delete, run or write
    "find": Guard(single=_words("delete rm exec execdir ok okdir fprint fprint0 fprintf fls")),
    "rg": Guard(long=_words("pre hostname-bin")),  # ripgrep 14.1.1
    "fd": Guard(long=_words("exec exec-batch"), short="xX"),  # fd(1), github.com/sharkdp/fd
    "sort": Guard(long=_words("output compress-program"), short="o"),  # GNU coreutils 9.7
    "uniq": Guard(check=uniq_output),  # GNU coreutils 9.7
    "tree": Guard(short="oR"),  # tree 2.2.1
    "file": Guard(long=_words("compile"), short="C"),  # file 5.46
    # mikefarah/yq and kislyuk/yq docs
    "yq": Guard(long=_words("inplace in-place split-exp split-exp-file"), short="is"),
    "git log": Guard(long=_words("output")),  # git 2.47.3
    "git show": Guard(long=_words("output")),
    "git diff": Guard(long=_words("output")),
    "git branch": Guard(check=branch_write),
    "zizmor": Guard(long=_words("fix")),  # docs.zizmor.sh/usage
    "trivy": Guard(long=_words("output module-dir config"), short="oc"),  # trivy.dev CLI reference
    "gitleaks detect": Guard(long=_words("report-path log-opts"), short="r"),  # gitleaks README
    "pip-audit": Guard(check=pip_audit_resolves),  # pypa/pip-audit README
    "uv audit": Guard(missing="--frozen"),  # uv 0.12.23: locking runs the project's build backend
    "cargo-audit audit": Guard(
        long=_words("db"), short="d", verbs=_words("fix")
    ),  # rustsec cargo-audit README
    "cargo-deny check": Guard(
        long=_words("graph"), short="g"
    ),  # cargo-deny check --help: graph_output is recreated
    # npm 11.20.0, pnpm 12.18.0: a registry or npmrc the agent picks gets the environment's tokens;
    # pnpm runs .pnpmfile.cjs (or the file pnpm-workspace.yaml names) unless --ignore-pnpmfile
    "npm audit": Guard(verbs=_words("fix"), long=_words("registry userconfig globalconfig")),
    "pnpm audit": Guard(check=pnpm_audit_unsafe, missing="--ignore-pnpmfile"),
    "semgrep": Guard(long=_words("autofix output"), short="ao", suffix="-output"),  # semgrep CLI reference
    "docker build": Guard(check=docker_build_unsafe),  # docker docs; BuildKit frontend syntax
    "docker compose config": Guard(long=_words("output"), short="o"),
    "cosign verify": Guard(long=_words("output-file")),  # sigstore cosign docs
    "actionlint": Guard(single=_words("shellcheck pyflakes")),  # rhysd/actionlint usage
    "go list": Guard(single=_words("toolexec exec mod modfile")),  # go help build, list
    "go env": Guard(single=_words("w u")),
    # schema starts every provider binary, one committed under .terraform/ included
    "terraform providers": Guard(verbs=_words("lock mirror schema")),  # developer.hashicorp.com
    "tofu providers": Guard(verbs=_words("lock mirror schema")),
    "kubectl kustomize": Guard(long=_words("output"), short="o"),  # kubectl reference
    "kustomize build": Guard(long=_words("output"), short="o"),
    "helm template": Guard(long=_words("output-dir dependency-update")),  # helm.sh docs
    "kubeconform": Guard(single=_words("cache")),  # yannh/kubeconform README
    "curl": Guard(check=curl_unsafe),  # curl 8.14.1
}


def guard_keys(plain: list[str]) -> list[tuple[str, int]]:
    """The guard keys a segment can meet, each with where its arguments start: the command word,
    then with one and two verbs read past the global options."""
    verb = strip_global_options(plain)
    keys = [(plain[0], 1)]
    keys += [(" ".join(verb[: n + 1]), n + 1) for n in (1, 2) if len(verb) > n]
    return keys


def guarded(plain: list[str]) -> str | None:
    """The reason a read-list command writes or runs (gate-findings A2, A3), or None."""
    if not plain:
        return None
    verb = strip_global_options(plain)
    for key, start in guard_keys(plain):
        guard = READ_GUARDS.get(key)
        tokens = plain[1:] if start == 1 else verb[start:]
        if guard and guard.missing and guard.missing not in tokens:
            return f"{key} without {guard.missing} can write or run; {READ_LIST_GAP}"
        token = guard and guarded_token(tokens, guard)
        if token:
            return f"{key} '{token[:30]}' can write or run; {READ_LIST_GAP}"
    return None


def written_file(reached: Reached) -> str | None:
    """The reason no agent-scoped allow counts: a redirection of the command, or of a runner body
    it expands, writes a file (gate-findings A, redirection writes)."""
    for word in reached.writes:
        if word not in SAFE_WRITE_TARGETS:
            return f"redirection to '{show(word, shell.REGISTRY)[:40]}' writes a file; {READ_LIST_GAP}"
    return None


# ---------------------------------------------------------------- repository configuration (gate-repo-config)

TOOLCHAIN_FILES = ("rust-toolchain", "rust-toolchain.toml", ".cargo/config", ".cargo/config.toml")
PROGRAM_FILES = frozenset({"rust-toolchain", "rust-toolchain.toml", "config", "config.toml"})
# command word -> the files in the working directory and its parents that decide what it runs:
# rustup's toolchain file (a ``path`` runs that toolchain's binaries) and cargo's config
# (``build.rustc-wrapper``); npm's and pnpm's registry and token settings; trivy's config
CONFIG_FILES: dict[str, tuple[str, ...]] = {
    "cargo": TOOLCHAIN_FILES,
    "rustc": TOOLCHAIN_FILES,
    "cargo-audit": TOOLCHAIN_FILES,
    "cargo-deny": TOOLCHAIN_FILES,
    "npm": (".npmrc",),
    # pnpm also runs .pnpmfile.cjs, or a file pnpm-workspace.yaml names: pnpm audit needs
    # --ignore-pnpmfile (READ_GUARDS); package.json's packageManager can switch pnpm's version
    "pnpm": (".npmrc", "pnpm-workspace.yaml", "package.json"),
}
CWD_CONFIG_FILES = {"trivy": ("trivy.yaml",)}  # read from the working directory only
PARENT_FILES = (*TOOLCHAIN_FILES, ".npmrc", "pnpm-workspace.yaml", ".pnpmfile.cjs", ".pnpmfile.mjs")
DEFAULT_BRANCHES = ("refs/remotes/origin/main", "refs/remotes/origin/master")
DOCKER_BUILD_VALUES = frozenset(
    "-t --tag --build-arg --target --platform --network --label --secret --ssh --cache-from --cache-to "
    "--progress --add-host --shm-size --ulimit --call --build-context --annotation --attest --sbom "
    "--provenance --allow --cgroup-parent --isolation -m --memory --memory-swap -c --cpu-shares "
    "--cpuset-cpus --cpuset-mems --cpu-period --cpu-quota -f --file --no-cache-filter --security-opt "
    "--policy".split()
)
DOCKER_BUILD_FLAGS = frozenset("--check --no-cache --pull -q --quiet --rm --force-rm".split())
DOCKERFILE_NAMES = ("Dockerfile", "dockerfile")  # BuildKit falls back to the lower-case name


class RepositoryConfig:
    """What the gate knows of the repository a hook call runs in, asked once and only when a
    segment meets a row whose program the repository's files can choose (gate-repo-config)."""

    def __init__(self, cwd: Path) -> None:
        self.cwd = cwd
        self._trust: tuple[bool, str] | None = None
        self._top: Path | None = None
        self._ref: str | None = None
        self.changed: dict[Path, str | None] = {}  # changed_file per path, once per hook call

    def trust(self) -> tuple[bool, str]:
        if self._trust is None:
            self._trust = gate_trust(self.cwd)
        return self._trust

    def top(self) -> Path:
        if self._top is None:
            self._top = checkout_root(self.cwd).resolve()
        return self._top

    def ref(self) -> str:
        """The commit the deciding files must match: origin's default branch, ``HEAD`` without a
        remote, "" when origin has no default branch the gate can find."""
        if self._ref is None:
            self._ref = default_branch(self.top())
        return self._ref


def gate_trust(cwd: Path) -> tuple[bool, str]:
    """The gate's trust, stricter than memory's: never foreign mode; every remote parsed and owned
    by an identity; a listed root commit only without any remote and with a single root (a fork,
    or a merge of unrelated histories, shares a listed root)."""
    root = checkout_root(cwd)  # a submodule's own remotes; repo_root would read its superproject's
    if memory_dir(cwd).is_symlink():
        return False, "foreign mode, the tree is another owner's code"
    top = root.resolve()
    if cwd != top and top not in cwd.parents:
        return False, "the working directory is outside the checkout the gate reads"
    remote_map = remotes(root)
    if remote_map:
        owners, identities = remote_owners(root)
        strangers = sorted(name for name in remote_map if owners.get(name) not in identities)
        if strangers:
            return False, f"remote {', '.join(strangers)} is not an identity's"
        return True, "every remote owner is an identity"
    roots = root_commits(root)
    if len(roots) == 1 and roots[0] in trusted_roots():
        return True, "the root commit is listed, no remote"
    return False, "no remote owned by an identity and no single listed root commit"


def default_branch(top: Path) -> str:
    if not remotes(top):
        return "HEAD"
    head = git(["symbolic-ref", "-q", "refs/remotes/origin/HEAD"], top)
    candidates = [head] if head else []
    for ref in [*candidates, *DEFAULT_BRANCHES]:
        if git(["rev-parse", "--verify", "-q", f"{ref}^{{commit}}"], top):
            return ref
    return ""


# keys of a toolchain file or cargo config whose value is a program: a path names a file in the
# tree the comparison does not cover (``rustc-wrapper = "scripts/w.sh"``), a bare name is on PATH
PROGRAM_KEY_RE = re.compile(
    r"(?m)^\s*(?:path|rustc|rustdoc|rustc-wrapper|rustc-workspace-wrapper|credential-provider|"
    r"global-credential-providers)\s*=\s*(.*)$"
)


def names_a_path(data: bytes) -> bool:
    text = data.decode("utf-8", "replace")
    return any("/" in value or value.strip(" '\"[").startswith(".") for value in PROGRAM_KEY_RE.findall(text))


def changed_file(config: RepositoryConfig, path: Path) -> str | None:
    """The file's name when it is not its blob at the reference commit (untracked there, different,
    a symlink, unreadable) or names a program by path; None when it matches or does not exist. A
    symlinked folder on the way is not tracked under that path, so it differs too."""
    if path not in config.changed:
        config.changed[path] = compare_file(config, path)
    return config.changed[path]


def compare_file(config: RepositoryConfig, path: Path) -> str | None:
    if not (path.exists() or path.is_symlink()):
        return None
    ref = config.ref()
    try:
        relative = path.relative_to(config.top()).as_posix()
        data = path.read_bytes() if path.is_file() and not path.is_symlink() else None
    except (OSError, ValueError):
        return str(path)
    if not ref or data is None:
        return str(path)
    blob = git_bytes(["cat-file", "blob", f"{ref}:{relative}"], config.top())
    if blob != data:
        return str(path)
    return str(path) if path.name in PROGRAM_FILES and names_a_path(data) else None


def parent_config(config: RepositoryConfig) -> str | None:
    """A toolchain, cargo or npm file above the repository (rustup, cargo and npm read every parent
    directory); the owner's own ``$CARGO_HOME`` and ``~/.npmrc`` are left out."""
    homes = {Path(os.environ.get("CARGO_HOME") or Path.home() / ".cargo"), Path.home() / ".cargo"}
    own = {(home / name).resolve() for home in homes for name in ("config", "config.toml")}
    own.add((Path.home() / ".npmrc").resolve())
    for folder in config.top().parents:
        for name in PARENT_FILES:
            path = folder / name
            if path.resolve() not in own and (path.exists() or path.is_symlink()):
                return str(path)
    return None


def safe_build_path(word: str) -> bool:
    """A path inside the working directory: relative, no ``..``, ``~``, ``-``, URL or hole."""
    if (
        not word
        or shell.has_sentinel(word)
        or word.startswith(("/", "~", "-"))
        or "://" in word
        or "@" in word
    ):
        return False
    return ".." not in Path(word).parts


def docker_build_files(plain: list[str], cwd: Path) -> list[Path] | str:
    """The Dockerfiles ``docker build`` may read, or the word that makes them unknown: an option the
    gate does not read (it could take the next word as its value), more than one context, a context
    that is no directory here (``github.com/x/y`` is a git context), a path outside."""
    verb = strip_global_options(plain)
    rest, dockerfile, contexts = list(verb[2:]), None, []
    while rest:
        arg = rest.pop(0)
        name, has_value, value = arg.partition("=")
        if name in ("-f", "--file") or (arg.startswith("-f") and not arg.startswith("--")):
            value = value if has_value else (arg[2:] or (rest.pop(0) if rest else ""))
            if not safe_build_path(value):
                return value or arg
            dockerfile = value
        elif name in DOCKER_BUILD_VALUES:
            rest = rest if has_value else rest[1:]
        elif option_word(arg):
            if arg not in DOCKER_BUILD_FLAGS:
                return arg
        elif not safe_build_path(arg) or contexts:
            return arg
        else:
            contexts.append(arg)
    context = contexts[0] if contexts else "."
    if not (cwd / context).is_dir():
        return context
    if dockerfile:
        return [cwd / dockerfile]
    return [cwd / context / name for name in DOCKERFILE_NAMES]


def deciding_files(plain: list[str], config: RepositoryConfig) -> list[Path] | str | None:
    """The files that decide what a read-list command runs, the word that makes them unknowable,
    or None when the repository's files cannot choose its program."""
    head = plain[0]
    if head in CONFIG_FILES:
        folders = [config.cwd, *config.cwd.parents]
        top = config.top()
        inside = [folder for folder in folders if folder == top or top in folder.parents]
        return [folder / name for folder in inside for name in CONFIG_FILES[head]]
    if head in CWD_CONFIG_FILES:
        return [config.cwd / name for name in CWD_CONFIG_FILES[head]]
    if strip_global_options(plain)[:2] == ["docker", "build"]:
        return docker_build_files(plain, config.cwd)
    if head == "pip-audit":  # it runs ``python -m pip``, which imports pip from the working directory
        return sorted(
            entry for entry in config.cwd.iterdir() if entry.name == "pip" or entry.name.startswith("pip.")
        )
    return None


def repository_config(plain: list[str], origin: str, config: RepositoryConfig) -> str | None:
    """The reason a read-list command whose program the repository's files can choose loses the
    read list: a runner's command, an untrusted repository, a deciding file above the repository
    or one that differs from origin's default branch (gate-repo-config)."""
    if not plain:
        return None
    files = deciding_files(plain, config)
    if files is None:
        return None
    head = plain[0]
    if origin:
        return f"{head} via {origin[:30]} reads the repository's configuration; {READ_LIST_GAP}"
    if isinstance(files, str):
        return f"{head} '{files[:40]}' could read files outside the working directory; {READ_LIST_GAP}"
    if head == "pip-audit":
        return (
            files
            and f"pip-audit imports '{files[0].name}' from the working directory; {READ_LIST_GAP}"
            or None
        )
    trusted, why = config.trust()
    if not trusted:
        return f"{head} reads the repository's configuration and the repository is not trusted ({why})"
    above = parent_config(config) if head in CONFIG_FILES else None
    if above:
        return f"{head} reads '{above[:50]}' above the repository; {READ_LIST_GAP}"
    for path in files:
        changed = changed_file(config, path)
        if changed:
            return (
                f"{head} reads '{changed[-50:]}', which differs from origin's default branch; {READ_LIST_GAP}"
            )
    return None


API_CLIS = ("gh", "glab", "gt", "tea")  # gt is Gitea's CLI; tea, its archived predecessor, still installed
API_BODY_FLAGS = ("-f", "-F", "--field", "--raw-field", "--input", "-d", "--data")
_GT_VERBS = {"new": "create", "rm": "delete", "add": "create"}
_TEA_VERBS = {"c": "create", "e": "edit", "rm": "delete", "ls": "list", "open": "reopen"}
# CLI aliases rewritten to their canonical command before matching (read 2026-11-10 from each
# CLI's source or docs), so one rule row covers every alias form: group alias → (group, verbs).
_LS = {"ls": "list"}
# gh 2.103.3, the ALIASES sections of `gh <group> [<verb>] --help`, read 2026-11-17
_GH_GROUPS: dict[str, tuple[tuple[str, ...], dict[str, str]]] = {
    "pr": ((), {**_LS, "new": "create", "co": "checkout"}),
    "issue": ((), {**_LS, "new": "create"}),
    "release": ((), {**_LS, "new": "create"}),
    "repo": ((), {**_LS, "new": "create"}),
    "gist": ((), {**_LS, "new": "create"}),
    "secret": ((), {**_LS, "remove": "delete"}),
    "variable": ((), {**_LS, "remove": "delete"}),
    "extension": (("extensions", "ext"), {**_LS, "uninstall": "remove"}),
    "codespace": (("cs",), _LS),
    "ruleset": (("rs",), _LS),
    "attestation": (("at",), {}),
    "agent-task": (("agent-tasks", "agent", "agents"), {}),
    "discussion": ((), _LS),
    "skill": (("skills",), {**_LS, "add": "install", "show": "preview"}),
    **{group: ((), _LS) for group in ("alias", "cache", "config", "gpg-key", "label", "org", "project")},
    **{group: ((), _LS) for group in ("run", "ssh-key", "workflow")},
}
_GH_COMMAND_ALIASES = {"co": ["pr", "checkout"]}  # gh's preset alias, not a group
# every top-level word gh 2.103.3 knows (`gh --help`, its help topics, the group aliases): another
# word is a user alias (`gh alias set`, which may run a shell) or an installed extension
GH_COMMANDS = frozenset(
    "auth browse codespace discussion gist issue org pr project release repo skill cache run workflow "
    "co agent-task alias api attestation completion config copilot extension gpg-key label licenses "
    "preview ruleset search secret ssh-key status variable accessibility actions environment "
    "exit-codes formatting mintty reference telemetry help version a11y".split()
) | {name for group, (names, _) in _GH_GROUPS.items() for name in names}
CLI_ALIASES: dict[str, dict[str, tuple[str, dict[str, str]]]] = {
    "gh": {name: (group, verbs) for group, (names, verbs) in _GH_GROUPS.items() for name in (group, *names)},
    "glab": {
        "mr": ("mr", {"new": "create", "accept": "merge", "comment": "note"}),
        "issue": ("issue", {"new": "create", "comment": "note"}),
    },
    "gt": {
        group: (group, _GT_VERBS)
        for group in ("pr", "issue", "release", "repo", "label", "project", "milestone")
    },
    "tea": {
        **dict.fromkeys(
            ("pulls", "pull", "pr"),
            ("pulls", {**_TEA_VERBS, "m": "merge", "lgtm": "approve", "a": "approve", "co": "checkout"}),
        ),
        **dict.fromkeys(("releases", "release", "r"), ("releases", _TEA_VERBS)),
        **dict.fromkeys(("assets", "asset", "a"), ("assets", _TEA_VERBS)),
        **dict.fromkeys(
            ("repos", "repo"),
            (
                "repos",
                {**_TEA_VERBS, "ct": "create-from-template", "f": "fork", "m": "migrate", "s": "search"},
            ),
        ),
        **dict.fromkeys(("issues", "issue", "i"), ("issues", _TEA_VERBS)),
        **dict.fromkeys(("comments", "comment", "c"), ("comments", {**_TEA_VERBS, "a": "add"})),
        **dict.fromkeys(("labels", "label"), ("labels", _TEA_VERBS)),
        **dict.fromkeys(("milestones", "milestone", "ms"), ("milestones", _TEA_VERBS)),
        **dict.fromkeys(
            ("webhooks", "webhook", "hooks", "hook"), ("webhooks", {**_TEA_VERBS, "u": "update"})
        ),
        **dict.fromkeys(
            ("branches", "branch", "b"), ("branches", {"P": "protect", "U": "unprotect", "rn": "rename"})
        ),
    },
}


def canonical_gh_api(tokens: list[str]) -> list[str]:
    """``gh api repos/x -X DELETE``, ``gh api -XDELETE repos/x`` and ``glab api …`` become
    ``<cli> api -X <METHOD> …``; a body flag (``-f``, ``-F``, ``--field``, ``--raw-field``,
    ``--input``) without an explicit method is the implicit POST both CLIs perform."""
    if len(tokens) < 2 or tokens[0] not in API_CLIS or tokens[1] != "api":
        return tokens
    rest: list[str] = []
    method = None
    body = False
    i = 2
    while i < len(tokens):
        token = tokens[i]
        if token in ("-X", "--method") and i + 1 < len(tokens):
            method, i = tokens[i + 1].upper(), i + 2
            continue
        if token.startswith("-X") and len(token) > 2:
            method = token[2:].removeprefix("=").upper()  # pflag takes ``-X=DELETE`` too
        elif token.startswith("--method="):
            method = token.split("=", 1)[1].upper()
        else:
            if token in API_BODY_FLAGS or token.startswith(("--field=", "--raw-field=", "--input=")):
                body = True
            elif re.fullmatch(r"-[fF][^-].*", token):
                body = True
            rest.append(token)
        i += 1
    if method is None and body:
        method = "POST"
    return [tokens[0], "api", "-X", method, *rest] if method else tokens


# git config's grammar, git 2.46+ (both syntaxes), for its canonical form (spec gate-f36-f40-f44,
# story 3): `git config <scope> <read|write> [exec] <key> <value>`
GIT_CONFIG_VALUE_OPTIONS = frozenset(
    {"-f", "--file", "--blob", "--comment", "--default", "--type", "--value", "--url"}
)
GIT_CONFIG_SCOPES = frozenset({"--global", "--system", "--local", "--worktree"})
GIT_CONFIG_READS = frozenset(
    {"--get", "--get-all", "--get-regexp", "--get-urlmatch", "--get-color", "--get-colorbool", "--list", "-l"}
)
GIT_CONFIG_WRITES = frozenset(
    {
        "--unset", "--unset-all", "--add", "--replace-all", "--rename-section", "--remove-section",
        "--edit", "-e",
    }
)  # fmt: skip
GIT_CONFIG_SUBCOMMANDS = {
    "get": "read", "list": "read", "set": "write", "unset": "write", "edit": "write",
    "rename-section": "write", "remove-section": "write",
}  # fmt: skip
# an editor may write any key, and a renamed section may become one that runs code
GIT_CONFIG_ANY_KEY = frozenset({"--edit", "-e", "edit", "--rename-section", "rename-section"})
# keys whose value git runs, or that make git run or fetch other code later
GIT_EXEC_NAMES = frozenset(
    {
        "cmd", "command", "program", "helper", "driver", "textconv", "path", "editor", "pager",
        "defaultkeycommand", "tunnel", "clean", "smudge", "authorsprog", "httpd",
    }
)  # fmt: skip
GIT_EXEC_KEYS = frozenset(
    {
        "core.hookspath", "core.fsmonitor", "core.sshcommand", "core.gitproxy",
        "core.alternaterefscommand", "core.worktree", "core.askpass", "interactive.difffilter",
        "diff.external", "uploadpack.packobjectshook", "protocol.allow", "init.templatedir",
    }
)  # fmt: skip
GIT_EXEC_SECTIONS = frozenset({"pager", "filter", "sendemail"})
GIT_EXEC_SUBSECTION_NAMES = {
    "remote": {"uploadpack", "receivepack", "url", "pushurl", "vcs"}, "protocol": {"allow"},
    "url": {"insteadof", "pushinsteadof"}, "submodule": {"update"},
}  # fmt: skip
# an alias of one of these words alone stays a plain key; any other alias runs a command
GIT_ALIAS_READS = frozenset({"status", "log", "diff", "show", "blame", "shortlog", "describe"})
# a variable that moves `git config` to another file; GIT_CONFIG_COUNT and its pairs last one run
GIT_CONFIG_ENV = {
    "GIT_CONFIG": "--file", "GIT_DIR": "--file", "GIT_COMMON_DIR": "--file",
    "GIT_CONFIG_GLOBAL": "--global", "GIT_CONFIG_SYSTEM": "--system",
}  # fmt: skip
GIT_CONFIG_FLAGS = frozenset(
    {
        "--show-origin", "--show-scope", "--name-only", "--null", "--includes", "--bool", "--int",
        "--bool-or-int", "--path", "--expiry-date", "--fixed-value", "--all", "--append", "--regexp",
    }
)  # fmt: skip
GIT_CONFIG_KNOWN = GIT_CONFIG_SCOPES | GIT_CONFIG_VALUE_OPTIONS | GIT_CONFIG_READS | GIT_CONFIG_WRITES
GIT_CONFIG_LONG = frozenset(name for name in GIT_CONFIG_KNOWN | GIT_CONFIG_FLAGS if name.startswith("--"))
GIT_CONFIG_SHORT = {"f": "--file", "l": "--list", "e": "--edit", "z": "--null"}


def git_exec_key(key: str) -> bool:
    """A key whose value git runs later, matched without case: by its last name, its section, or
    by name (spec gate-f36-f40-f44, Plan 5)."""
    parts = key.lower().split(".")
    if len(parts) < 2:
        return False
    section, last = parts[0], parts[-1]
    return (
        last in GIT_EXEC_NAMES
        or f"{section}.{last}" in GIT_EXEC_KEYS
        or section in GIT_EXEC_SECTIONS
        or (len(parts) > 2 and last in GIT_EXEC_SUBSECTION_NAMES.get(section, ()))
    )


def git_config_long(raw: str) -> str | None:
    """The long option a word names, as git's parse-options reads it: exact, or a unique prefix
    (``--glob`` is ``--global``); a ``--no-`` form changes nothing here. None when unknown."""
    negated = raw.startswith("--no-")
    base = "--" + raw[5:] if negated else raw
    found = [base] if base in GIT_CONFIG_LONG else [name for name in GIT_CONFIG_LONG if name.startswith(base)]
    if len(found) != 1:
        return None
    return "--no-" + found[0][2:] if negated else found[0]


def git_config_option(word: str) -> tuple[list[str] | None, str | None, bool]:
    """The options a word names, its attached value, and whether it takes the next word. A short
    cluster is read letter by letter (``-zf <file>``). None when any part is unknown."""
    if word.startswith("--"):
        raw, eq, value = word.partition("=")
        name = git_config_long(raw)
        if name is None:
            return None, None, False
        return [name], value if eq else None, not eq and name in GIT_CONFIG_VALUE_OPTIONS
    names: list[str] = []
    for at, letter in enumerate(word[1:], start=2):
        if letter not in GIT_CONFIG_SHORT:
            return None, None, False
        names.append(GIT_CONFIG_SHORT[letter])
        if letter == "f":
            return names, word[at:] or None, not word[at:]
    return names, None, False


def git_config_parts(tokens: list[str]) -> tuple[str, str, str | None, bool, list[str]]:
    """The scope, its file, the action an option names, whether it may write any key, and the
    words. An unknown option counts as a word that may write any key: fail closed."""
    scope, path, action, any_key, words, i = "--local", "", None, False, [], 2
    while i < len(tokens):
        word = tokens[i]
        if word == "--":
            words += tokens[i + 1 :]
            break
        optional = word.startswith("-") and word != "-"
        names, value, takes_next = git_config_option(word) if optional else ([], None, False)
        if not names:
            words.append(word)
            any_key = any_key or names is None
            i += 1
            continue
        if takes_next:
            value = tokens[i + 1] if i + 1 < len(tokens) else ""
        for name in names:
            if name in ("--file", "--blob"):
                scope, path = "--file", value or ""
            elif name in GIT_CONFIG_SCOPES and scope in ("--local", "--worktree"):
                scope = name
            if name in GIT_CONFIG_WRITES | GIT_CONFIG_READS:
                action = "write" if name in GIT_CONFIG_WRITES else action or "read"
                any_key = any_key or name in GIT_CONFIG_ANY_KEY
        i += 2 if takes_next else 1
    return scope, path, action, any_key, words


def canonical_git_config(tokens: list[str]) -> list[str]:
    """``git config --global user.name x``, ``git config set --global user.name x`` and
    ``git config user.name x --global`` become ``git config --global write user.name x``; a key
    that runs code later (or one the command cannot show) adds ``exec`` after the action."""
    if tokens[:2] != ["git", "config"]:
        return tokens
    scope, path, action, any_key, words = git_config_parts(tokens)
    if words and words[0] in GIT_CONFIG_SUBCOMMANDS:
        action = "write" if action == "write" else GIT_CONFIG_SUBCOMMANDS[words[0]]
        any_key = any_key or words[0] in GIT_CONFIG_ANY_KEY
        words = words[1:]
    action = action or ("write" if len(words) > 1 else "read")
    key = words[0].lower() if words else ""
    runs = action == "write" and (
        any_key
        or (bool(words) and unknown_word(words[0]))
        or any(git_exec_key(word) for word in words)
        or (key.startswith("alias.") and git_alias_runs(words[1:]))
    )
    where = ["--file", path] if scope == "--file" else [scope]
    marked = ["exec"] if runs else []
    return ["git", "config", *where, action, *marked, *([key] if words else []), *words[1:]]


def unknown_word(word: str) -> bool:
    """A word the gate cannot read: a parameter, or a substitution or glob it replaced."""
    return "$" in word or bool(shell.sentinels(word))


def git_alias_runs(values: list[str]) -> bool:
    """An alias value other than one read-only verb runs a command: ``!sh``, ``-c …`` options, or
    a git command such as ``config --global`` (the alias then writes what the row would ask)."""
    return bool(values) and not (len(values) == 1 and values[0] in GIT_ALIAS_READS)


def git_config_scope(tokens: list[str], plain: list[str]) -> list[str]:
    """``GIT_CONFIG_GLOBAL=x git config …`` and ``git --git-dir=x config …``: the scope the
    environment or a global option gives, put after ``config`` so the canonical form reads it."""
    stripped = strip_global_options(plain)
    if stripped[:2] != ["git", "config"]:
        return plain
    hint: list[str] = []
    for word in tokens[: len(tokens) - len(plain)]:
        name, _, value = word.partition("=")
        scope = GIT_CONFIG_ENV.get(name) if NAME_ASSIGNMENT_RE.match(word) else None
        hint += ["--file", value] if scope == "--file" else [scope] if scope else []
    globals_ = plain[1 : 1 + len(plain) - len(stripped)]
    for at, word in enumerate(globals_):
        if word.split("=", 1)[0] == "--git-dir":
            following = globals_[at + 1] if at + 1 < len(globals_) else ""
            hint += ["--file", word.partition("=")[2] if "=" in word else following]
    at = len(plain) - len(stripped) + 2
    return [*plain[:at], *hint, *plain[at:]] if hint else plain


VARIABLE_BUILTINS = frozenset({"export", "declare", "typeset", "local"})
GIT_VARIABLE = "git-config-variable"  # the canonical word for a variable of GIT_CONFIG_ENV


def canonical_git_variables(tokens: list[str]) -> list[str]:
    """``export GIT_DIR=x`` and ``local -x GIT_CONFIG_GLOBAL=y`` become ``<builtin>
    git-config-variable``: the commands after it read git config from another file."""
    if tokens[:1] and tokens[0] in VARIABLE_BUILTINS:
        if any(word.split("=", 1)[0] in GIT_CONFIG_ENV for word in tokens[1:]):
            return [tokens[0], GIT_VARIABLE]
    return tokens


PRINTS_CREDENTIAL = "--prints-credential"  # the canonical word a credential printer ends with
SHOW_TOKEN_CLIS = {"gh": frozenset({"-h", "--hostname"}), "glab": frozenset({"-h", "--hostname"})}
SECRET_OUTPUTS = ("yaml", "kyaml", "json", "jsonpath", "go-template", "custom-columns", "template")


def canonical_credential_printers(tokens: list[str]) -> list[str]:
    """``gh auth status -at`` and ``glab auth status --show-token`` become ``<cli> auth status
    --prints-credential``; ``kubectl get secret x -o yaml`` (any order, ``-ojson``,
    ``--output=…``) becomes ``kubectl get secret --prints-credential`` (spec story 4)."""
    if tokens[:1] and tokens[0] in SHOW_TOKEN_CLIS and tokens[1:3] == ["auth", "status"]:
        if shows_token(tokens[3:], SHOW_TOKEN_CLIS[tokens[0]]):
            return [*tokens[:3], PRINTS_CREDENTIAL]
    if tokens[:2] == ["kubectl", "get"] and prints_secret(tokens[2:]):
        return ["kubectl", "get", "secret", PRINTS_CREDENTIAL]
    return tokens


def shows_token(args: list[str], takes_value: frozenset[str]) -> bool:
    """``--show-token`` or a ``t`` in a short cluster, past the hostname option's value."""
    skip = False
    for word in args:
        if skip or word == "--":
            skip = False
            continue
        if word.split("=", 1)[0] == "--show-token":
            return word.partition("=")[2].lower() not in ("false", "0")
        if word.startswith("-") and not word.startswith("--"):
            letters = word[1:]
            if "t" in letters.split("h", 1)[0]:
                return True
            skip = letters.endswith("h")
        skip = skip or word in takes_value
    return False


KUBECTL_GET_VALUES = frozenset(
    {
        "-n", "--namespace", "-l", "--selector", "--context", "--cluster", "--user", "-o",
        "--output", "--field-selector", "--template", "-L", "--label-columns", "--sort-by",
        "--chunk-size", "--kubeconfig", "--raw", "-f", "--filename", "-k", "--kustomize",
    }
)  # fmt: skip


def kubectl_get_options(args: list[str]) -> tuple[str, dict[str, str]]:
    """The first resource word of ``kubectl get`` and its options' values (``-ojson`` included)."""
    resource, values, at = "", {}, 0
    while at < len(args):
        word = args[at]
        name, eq, value = word.partition("=")
        if word.startswith("-o") and not word.startswith("--") and len(word) > 2:
            values["-o"] = word[2:].removeprefix("=")
        elif word.startswith("-"):
            if not eq and name in KUBECTL_GET_VALUES:
                value, at = (args[at + 1] if at + 1 < len(args) else ""), at + 1
            values["-o" if name == "--output" else name] = value
        elif not resource:
            resource = word.lower()
        at += 1
    return resource, values


def prints_secret(args: list[str]) -> bool:
    """A ``kubectl get`` of a secret whose output prints its data: a data format (in any case),
    ``--template``, or a ``--raw`` API path to secrets."""
    resource, values = kubectl_get_options(args)
    if "/secrets" in values.get("--raw", ""):
        return True
    kinds = {part.split("/", 1)[0].split(".", 1)[0] for part in resource.split(",")}
    if not kinds & {"secret", "secrets"}:
        return False
    return "--template" in values or values.get("-o", "").lower().startswith(SECRET_OUTPUTS)


ALLEXPORT = "set-allexport"  # one word: a `set …` row would ask on every `set -- <glob>`


def canonical_allexport(tokens: list[str]) -> list[str]:
    """``set -a``, ``set -ea`` and ``set -o allexport`` become ``set-allexport``."""
    if tokens[:1] != ["set"]:
        return tokens
    for at, word in enumerate(tokens[1:], start=1):
        if word == "--":
            break
        if (word.startswith("-") and "a" in word[1:] and word[1] != "-") or (
            word == "-o" and tokens[at + 1 : at + 2] == ["allexport"]
        ):
            return [ALLEXPORT]
    return tokens


def canonical_alias(tokens: list[str]) -> list[str]:
    """``glab mr new``, ``gt release new``, ``tea r c`` become ``glab mr create``,
    ``gt release create``, ``tea releases create``: the form the rule rows name."""
    if tokens[:1] == ["gh"] and len(tokens) > 1 and tokens[1] in _GH_COMMAND_ALIASES:
        tokens = ["gh", *_GH_COMMAND_ALIASES[tokens[1]], *tokens[2:]]
    groups = CLI_ALIASES.get(tokens[0]) if tokens else None
    if not groups or len(tokens) < 2 or tokens[1] not in groups:
        return tokens
    group, verbs = groups[tokens[1]]
    rest = tokens[2:]
    if rest and rest[0] in verbs:
        rest = [verbs[rest[0]], *rest[1:]]
    return [tokens[0], group, *rest]


# options gh and glab take between the group word and the verb (gh 2.103 lists -R/--repo as an
# inherited flag of every repository command): `gh release -R o/r create` is `gh release create`
GROUP_OPTIONS = {"gh": ("-R", "--repo", "--hostname"), "glab": ("-R", "--repo")}


def drop_group_options(tokens: list[str]) -> list[str]:
    """``gh release -R o/r create v1``, ``--repo=o/r`` and ``-Ro/r`` become ``gh release create
    v1``, so the rows naming ``<cli> <group> <verb>`` see the verb. Only the options before the
    verb move: later ones already sit under the row's trailing ``*``."""
    names = GROUP_OPTIONS.get(tokens[0]) if tokens else None
    if not names or len(tokens) < 3 or option_word(tokens[1]) or tokens[1] == "api":
        return tokens  # api is no group: canonical_gh_api reads its options
    rest, i = tokens[2:], 0
    while i < len(rest) and option_word(rest[i]):
        word, name = rest[i], rest[i].split("=", 1)[0]
        if name in names:
            i += 1 if "=" in word else 2
        elif any(word.startswith(short) and len(word) > 2 for short in names if len(short) == 2):
            i += 1  # pflag's attached shorthand value: -Ro/r
        else:
            break
    return tokens if i == 0 else [*tokens[:2], *rest[i:]]


def strip_global_options(tokens: list[str]) -> list[str]:
    """``git -C x -c k=v push`` becomes ``git push`` for the verb form; ``cargo +nightly`` loses
    its toolchain selector."""
    if not tokens or tokens[0] not in GLOBAL_OPTIONS:
        return tokens
    if tokens[0] in TOOLCHAIN_PROXIES and tokens[1:2] and tokens[1].startswith("+"):
        tokens = [tokens[0], *tokens[2:]]
    with_value, flags = GLOBAL_OPTIONS[tokens[0]]
    out = [tokens[0]]
    rest = tokens[1:]
    while rest:
        head = rest[0]
        name = head.split("=", 1)[0]
        if head.startswith("-") and name in with_value:
            rest = rest[1:] if "=" in head else rest[2:]
        elif head.startswith("-") and name in flags:
            rest = rest[1:]
        else:
            break
    return out + rest


def option_word(token: str) -> bool:
    return len(token) > 1 and token[0] in "-+"


def readings(tokens: list[str]) -> list[list[str]]:
    """Each way to read where the verb starts past the options before it (gate-findings B): a known
    value option skips its value, a known flag or ``--opt=value`` skips itself, ``--`` ends the
    options; an unknown option followed by a word records that word as a possible verb and, when
    another option follows, goes on reading it as the option's value. Each reading is the command
    word and the tokens from its verb on. Never/ask rows and the opaque check read them; allows
    match the canonical form only."""
    if len(tokens) < 2:
        return []
    with_value, flags = GLOBAL_OPTIONS.get(tokens[0], (frozenset(), frozenset()))
    starts: list[int] = []
    i = 1
    while i < len(tokens):
        word = tokens[i]
        if word == "--":
            starts.append(i + 1)
            break
        if not option_word(word):
            starts.append(i)
            break
        name = word.split("=", 1)[0]
        if "=" in word or name in flags:
            i += 1
        elif name in with_value:
            i += 2
        elif i + 1 < len(tokens) and not option_word(tokens[i + 1]):
            starts.append(i + 1)  # the verb, or the unknown option's value
            if i + 2 < len(tokens) and option_word(tokens[i + 2]):
                i += 2  # read on past the value: more options follow
            else:
                break
        else:
            i += 1
    plain_readings = [[tokens[0], *tokens[k:]] for k in starts if k < len(tokens)]
    return plain_readings + [r for r in cobra_readings(tokens) if r not in plain_readings]


COBRA_CLIS = frozenset({"gh", "glab"})
MAX_COBRA_READINGS = 32


def word_starts(tokens: list[str], start: int, takes_value: tuple[str, ...] = ()) -> list[int]:
    """Where cobra may find the next command word past the options from ``start``: ``--o=v`` and an
    attached short value (``-tx``) skip themselves; a known value option (``-R``) skips its value;
    any other option may be a boolean or take the next word, so both are followed; ``--`` ends the
    command words."""
    found: list[int] = []
    pending, seen = [start], set()
    while pending and len(seen) < MAX_COBRA_READINGS:
        i = pending.pop()
        if i in seen or i >= len(tokens) or tokens[i] == "--":
            continue
        seen.add(i)
        if not option_word(tokens[i]):
            found.append(i)
        elif "=" in tokens[i] or (not tokens[i].startswith("--") and len(tokens[i]) > 2):
            pending.append(i + 1)
        elif tokens[i] in takes_value:
            pending.append(i + 2)
        else:
            pending.extend((i + 2, i + 1))
    return sorted(found)


def without_repo_options(cli: str, words: list[str]) -> list[str]:
    """The words with the CLI's repository options and their values taken out (``-R o/r``,
    ``--repo=o/r``, ``-Ro/r``): they name where, not what, so no row reads their text."""
    names = GROUP_OPTIONS.get(cli, ())
    out, i = [], 0
    while i < len(words):
        word, name = words[i], words[i].split("=", 1)[0]
        if name in names:
            i += 1 if "=" in word else 2
        elif any(word.startswith(short) and len(word) > 2 for short in names if len(short) == 2):
            i += 1
        else:
            out.append(word)
            i += 1
    return out


def cobra_readings(tokens: list[str]) -> list[list[str]]:
    """Every ``<cli> <group> <verb> …`` a cobra CLI (gh, glab) may run, whatever options sit before
    the group or the verb (bypass review of T01): ``gh release --title x create v1`` is read as
    ``gh release create --title x v1``, the options moved after the verb so a row about their text
    (``*Generated with*``) still sees it. ``api`` is no group: ``canonical_gh_api`` reads it."""
    out: list[list[str]] = []
    for _, _, form in cobra_forms(tokens):
        if form not in out:
            out.append(form)
    return out[:MAX_COBRA_READINGS]


def cobra_forms(tokens: list[str]) -> list[tuple[int, int, list[str]]]:
    """Each cobra reading with the positions of its group and verb words in ``tokens``."""
    if not tokens or tokens[0] not in COBRA_CLIS:
        return []
    out: list[tuple[int, int, list[str]]] = []
    known = GROUP_OPTIONS.get(tokens[0], ())
    for g in word_starts(tokens, 1, known):
        if tokens[g] == "api":
            continue
        for v in word_starts(tokens, g + 1, known):
            moved = without_repo_options(tokens[0], [*tokens[1:g], *tokens[g + 1 : v]])
            form = [tokens[0], tokens[g], tokens[v], *moved, *tokens[v + 1 :]]
            if form != tokens:
                out.append((g, v, form))
    return out


def uncertain_readings(plain: list[str]) -> set[str]:
    """The cobra readings, and their canonical forms, that rest on how an unknown option before the
    verb is read (a boolean, or one taking the next word): ``gh issue --label delete list`` may be
    ``gh issue delete``. Known options and attached values (``--notes=x``, ``-tx``) are certain."""
    known = GROUP_OPTIONS.get(plain[0], ()) if plain else ()
    out: set[str] = set()
    for g, v, form in cobra_forms(plain):
        if any(branching_option(word, known) for word in [*plain[1:g], *plain[g + 1 : v]]):
            out.update((" ".join(form), " ".join(canonical(form))))
    return out


def branching_option(word: str, known: tuple[str, ...]) -> bool:
    """An option word_starts follows both ways: unknown, with no attached value."""
    attached = "=" in word or (not word.startswith("--") and len(word) > 2)
    return option_word(word) and not attached and word not in known


def never_through_option_value(
    verdict: Verdict, matched: list[Rule], segment: list[str], forms: list[str]
) -> Verdict:
    """A ``never`` row that only an uncertain cobra reading reaches asks instead (owner,
    2026-11-17): the word it reads as the verb may be an option's value. No allow lifts it."""
    uncertain = uncertain_readings(strip_wrappers(segment)) - {forms[0], forms[-1]}
    nevers = [rule for rule in matched if rule.decision == "never"]
    if not uncertain or any(matches_bash(rule, [f for f in forms if f not in uncertain]) for rule in nevers):
        return verdict
    return Verdict(ASK, None, f"an option value before the verb may make this {nevers[0].shown()}")


def is_opaque(plain: list[str]) -> bool:
    """A runner or interpreter whose real command is hidden from argv matching, as written or in
    any reading past the options before its verb (``uv -q run …``)."""
    if gh_unknown_command(plain):
        return True
    return opaque_as_read(plain) or any(opaque_as_read(r) for r in readings(plain) if r != plain)


def gh_unknown_command(plain: list[str]) -> bool:
    """``gh rc v1`` after ``gh alias set rc 'release create'``, or ``gh my-ext``: a user alias or an
    extension, which may run any command. Read on the written form only (gh's own -R/--repo
    skipped), so a value read as a word by ``cobra_readings`` never makes a command opaque."""
    verb = strip_global_options(plain) if plain[:1] == ["gh"] else []
    word = verb[1] if len(verb) > 1 else ""
    return bool(word) and not option_word(word) and word not in GH_COMMANDS


def opaque_as_read(plain: list[str]) -> bool:
    if not plain:
        return False
    head = plain[0]
    if head in OPAQUE or head.startswith("$") or head == "env" or head in WRAPPER_OPTIONS:
        # a leftover ``env`` or wrapper carries options the gate does not read
        return True
    if head == "git" and git_alias_set(plain):
        return True
    if head == "mise":  # run/exec, a global flag, or the ``mise <task>`` shorthand
        sub = plain[1] if len(plain) > 1 else ""
        if len(plain) == 2 and sub in MISE_INFO_FLAGS:
            return False
        hidden = sub in OPAQUE_SUBCOMMANDS["mise"] or sub.startswith("-") or sub not in MISE_BUILTINS
        return bool(sub) and hidden
    if head in OPAQUE_SUBCOMMANDS:
        verb = canonical_package_manager(strip_global_options(plain))
        sub = verb[1] if len(verb) > 1 else ""
        if sub in OPAQUE_SUBCOMMANDS[head] or "" in OPAQUE_SUBCOMMANDS[head]:
            return True
        if head in SCRIPT_SHORTHAND:  # `pnpm typecheck` runs the package.json script
            return bool(sub) and not sub.startswith("-") and sub not in SCRIPT_SHORTHAND[head]
        return head == "npm" and sub in NPM_SCRIPT_ALIASES
    if head in INTERPRETERS:
        return any(token in INLINE_CODE_FLAGS for token in plain[1:])
    if head in WRAPPER_PARSERS:  # opaque until expand_segments resolves the inner command
        return WRAPPER_PARSERS[head](plain) != NOTHING_HIDDEN
    return False


def split_options(
    tokens: list[str], value_options: frozenset[str], flags: frozenset[str]
) -> list[str] | None:
    """Drop a wrapper's leading options; None on an option it does not know (the inner command
    could then start anywhere, so the wrapper stays opaque)."""
    rest = list(tokens)
    while rest and rest[0].startswith("-") and rest[0] != "--":
        head = rest[0]
        name = head.split("=", 1)[0]
        if name in value_options:
            rest = rest[1:] if "=" in head else rest[2:]
        elif name in flags:
            rest = rest[1:]
        else:
            return None
    return rest


def inner_distrobox(plain: list[str]) -> list[str] | None:
    """``distrobox enter [options] [box] -- <cmd>`` (and ``distrobox-enter``, and the old ``-e``)."""
    if plain[0] == "distrobox-enter":
        tokens = plain[1:]
    elif len(plain) > 1 and plain[1] == "enter":
        tokens = plain[2:]
    else:
        return NOTHING_HIDDEN
    inner: list[str] | None = None
    if "--" in tokens:
        split = tokens.index("--")
        inner, tokens = tokens[split + 1 :], tokens[:split]
    while tokens:
        head = tokens[0]
        name = head.split("=", 1)[0]
        if name in ("-e", "--exec"):
            if "=" in head:
                return [head.split("=", 1)[1]]
            return [tokens[1]] if len(tokens) > 1 else None
        if name in DISTROBOX_VALUE_OPTIONS:
            tokens = tokens[1:] if "=" in head else tokens[2:]
        elif name in DISTROBOX_FLAGS:
            tokens = tokens[1:]
        elif head.startswith("-"):
            return None
        else:
            tokens = tokens[1:]  # the box name
    return [shlex.join(inner)] if inner else NOTHING_HIDDEN


def inner_toolbox(plain: list[str]) -> list[str] | None:
    """``toolbox run [-c box] <cmd>``; ``toolbox enter`` is interactive."""
    if len(plain) < 2 or plain[1] != "run":
        return NOTHING_HIDDEN
    rest = split_options(plain[2:], TOOLBOX_VALUE_OPTIONS, frozenset())
    return [shlex.join(rest)] if rest else None


def inner_compose(tokens: list[str]) -> list[str] | None:
    rest = split_options(tokens, COMPOSE_VALUE_OPTIONS, COMPOSE_FLAGS)
    if rest is None:
        return None
    if rest[:1] not in (["exec"], ["run"]):
        return NOTHING_HIDDEN
    rest = split_options(rest[1:], COMPOSE_RUN_VALUE_OPTIONS, COMPOSE_RUN_FLAGS)
    return [shell.join(rest[1:])] if rest and len(rest) > 1 else None


def inner_container(plain: list[str]) -> list[str] | None:
    """``docker|podman exec [options] <container> <cmd>`` and ``docker compose exec|run``."""
    plain = strip_global_options(plain)
    tokens = plain[1:]
    if plain[0] == "docker-compose":
        return inner_compose(tokens)
    if tokens[:1] == ["compose"]:
        return inner_compose(tokens[1:])
    if tokens[:1] != ["exec"]:
        return NOTHING_HIDDEN
    rest = split_options(tokens[1:], EXEC_VALUE_OPTIONS, EXEC_FLAGS)
    return [shell.join(rest[1:])] if rest and len(rest) > 1 else None


def option_value(tokens: list[str], names: tuple[str, ...]) -> list[str] | None | bool:
    """The value of the first of ``names`` in ``tokens`` (``--run x`` or ``--run=x``) as a one-command
    list; None when the option is there without a value; False when it is absent."""
    for index, token in enumerate(tokens):
        name, _, value = token.partition("=")
        if name in names:
            if value:
                return [value]
            return [tokens[index + 1]] if index + 1 < len(tokens) else None
    return False


def inner_nix(plain: list[str]) -> list[str] | None:
    """``nix develop|shell … -c <cmd>``, ``nix-shell … --run '<string>'``; ``nix run`` stays opaque."""
    if plain[0] == "nix-shell":
        found = option_value(plain[1:], ("--run", "--command"))
        return NOTHING_HIDDEN if found is False else found
    sub = plain[1] if len(plain) > 1 else ""
    if sub == "run":
        return None
    if sub not in ("develop", "shell"):
        return NOTHING_HIDDEN
    for flag in ("-c", "--command"):
        if flag in plain:
            inner = plain[plain.index(flag) + 1 :]
            return [shell.join(inner)] if inner else None
    return NOTHING_HIDDEN


def inner_flatpak(plain: list[str]) -> list[str] | None:
    """``flatpak run --command=<cmd> <app> <args>``; running the app itself hides nothing."""
    if len(plain) < 2 or plain[1] != "run":
        return NOTHING_HIDDEN
    command: str | None = None
    rest = plain[2:]
    while rest and rest[0].startswith("-"):
        name, _, value = rest[0].partition("=")
        if name == "--command":
            if value:
                command = value
            elif len(rest) > 1:
                command, rest = rest[1], rest[1:]
            else:
                return None
        rest = rest[1:]
    if command is None:
        return NOTHING_HIDDEN
    return [shell.join([command, *rest[1:]])]


def inner_chroot(plain: list[str]) -> list[str] | None:
    rest = plain[1:]
    while rest and rest[0].startswith("-"):  # chroot's own options all take ``=`` values
        rest = rest[1:]
    return [shell.join(rest[1:])] if len(rest) > 1 else NOTHING_HIDDEN


def inner_rustup(plain: list[str]) -> list[str] | None:
    """``rustup [-v|-q] run [--install] <toolchain> <cmd…>`` (rustup run --help 1.29.2, read
    2026-11-13); any other rustup command runs nothing of its own."""
    rest = plain[1:]
    while rest and rest[0] in ("-v", "--verbose", "-q", "--quiet"):
        rest = rest[1:]
    if rest[:1] != ["run"]:
        return NOTHING_HIDDEN
    positionals: list[str] = []
    options_end = False
    for index, arg in enumerate(rest[1:], start=1):
        if options_end or not arg.startswith("-") or arg == "-":
            if not positionals and "/" in arg:
                return None  # a toolchain path: its bin/ comes first on PATH, any program can be its
            positionals.append(arg)
            if len(positionals) == 2:  # the toolchain, then the command and its arguments
                return [shell.join(rest[index:])]
        elif arg == "--":
            options_end = True
        elif arg != "--install":
            return None  # an option the gate does not know: the command could start anywhere
    return None


WRAPPER_PARSERS = {
    "rustup": inner_rustup,
    "distrobox": inner_distrobox,
    "distrobox-enter": inner_distrobox,
    "toolbox": inner_toolbox,
    "docker": inner_container,
    "podman": inner_container,
    "docker-compose": inner_container,
    "nix": inner_nix,
    "nix-shell": inner_nix,
    "flatpak": inner_flatpak,
    "chroot": inner_chroot,
}


def expand_shell(plain: list[str]) -> list[str] | None:
    """``bash -c '<string>'`` (also ``-lc``, ``-ec`` …) becomes the string; a script file, stdin or an
    interactive shell stays opaque."""
    rest = plain[1:]
    while rest:
        token = rest[0]
        if token in SHELL_VALUE_OPTIONS:
            rest = rest[2:]
        elif token.startswith("--"):
            rest = rest[1:]
        elif len(token) > 1 and token[0] in "-+" and "c" in token[1:]:
            return [rest[1]] if len(rest) > 1 else None
        elif len(token) > 1 and token[0] in "-+":
            rest = rest[1:]
        else:
            return None
    return None


def mise_task_lines(spec: object) -> list[str] | None:
    """The ``run`` lines of one task spec, or None when the spec hides what runs."""
    if isinstance(spec, str):
        run: object = spec
    elif isinstance(spec, dict) and not UNRESOLVED_TASK_KEYS & spec.keys():
        run = spec.get("run")
    else:
        return None
    items = [run] if isinstance(run, str) else run
    if not isinstance(items, list) or not all(isinstance(item, str) for item in items):
        return None
    lines = [line.strip() for item in items for line in item.splitlines()]
    lines = [line for line in lines if line and not line.startswith("#")]
    if not lines or any("{{" in line for line in lines):
        return None
    return lines


def mise_task_commands(task: str, here: Path | None) -> tuple[list[str], Path] | None:
    """The commands a mise task runs and the folder of the closest config that defines it; None when
    unknown, or when ``here`` is."""
    if tomllib is None or here is None or not task or task.startswith("-"):
        return None
    start = here.resolve()
    for folder in (start, *start.parents):
        for name in MISE_CONFIGS:
            path = folder / name
            if not path.is_file():
                continue
            try:
                tasks = tomllib.loads(path.read_text(encoding="utf-8")).get("tasks", {})
            except (tomllib.TOMLDecodeError, OSError, UnicodeDecodeError):
                return None
            if isinstance(tasks, dict) and task in tasks:
                lines = mise_task_lines(tasks[task])
                return None if lines is None else (lines, folder)
    return None


def expand_mise(plain: list[str], here: Path | None) -> tuple[list[str], Dirs] | None:
    """The commands behind a mise invocation and the directories they run in: ``mise run <task>``
    (or the ``mise <task>`` shorthand) from the mise config, ``mise exec … -- <cmd>`` from argv. A
    task runs in its config's folder or ``here`` (``dir`` stays opaque): both are followed. None when
    the commands cannot be known."""
    if len(plain) < 2:
        return None
    sub, args = plain[1], plain[2:]
    if sub in ("exec", "x"):
        if (
            "--" not in args
            or args[-1] == "--"
            or any(arg.startswith(("-C", "--cd")) for arg in args[: args.index("--")])
        ):
            return None  # without ``--`` the command is not known; ``-C``/``--cd`` runs it elsewhere
        return [shell.join(args[args.index("--") + 1 :])], directories_of(here)
    if sub in ("run", "r"):
        if not args:
            return None
        task, args = args[0], args[1:]
    elif sub in MISE_BUILTINS or sub.startswith("-"):
        return None
    else:
        task = sub
    found = mise_task_commands(task, here) if ":::" not in args else None
    if found is None:
        return None
    commands, folder = found
    extra = args[1:] if args[:1] == ["--"] else args
    if extra:
        commands[-1] = f"{commands[-1]} {shlex.join(extra)}"
    return commands, frozenset({here, folder})


def parse_make_argv(args: list[str]) -> tuple[str | None, str | None, list[str], dict[str, str]] | None:
    """(directory, makefile, goals, variable overrides) of a make command line; None when an option
    the table does not know, a second -C or -f, or --eval would change what runs."""
    directory: str | None = None
    makefile: str | None = None
    goals: list[str] = []
    overrides: dict[str, str] = {}
    index = 0
    while index < len(args):
        arg = args[index]
        index += 1
        if arg == "--":
            goals.extend(args[index:])
            break
        if arg.startswith("-") and len(arg) > 1:
            name, has_value, value = arg.partition("=")
            if name in MAKE_VALUE_OPTIONS or (name[:2] in MAKE_VALUE_OPTIONS and not name.startswith("--")):
                if name not in MAKE_VALUE_OPTIONS:
                    name, value = name[:2], arg[2:]
                elif not has_value:
                    if index >= len(args):
                        return None
                    value = args[index]
                    index += 1
                if name in ("-C", "--directory"):
                    if directory is not None:
                        return None
                    directory = value
                elif name in ("-f", "--file", "--makefile"):
                    if makefile is not None or value == "-":
                        return None
                    makefile = value
                continue
            if name in ("-j", "--jobs"):
                if not has_value and index < len(args) and args[index].isdigit():
                    index += 1
                continue
            if name in MAKE_FLAGS and not has_value:
                continue
            if arg[:2] == "-j" and arg[2:].isdigit():
                continue
            if not arg.startswith("--") and all(f"-{char}" in MAKE_FLAGS for char in arg[1:]):
                continue
            return None
        if "=" in arg and not arg.startswith("="):
            name, _, value = arg.partition("=")
            overrides[name.rstrip(":?+!")] = value
            continue
        goals.append(arg)
    return directory, makefile, goals, overrides


def expand_make(plain: list[str], here: Path | None) -> tuple[list[str], Dirs] | None:
    """The recipe lines behind ``make [options] [VAR=value] [goals]``, read from the Makefile
    (``_cobot_make``), and the folder they run in (``here``, or its ``-C`` directory); None when
    they cannot be known."""
    parsed = parse_make_argv(plain[1:])
    if parsed is None or here is None:
        return None
    directory, makefile, goals, overrides = parsed
    folder = (
        Path(os.path.realpath(here / os.path.expanduser(directory))) if directory else here
    )  # make chdir()s
    commands = _cobot_make.resolve(folder, makefile, goals, overrides)
    return None if commands is None else (commands, frozenset({folder}))


def expand_uv(plain: list[str]) -> list[str] | None:
    """The command behind ``uv run [options] <cmd>``: argv after uv's own options; ``-m`` and a
    ``.py`` file become ``python …``. None on an option the table does not know."""
    if len(plain) < 3 or plain[1] != "run":
        return None
    args, index, module, script = plain[2:], 0, False, False
    while index < len(args):
        arg = args[index]
        if arg == "--":
            index += 1
            break
        if not arg.startswith("-"):
            break
        name, has_value, _ = arg.partition("=")
        if name in ("-m", "--module"):
            module = True
        elif name in ("-s", "--script"):
            script = True
        elif name == "--directory":
            return None  # the command runs in another directory
        elif name in UV_RUN_VALUE_OPTIONS:
            index += 0 if has_value else 1
        elif name not in UV_RUN_FLAGS or has_value:
            return None
        index += 1
    rest = args[index:]
    if not rest or index > len(args):
        return None
    if module:
        return [shell.join(["python", "-m", *rest])]
    if script or rest[0].endswith((".py", ".pyw")):
        return [shell.join(["python", *rest])]
    return [shell.join(rest)]


def package_scripts(here: Path | None) -> dict[str, str] | None:
    if here is None:
        return None
    path = here / "package.json"
    try:
        scripts = json.loads(path.read_text(encoding="utf-8")).get("scripts")
    except (OSError, ValueError, AttributeError):
        return None
    return (
        scripts if isinstance(scripts, dict) and all(isinstance(v, str) for v in scripts.values()) else None
    )


def expand_node(plain: list[str], here: Path | None) -> list[str] | None:
    """The commands behind a package-manager launcher: ``exec <bin>`` from argv; ``run <script>``,
    the pnpm/yarn shorthand and npm's test/start aliases from package.json, with the script's
    ``pre``/``post`` hooks. None when the runner's own flags would change which scripts run."""
    head, args = plain[0], plain[1:]
    if not args:
        return None
    sub, rest = args[0], args[1:]
    if sub in ("exec", "x") and head != "bun":
        if "--" in rest:
            rest = rest[rest.index("--") + 1 :]
        return [shlex.join(rest)] if rest and not rest[0].startswith("-") else None
    if sub in ("run", "run-script"):
        while rest and rest[0].startswith("-"):
            if rest[0] not in SCRIPT_RUN_FLAGS:
                return None
            rest = rest[1:]
        if not rest:
            return None
        name, extra = rest[0], rest[1:]
    elif head == "npm" and sub in NPM_SCRIPT_ALIASES:
        name, extra = NPM_SCRIPT_ALIASES[sub], rest
    elif head in SCRIPT_SHORTHAND and sub not in SCRIPT_SHORTHAND[head] and not sub.startswith("-"):
        name, extra = sub, rest
    else:
        return None
    if name.startswith("/") or any(
        arg in SCRIPT_SELECT_FLAGS or arg.startswith(("--filter=", "-F=")) for arg in extra
    ):
        return None  # a regex of scripts, or a flag that changes which scripts run
    scripts = package_scripts(here)
    if scripts is None or name not in scripts:
        return None
    commands = []
    for key in (f"pre{name}", name, f"post{name}"):
        if key in scripts:
            text = scripts[key]
            if key == name and extra:
                text = f"{text} {shlex.join(arg for arg in extra if arg != '--')}"
            commands.append(text)
    return commands


def expand_runner(plain: list[str], here: Path | None) -> tuple[list[str], Dirs] | None:
    """The commands behind a runner, a shell ``-c`` string or an entry wrapper, run from ``here``
    (None: a directory the gate cannot know), and the directories those commands start in; None
    when unknown. A runner that reads a file from ``here`` stays unknown while ``here`` is."""
    if not plain:
        return None
    head = plain[0]
    if head == "mise":
        return expand_mise(plain, here)
    if head in MAKE_NAMES:
        return expand_make(plain, here)
    if head == "uv":
        commands = expand_uv(plain)
    elif head in ("npm", "pnpm", "yarn", "bun"):
        commands = expand_node(plain, here)
    elif head in SHELLS:
        commands = expand_shell(plain)
    elif head in WRAPPER_PARSERS:
        commands = WRAPPER_PARSERS[head](plain)
    else:
        return None
    return None if commands is None else (commands, directories_of(here))


Part = tuple[str, list[str], list[str]]  # a runner body: scanned text, redirection targets, written ones


def command_parts(text: str, issued: frozenset[str] = frozenset()) -> Part | None:
    """The scanned text, redirection targets and written targets of a runner body; None when it
    holds a substitution or anything the scanner refuses, so the runner stays opaque. Braces and
    globs are words: a body read from disk gets holes of its own, an argv runner's inner command
    keeps the ``issued`` glob holes of the segment it came from, and any other sentinel is refused."""
    scanned = shell.scan(text, issued)
    if scanned.error or any(hole.kind not in EXPANSION_KINDS for hole in scanned.holes.values()):
        return None
    return scanned.outer, scanned.targets, scanned.writes


def argv_runner(plain: list[str]) -> bool:
    """A runner whose inner command is the rest of its argv after options it reads only before it,
    built with ``shell.join``: a glob hole there is a word of the inner command. Runners that
    resolve a name (scripts, make targets, mise tasks), read options anywhere (``npm exec``), take a
    code string (``nix-shell --run``, ``distrobox -e``) or parse flags the gate has not verified
    (``toolbox``) are not."""
    head = plain[0]
    if head == "uv":
        return plain[1:2] == ["run"]
    if head == "mise":
        return plain[1:2] in (["exec"], ["x"])
    return head in GLOB_ARGV_RUNNERS


def globs_reach_inner(plain: list[str], expansions: list[tuple[list[Part], Dirs]]) -> bool:
    """Every token of the segment holding a glob is a word of the inner commands: a glob is zero or
    more words, so one the runner's parser consumed (an option value, a container slot) could move
    every later word (``uv run --with * publish`` runs ``cargo publish`` when files ``aa`` and
    ``cargo`` exist)."""
    texts = [text for parts, _ in expansions for text, *_ in parts]
    inner = {token for text in texts for token in flatten(split_segments(text))}
    return all(token in inner for token in plain if shell.has_sentinel(token))


def flatten(segments: list[list[str]]) -> list[str]:
    return [token for segment in segments for token in segment]


# ---------------------------------------------------------------- directory in effect

Dirs = frozenset[Path] | None  # the directories a segment may run in; None when the gate cannot know


def directories_of(here: Path | None) -> Dirs:
    return None if here is None else frozenset({here})


def union(left: Dirs, right: Dirs) -> Dirs:
    return None if left is None or right is None else left | right


@dataclass(frozen=True)
class ShellState:
    """What a whole script lets the walk trust, read from its text (quotes included, so a mention
    inside a string counts too)."""

    trackable: bool  # nothing that redefines cd or how it resolves (function, alias, CDPATH, set -P)
    pwd_known: bool  # nothing can assign PWD, so ``$PWD`` is the directory in effect


def shell_state(text: str) -> ShellState:
    return ShellState(not UNTRACKABLE_RE.search(text), not PWD_UNKNOWN_RE.search(text))


def directory_verb(segment: list[str]) -> list[str] | None:
    """The argv of the ``cd``, ``pushd`` or ``popd`` a segment runs in the shell itself, from the
    verb on; ``[HIDDEN_VERB]`` when a directory verb sits anywhere else in it (behind ``nice``,
    ``sudo``, ``time``, …) or the segment can run one from a string (``eval``, ``alias``, …);
    None when it names none."""
    tokens = segment
    while tokens and (
        tokens[0] in RESERVED_HEADS
        or ("=" in tokens[0] and not tokens[0].startswith(("-", "=")))
        or (tokens[0] in IN_SHELL_PREFIXES and len(tokens) > 1 and not tokens[1].startswith("-"))
    ):
        tokens = tokens[1:]
    if tokens and tokens[0] in DIRECTORY_VERBS:
        return tokens
    hidden = tokens[:1] and tokens[0] in STRING_RUNNERS
    return [HIDDEN_VERB] if hidden or any(os.path.basename(t) in DIRECTORY_VERBS for t in segment) else None


def literal_directory(word: str) -> bool:
    """A cd operand the gate can resolve: no expansion, option or stack index. A ``~`` stays
    unknown: the split words do not show whether it was quoted (``"~/x"`` is a folder named ``~``)."""
    if not word or word[0] in "-+~" or shell.has_sentinel(word):
        return False
    return not UNSURE_PATH_CHARS & set(word)


def expand_pwd(word: str, here: Path) -> str:
    """A cd operand with a leading ``$PWD``/``${PWD}`` put in as ``here``."""
    for name in PWD_NAMES:
        if word == name or word.startswith(name + "/"):
            return str(here) + word[len(name) :]
    return word


def cd_target(here: Path | None, operands: list[str]) -> Path | None:
    """Where ``cd``/``pushd`` with these operands lands from ``here`` (None: unknown), when the gate
    can know it: one literal operand naming a directory the shell can enter. None for ``-``, a
    variable, a glob, a substitution, a relative name ``CDPATH`` could send elsewhere, or a folder
    that is not there now."""
    physical = False
    while operands[:1] and operands[0] in CD_OPTIONS:
        physical = physical or operands[0] == "-P"
        operands = operands[1:]
    if operands[:1] == ["--"]:
        operands = operands[1:]
    if len(operands) != 1 or not literal_directory(operands[0]):
        return None
    target = operands[0]
    if not os.path.isabs(target):
        if here is None or (os.environ.get("CDPATH") and target.split("/")[0] not in (".", "..")):
            return None
        target = os.path.join(here, target)
    path = os.path.realpath(target) if physical else os.path.normpath(target)  # -L is lexical
    return Path(path) if os.path.isdir(path) and os.access(path, os.X_OK) else None


def next_operator(items: list[str | list[str]], index: int) -> str:
    """The operator after the segment at ``index``, past its redirections and their targets."""
    for item in items[index + 1 :]:
        if isinstance(item, str) and item not in REDIRECTS:
            return item
    return ";"


def in_subshell(before: str, after: str) -> bool:
    """A segment in a pipeline or sent to the background runs in a child shell."""
    pipe = any("|" in op.replace("||", "") for op in (before, after))
    return pipe or "&" in after.replace("&&", "").replace("&>", "")


class DirectoryWalk:
    """Follows ``cd``, ``pushd`` and ``popd`` through one shell script: the directories each segment
    may run in. A cd may fail or be skipped, so it adds its target to the directories in effect;
    only the ``&&`` chain it leads runs in the target alone (a cd that fails runs none of it). None
    once the gate cannot know: a computed target, a ``popd``, a cd in a child shell, a loop around
    one, or a script whose state the walk does not model (``ShellState``)."""

    def __init__(self, start: Dirs, state: ShellState):
        self.start = start
        self.state = state
        self.dirs = start if state.trackable else None
        self.failed: Dirs = frozenset()  # where the current ``&&`` chain would be, had its cd failed
        self.saved: list[tuple[Dirs, Dirs]] = []
        self.compounds: list[str] = []
        self.before = ";"

    def end_chain(self) -> None:
        self.dirs, self.failed = union(self.dirs, self.failed), frozenset()

    def operator(self, token: str) -> None:
        """``&&`` continues a chain, any other operator ends it; a line of a runner body may start
        over in the runner's directory; parentheses open and close a subshell, except as ``case``
        patterns."""
        if "&&" not in token and token.strip("()"):  # a subshell is one command of the chain
            self.end_chain()
        if token == LINE:
            self.dirs = union(self.dirs, self.start)
        elif "case" not in self.compounds:
            for char in token:
                if char == "(":
                    self.saved.append((self.dirs, self.failed))
                    self.failed = frozenset()
                elif char == ")" and self.saved:
                    self.dirs, self.failed = self.saved.pop()
                elif char == ")":
                    self.dirs = None
        self.before = token

    def enter(self, tokens: list[str]) -> None:
        """Open and close the compounds the segment's leading reserved words name."""
        for token in tokens:
            if token in COMPOUND_OPENERS:
                self.compounds.append(token)
                if token in LOOP_HEADS:  # a cd in the body changes where earlier commands rerun
                    self.dirs = None
            elif token in COMPOUND_CLOSERS:
                if not self.compounds:
                    self.dirs = None
                self.compounds = self.compounds[:-1]
            elif token not in RESERVED_HEADS:
                break

    def segment(self, tokens: list[str], after: str) -> Dirs:
        """The directories the segment runs in; its own directory change applies after it."""
        self.enter(tokens)
        here = self.dirs
        argv = directory_verb(tokens)
        if argv:
            negated = "!" in tokens[: len(tokens) - len(argv)]
            leads = "&&" in after and "||" not in self.before and not negated
            self.change(argv, in_subshell(self.before, after), leads)
        return here

    def change(self, argv: list[str], child: bool, leads: bool) -> None:
        verb, operands = argv[0], argv[1:]
        if verb in (HIDDEN_VERB, "popd") or child or not self.state.trackable:
            self.dirs = None
            return
        heres = [None] if self.dirs is None else sorted(self.dirs)
        targets = [self.target(here, operands) for here in heres]
        landed = None if None in targets else frozenset(targets)
        if leads:
            self.failed = union(self.failed, self.dirs)
            self.dirs = landed
        else:
            self.dirs = union(self.dirs, landed)

    def target(self, here: Path | None, operands: list[str]) -> Path | None:
        """``cd_target``, with ``$PWD`` put in while the script cannot have changed it."""
        if self.state.pwd_known and here is not None:
            operands = [expand_pwd(word, here) for word in operands]
        return cd_target(here, operands)


def walk_directories(
    items: list[str | list[str]], start: Dirs, state: ShellState
) -> tuple[list[tuple[list[str], Dirs]], Dirs]:
    """Each segment of a script with the directories it may run in, and those in effect at its end.
    A redirection target runs nothing: it shares its command's directory."""
    segments = [item for item in items if isinstance(item, list)]
    if not any(directory_verb(segment) for segment in segments):
        return [(segment, start) for segment in segments], start
    walk = DirectoryWalk(start, state)
    placed: list[tuple[list[str], Dirs]] = []
    target = False
    for index, item in enumerate(items):
        if isinstance(item, str):
            target = item in REDIRECTS
            if not target:
                walk.operator(item)
        else:
            placed.append((item, walk.dirs if target else walk.segment(item, next_operator(items, index))))
    walk.end_chain()
    return placed, walk.dirs


# ---------------------------------------------------------------- runner expansion


@dataclass
class Reached:
    """What the redirections of a command and of the runner bodies it expands reach: every target
    word (the protected-file check) and the words a redirection writes (the read-only agents)."""

    paths: list[str] = field(default_factory=list)
    writes: list[str] = field(default_factory=list)
    visited: Dirs = frozenset()  # every directory a command may run in (None: one is unknown)

    def add(self, targets: list[str], writes: list[str]) -> None:
        self.paths.extend(target_words(targets))
        self.writes.extend(target_words(writes))


def expand_everywhere(
    plain: list[str], here: Dirs, issued: frozenset[str] = frozenset()
) -> list[tuple[list[Part], Dirs]] | None:
    """The runner's parsed commands for each directory it may run in, with the directories those
    commands start in; None when any of them cannot be known."""
    out = []
    for folder in [None] if here is None else sorted(here):
        expansion = expand_runner(plain, folder)
        if expansion is None:
            return None
        commands, start = expansion
        parts = [command_parts(command, issued) for command in commands]
        if not commands or None in parts:
            return None
        out.append(([part for part in parts if part], start))
    return out


Placed = tuple[list[str], str, Dirs]  # a command, the runner it came from, where it may run


def expand_segment(segment: list[str], here: Dirs, depth: int, reached: Reached) -> list[Placed]:
    """The segment, or the commands it runs when it is a resolvable runner or wrapper, tagged with
    the outermost origin. A segment holding a substitution is expanded only when every hole sits in
    a leading assignment's value: elsewhere the substituted text could be the code the runner runs.
    A body is walked as one script whose lines may each start
    over in the runner's directory (one shell or one per line: make's ``.ONESHELL``, a mise
    script); it runs in a new shell, so its state is read from its own text. A cased program
    (``BASH -c``) is expanded as written and in lower case: a case-insensitive volume runs both."""
    folded = program_folded(segment)
    if folded is not None:
        return [*expand_cased(segment, here, depth, reached), *expand_segment(folded, here, depth, reached)]
    return expand_cased(segment, here, depth, reached)


def expand_cased(segment: list[str], here: Dirs, depth: int, reached: Reached) -> list[Placed]:
    """``expand_segment`` for the segment as written; the commands a ``find`` runs follow it."""
    argv = strip_wrappers(segment)
    if argv[:1] and argv[0].lower() in FIND_PROGRAMS and depth < MAX_EXPANSION:
        origin = show(" ".join(argv), shell.REGISTRY)[:MAX_ORIGIN]
        tail = [
            (t, o or origin, d)
            for action, body in find_bodies(argv)
            for t, o, d in expand_segment(
                body, execdir_folders(argv, here) if action in FIND_IN_FOLDER else here, depth + 1, reached
            )
        ]
        return [*expand_plain(segment, here, depth, reached), *tail]
    if argv[:1] and argv[0].lower() in FD_PROGRAMS and depth < MAX_EXPANSION:
        origin = show(" ".join(argv), shell.REGISTRY)[:MAX_ORIGIN]
        tail = [
            (t, o or origin, d)
            for body in fd_bodies(argv)
            for t, o, d in expand_segment(body, here, depth + 1, reached)
        ]
        return [*expand_plain(segment, here, depth, reached), *tail]
    return expand_plain(segment, here, depth, reached)


def expand_plain(segment: list[str], here: Dirs, depth: int, reached: Reached) -> list[Placed]:
    """``expand_cased`` without the ``find`` bodies."""
    plain = strip_wrappers(segment)
    literal = not hole_keys(segment) or holes_only_in_assignments(segment, plain)
    globbed = not literal and all_glob(segment) and prefix_key(segment, plain) is None and argv_runner(plain)
    expandable = depth < MAX_EXPANSION and is_opaque(plain) and (literal or globbed)
    issued = frozenset(hole_keys(plain)) if globbed else frozenset()
    expansions = expand_everywhere(plain, here, issued) if expandable else None
    if not expansions or (globbed and not globs_reach_inner(plain, expansions)):
        return [(segment, "", here)]
    origin = show(" ".join(plain), shell.REGISTRY)[:MAX_ORIGIN]
    out: list[Placed] = []
    for parts, start in expansions:
        reached.add(flatten([targets for _, targets, _ in parts]), flatten([writes for *_, writes in parts]))
        texts = [text for text, *_ in parts]
        entries, _ = expand_script(texts, start, shell_state("\n".join(texts)), depth + 1, reached)
        out.extend((tokens, origin, dirs) for tokens, _, dirs in entries)
    return out


def expand_script(
    texts: list[str],
    dirs: Dirs,
    state: ShellState,
    depth: int,
    reached: Reached,
    starts: dict[str, Dirs] | None = None,
) -> tuple[list[Placed], Dirs]:
    """Expand every segment of a script given as lines, recursively up to MAX_EXPANSION levels, each
    from the directories in effect where it runs; return the directories in effect at the end too.
    Redirection targets of the bodies go to ``reached``; ``starts`` gets the directories each
    substitution sentinel sits in, and under ANYWHERE those of the whole script."""
    items: list[str | list[str]] = []
    for text in texts:
        items.extend([LINE, *shell_items(text)] if items else shell_items(text))
    placed, end = walk_directories(items, dirs, state)
    out: list[Placed] = []
    anywhere = end
    for segment, here in placed:
        anywhere = union(anywhere, here)
        if starts is not None:
            starts.update(dict.fromkeys(hole_keys(segment), here))
        out.extend(expand_segment(segment, here, depth, reached))
    if starts is not None:
        starts[ANYWHERE] = anywhere
    reached.visited = union(reached.visited, anywhere)
    return out, end


def target_words(targets: list[str]) -> list[str]:
    """Redirection targets as bash reads them: quotes removed, braces expanded (scanned: balanced)."""
    return shell.expand_braces([word for target in targets for word in shlex.split(target)])


def expand_units(
    scanned: shell.Scan, origin: str, dirs: Dirs, state: ShellState, reached: Reached, entries: list
) -> None:
    """Expand the command, then every substitution body it runs from the directories in effect
    where the substitution sits, into ``entries`` as (segment, origin, unit, dirs). A body is a forked
    subshell: it shares the whole command's state."""
    reached.add(scanned.targets, scanned.writes)
    starts: dict[str, Dirs] = {}
    placed, _ = expand_script([scanned.outer], dirs, state, 0, reached, starts)
    entries.extend((segment, via or origin, scanned, here) for segment, via, here in placed)
    for hole in scanned.holes.values():
        if hole.body is not None:
            here = starts.get(hole.key, starts[ANYWHERE])
            expand_units(hole.body, hole.span, here, state, reached, entries)


def canonical(tokens: list[str]) -> list[str]:
    steps = (
        expand_push_flags,
        canonical_package_manager,
        drop_group_options,
        canonical_alias,
        canonical_gh_api,
        canonical_gcloud,
        canonical_git_config,
        canonical_git_variables,
        canonical_allexport,
        canonical_credential_printers,
    )
    for step in steps:
        tokens = step(tokens)
    return tokens


# npm 11.20.0 lib/utils/cmd-list.js, read 2026-11-14: npm takes an alias, or any unique prefix of
# a command or alias (``npm publ`` publishes)
NPM_COMMANDS = frozenset(
    "access adduser approve-scripts audit bugs cache ci completion config dedupe deny-scripts deprecate "
    "diff dist-tag docs doctor edit exec explain explore find-dupes fund get help help-search init install "
    "install-ci-test install-scripts install-test link ll login logout ls org outdated owner pack ping pkg "
    "prefix profile prune publish query rebuild repo restart root run sbom search set shrinkwrap stage star "
    "stars start stop team test token trust undeprecate uninstall unpublish unstar update version view "
    "whoami".split()
)
NPM_ALIASES = {
    "author": "owner", "home": "docs", "issues": "bugs", "info": "view", "show": "view", "find": "search",
    "add": "install", "unlink": "uninstall", "remove": "uninstall", "rm": "uninstall", "r": "uninstall",
    "un": "uninstall", "rb": "rebuild", "list": "ls", "ln": "link", "create": "init", "i": "install",
    "it": "install-test", "cit": "install-ci-test", "u": "update", "up": "update", "c": "config",
    "s": "search", "se": "search", "tst": "test", "t": "test", "ddp": "dedupe", "v": "view",
    "run-script": "run", "clean-install": "ci", "clean-install-test": "install-ci-test", "x": "exec",
    "why": "explain", "la": "ll", "verison": "version", "ic": "ci", "innit": "init", "in": "install",
    "ins": "install", "inst": "install", "insta": "install", "instal": "install", "isnt": "install",
    "isnta": "install", "isntal": "install", "isntall": "install", "install-clean": "ci",
    "isntall-clean": "ci", "hlep": "help", "dist-tags": "dist-tag", "upgrade": "update",
    "udpate": "update", "rum": "run", "sit": "install-ci-test", "urn": "run", "ogr": "org",
    "add-user": "adduser",
}  # fmt: skip
PNPM_RECURSIVE = frozenset({"recursive", "multi", "m"})  # ``pnpm recursive publish`` is ``pnpm -r publish``


def npm_command(word: str) -> str:
    """The npm command a word names: itself, an alias, or the one command or alias it prefixes."""
    if word in NPM_COMMANDS:
        return word
    if word in NPM_ALIASES:
        return NPM_ALIASES[word]
    if not word or word.startswith("-"):
        return word
    found = {
        NPM_ALIASES.get(name, name) for name in NPM_COMMANDS | NPM_ALIASES.keys() if name.startswith(word)
    }
    return found.pop() if len(found) == 1 else word


def canonical_package_manager(tokens: list[str]) -> list[str]:
    """``npm publ`` becomes ``npm publish``, ``npm i x`` ``npm install x``; ``pnpm recursive
    publish`` becomes ``pnpm publish``: the forms the rule rows name."""
    if tokens[:1] == ["npm"] and len(tokens) > 1:
        return [tokens[0], npm_command(tokens[1]), *tokens[2:]]
    if tokens[:1] == ["pnpm"] and len(tokens) > 2 and tokens[1] in PNPM_RECURSIVE:
        return [tokens[0], *tokens[2:]]
    return tokens


def git_alias_set(plain: list[str]) -> bool:
    """``git -c alias.p='push --force' p``: the verb is an alias the command line defines."""
    for index, arg in enumerate(plain[1:], start=1):
        following = plain[index + 1] if index + 1 < len(plain) else ""
        value = following if arg == "-c" else ""
        if arg.startswith("--config-env"):
            value = arg.partition("=")[2] or following
        if value.lower().startswith("alias."):
            return True
    return False


def candidates(tokens: list[str]) -> list[str]:
    """The forms rules match: as written, each reading past the options before the verb, and last
    the canonical form, the only one an allow matches."""
    plain = git_config_scope(tokens, strip_wrappers(tokens))
    written, last = " ".join(plain), " ".join(canonical(strip_global_options(plain)))
    read = [" ".join(form) for reading in readings(plain) for form in (reading, canonical(reading))]
    middle = [form for form in dict.fromkeys(read) if form not in (written, last)]
    return [written, *middle, last] if middle or written != last else [written]


SCOPE_ALIASES = {"cobot:auditor": "consultant"}  # spec security-auditor: one read list, two agents


def agent_matches(scope: str, agent: str | None) -> bool:
    """``@consultant`` matches ``consultant`` and ``cobot:consultant``, and ``cobot:auditor`` (the
    hook's namespaced name only: a user's own agent called ``auditor`` keeps no scope)."""
    if not agent:
        return False
    if agent in SCOPE_ALIASES:
        return scope.split(":")[-1] == SCOPE_ALIASES[agent]
    return scope in (agent, agent.split(":")[-1]) or agent in (scope, scope.split(":")[-1])


def applies(rule: Rule, tool: str, agent: str | None) -> bool:
    if rule.agent and not agent_matches(rule.agent, agent):
        return False
    if rule.tool == "mcp":
        return tool.startswith("mcp__")
    return rule.tool == tool


def matches_bash(rule: Rule, forms: list[str]) -> bool:
    """never/ask match any form; allow matches only the canonical (last) form, so a method moved
    to the front of ``gh api`` cannot hide behind a read-only prefix pattern. An agent-scoped
    allow whose pattern ends a word with ``*`` (``cat*``, ``git diff*``) matches that word only:
    ``catatonit`` and ``git difftool`` are other programs."""
    candidates_for_rule = forms[-1:] if rule.decision == "allow" else forms
    return any(
        fnmatch.fnmatchcase(form, rule.pattern) and (rule.decision != "allow" or word_bounded(rule, form))
        for form in candidates_for_rule
    )


def word_bounded(rule: Rule, form: str) -> bool:
    """For an agent-scoped ``<words>*`` allow whose last word is a command or verb (not an option,
    not a path such as ``repos/``): the form is those words, or those words and a blank."""
    stem = rule.pattern[:-1]
    if not rule.agent or not rule.pattern.endswith("*") or RULE_WILDCARDS_RE.search(stem):
        return True
    last = stem.rsplit(" ", 1)[-1]
    if not last or last.startswith("-") or not last[-1].isalnum():
        return True
    return form == stem or form.startswith(stem + " ")


def allow_counts(rule: Rule) -> bool:
    """An allow silences the gate from the owner layer, or from the default layer when agent-scoped."""
    return rule.decision == "allow" and (
        rule.layer == "owner" or (rule.layer == "default" and bool(rule.agent))
    )


def resolve(matched: list[Rule], note: str = "") -> Verdict:
    """Apply the precedence: never > allow (owner, or default with an agent scope) > ask > silence."""
    nevers = [r for r in matched if r.decision == "never"]
    if nevers:
        return Verdict(DENY, nevers[0])
    if any(allow_counts(r) for r in matched):
        return Verdict(None, None, "allow rule")
    asks = [r for r in matched if r.decision == "ask"]
    if asks:
        return Verdict(ASK, asks[0])
    return Verdict(None, None, note)


RELOCATING = frozenset({"mv", "ln", "cp", "rsync", "install", "rename"})  # a folder appears or moves
CUSTOMIZATION_ROOTS_FOLDED = frozenset(root.casefold() for root in agy.CUSTOMIZATION_ROOTS)
GLOB_CHARS = "*?["


DESTROYING = frozenset({"rm", "rmdir", "unlink", "shred", "trash", "trash-put"})  # a folder vanishes


def program_of(segment: list[str]) -> list[str]:
    """The segment from its program word on, wrappers and assignments dropped, in lower case
    where a case-insensitive volume would run it so (``X=1 NOHUP RM`` is ``rm``)."""
    return strip_wrappers(program_folded(segment) or segment)


GIO_DELETING = frozenset({"trash", "remove", "rm"})
GIO_MOVING = frozenset({"move", "mv", "rename", "copy", "cp"})
FIND_ACTIONS = frozenset({"-delete", "-exec", "-execdir", "-ok", "-okdir"})  # what it runs is judged apart
FIND_IN_FOLDER = frozenset({"-execdir", "-okdir"})  # run in the folder of each entry found
FIND_PROGRAMS = frozenset({"find", "gfind"})
FIND_LEADING = frozenset({"-H", "-L", "-P"})  # options before the start paths; -D and -O take a value
IMPLICIT_FOLDER = -1  # a deleting ``find`` also deletes under the folder it runs in
FILES_FROM = -2  # a deleting ``find`` whose start paths come from a file or stdin


# options naming the folder a command writes in, by program: (short options, long options)
FOLDER_OPTIONS = {
    "tar": (("-C",), ("--directory", "--one-top-level")),
    "bsdtar": (("-C",), ("--directory",)),
    "gtar": (("-C",), ("--directory", "--one-top-level")),
    "unzip": (("-d",), ()),
    "patch": (("-d",), ("--directory",)),
    "git": (("-C",), ("--work-tree", "--git-dir")),
}
GIT_VALUE_OPTIONS = frozenset({"-c", "--namespace", "--exec-path", "--config-env"})  # before the verb


TAR_PROGRAMS = frozenset({"tar", "bsdtar", "gtar"})
FOLDER_OPTIONS_MAX = 8  # folder options one segment may name; past it the segment asks
TAR_VALUE_LETTERS = frozenset("fCbTXgNKVHL")  # old-style letters that take the next word
LONG_PREFIX_MIN = 5  # getopt takes a unique prefix of a long option: ``--dir`` is ``--directory``
GIT_FOLDER_VARIABLES = ("GIT_WORK_TREE=", "GIT_DIR=")


def long_named(word: str, longs: tuple[str, ...]) -> bool:
    name = word.split("=", 1)[0]
    return len(name) >= LONG_PREFIX_MIN and any(option.startswith(name) for option in longs)


def folder_options(segment: list[str]) -> list[str]:
    """The folders a segment names as the place it writes (F-33): ``tar -C``, ``--directory`` and
    ``--one-top-level``, ``unzip -d``, ``patch -d`` and ``--directory``, ``git -C``,
    ``--work-tree`` and ``--git-dir`` (before git's verb only: ``git commit -C`` is a commit), and
    ``GIT_WORK_TREE``/``GIT_DIR`` assignments; in separate, attached, ``=``, abbreviated long and
    clustered short forms, and tar's old-style first word (``tar xfC e.tar dir``)."""
    found = [w.split("=", 1)[1] for w in segment if w.startswith(GIT_FOLDER_VARIABLES)]
    argv = program_of(segment)
    head = argv[0] if argv else ""
    if head not in FOLDER_OPTIONS:
        return [value for value in found if value]
    shorts, longs = FOLDER_OPTIONS[head]
    letters = "".join(option[1] for option in shorts)
    i = 1
    if head in TAR_PROGRAMS and argv[1:2] and argv[1][:1].isalpha():
        takers = [letter for letter in argv[1] if letter in TAR_VALUE_LETTERS]
        found += [argv[2 + n] for n, letter in enumerate(takers) if letter == "C" and 2 + n < len(argv)]
        i = 2 + len(takers)
    while i < len(argv):
        word, following = argv[i], argv[i + 1] if i + 1 < len(argv) else ""
        if head == "git" and not word.startswith("-"):
            break  # the verb: what follows is its own options
        if word.startswith("--") and long_named(word, longs):
            found.append(word.split("=", 1)[1] if "=" in word else following)
            i += 1 if "=" in word else 2
            continue
        cluster = (
            re.fullmatch(rf"-([a-zA-Z]*?)([{letters}])(.*)", word)
            if letters and not word.startswith("--")
            else None
        )
        if cluster:
            found.append(cluster.group(3) or following)
            i += 1 if cluster.group(3) else 2
        else:
            i += 2 if head == "git" and word in GIT_VALUE_OPTIONS else 1
    return [value for value in found if value]


def deleted_words(segment: list[str]) -> frozenset[int]:
    """The indexes of the words a segment deletes with what is under them: every word of ``rm``,
    ``rmdir``, ``unlink``, ``shred``, ``trash``, ``git rm``, ``gio trash|remove``; the start paths
    of a ``find`` with a deleting or running action (IMPLICIT_FOLDER when it names none). Removing
    a protected folder's parent removes the folder (``rm -r ~/.gemini``, behind any wrapper)."""
    argv = program_of(segment)
    at = len(segment) - len(argv)
    head = argv[0] if argv else ""
    if (
        head in DESTROYING
        or (head == "git" and "rm" in argv[1:3])
        or (head == "gio" and argv[1:2] and argv[1] in GIO_DELETING)
    ):
        return frozenset(range(at + 1, len(segment)))
    if head not in FIND_PROGRAMS or not FIND_ACTIONS & set(argv):
        return frozenset()
    if "-files0-from" in argv:
        return frozenset({FILES_FROM})
    inside = {at + i for i in find_body_indexes(argv)}
    words = {at + i for i in range(1, len(argv))} - inside
    return frozenset(words if find_starts(argv) else words | {IMPLICIT_FOLDER})


def find_starts(argv: list[str]) -> list[int]:
    """The indexes of the start paths before a ``find``'s first expression (past ``-H``, ``-L``,
    ``-P``, ``-D x``, ``-Ox`` and ``--``): with none, it searches the folder it runs in."""
    i = 1
    while i < len(argv) and (argv[i] in FIND_LEADING or argv[i] in ("-D", "--") or argv[i].startswith("-O")):
        i += 2 if argv[i] == "-D" else 1
    starts = []
    while i < len(argv) and not argv[i].startswith(("-", "(", "!", ",")):
        starts.append(i)
        i += 1
    return starts


def find_body_indexes(argv: list[str]) -> set[int]:
    """The indexes of the words an ``-exec``, ``-execdir``, ``-ok`` or ``-okdir`` runs, up to its
    ``;`` or ``+``, the terminator included."""
    found, i = set(), 0
    while i < len(argv):
        if argv[i] in FIND_ACTIONS - {"-delete"}:
            j = i + 1
            while j < len(argv) and argv[j] not in (";", "+"):
                found.add(j)
                j += 1
            found.add(j)
            i = j
        i += 1
    return found


def find_bodies(argv: list[str]) -> list[tuple[str, list[str]]]:
    """The commands a ``find`` runs on what it finds, with the action that runs each, so each is
    judged like a command of its own."""
    bodies, action, current = [], "", None
    for word in argv:
        if current is not None:
            if word in (";", "+"):
                bodies.append((action, current))
                current = None
            else:
                current.append(word)
        elif word in FIND_ACTIONS - {"-delete"}:
            action, current = word, []
    if current:
        bodies.append((action, current))
    return [(action, body) for action, body in bodies if body]


FD_PROGRAMS = frozenset({"fd", "fdfind"})  # fdfind is Debian's name for fd
FD_ACTIONS = frozenset({"-x", "--exec", "-X", "--exec-batch"})  # each takes the words after it, up to ;


FD_VALUE_SHORTS = frozenset("etdESjcoC")  # short options that take a value (fd 10): the rest is it


def fd_cluster_body(letters: str) -> list[str] | None:
    """A short-option cluster as clap reads it: ``-Hx`` starts a body with the words after it,
    ``-xbash`` with ``bash`` as its first word; ``-ex`` is the extension ``x``, not an action."""
    for i, letter in enumerate(letters):
        if letter in "xX":
            rest = letters[i + 1 :].removeprefix("=")
            return [rest] if rest else []
        if letter in FD_VALUE_SHORTS:
            return None
    return None


def fd_bodies(argv: list[str]) -> list[list[str]]:
    """The commands ``fd -x``/``-X`` runs on what it finds, judged like a command of its own (as
    ``find -exec``); fd reads every word after the action as the command, up to a ``;``."""
    bodies, current = [], None
    for word in argv[1:]:
        if current is not None:
            if word == ";":
                bodies.append(current)
                current = None
            else:
                current.append(word)
        elif word in FD_ACTIONS:
            current = []
        elif word.split("=", 1)[0] in FD_ACTIONS and "=" in word:
            current = [word.split("=", 1)[1]]  # --exec=git push: the value is the program
        elif word.startswith("-") and not word.startswith("--"):
            current = fd_cluster_body(word[1:])
    if current:
        bodies.append(current)
    return [body for body in bodies if body]


def execdir_folders(argv: list[str], here: Dirs) -> Dirs:
    """Where ``-execdir`` and ``-okdir`` run their command: the folder of each entry found, so at
    least each start path and its parent (an entry deeper down is not followed)."""
    if here is None:
        return None
    folders = set()
    for index in find_starts(argv) or [None]:
        for base in here:
            start = Path(os.path.normpath(base / os.path.expanduser(argv[index]))) if index else base
            folders.update({start, start.parent})
    return frozenset(folders)


def enters(segment: list[str]) -> bool:
    """Whether the segment is a ``cd`` or ``pushd``: its operand is a folder the next words run in."""
    argv = directory_verb(segment)
    return bool(argv) and argv[0] in ("cd", "pushd")


def relocates(segment: list[str]) -> bool:
    argv = program_of(segment)
    head = argv[0] if argv else ""
    gio = head == "gio" and bool(argv[1:2]) and argv[1] in GIO_MOVING
    return head in RELOCATING or (head == "git" and "mv" in argv[1:3]) or gio


def protected_anchors(protected: list[Rule]) -> frozenset[str]:
    """The folders holding an absolute protected pattern, and their parents below HOME: moving or
    linking one carries the protected files with it (``mv ~/.gemini/config x``)."""
    home, anchors = os.path.expanduser("~"), set()
    for rule in protected:
        pattern = os.path.expanduser(rule.pattern)
        if not os.path.isabs(pattern):
            continue
        literal = pattern[: min((pattern.find(c) for c in GLOB_CHARS if c in pattern), default=len(pattern))]
        folder = literal.rstrip("/") if literal.endswith("/") else os.path.dirname(literal)
        while folder not in (home, "/", "") and folder.startswith(home + "/"):
            anchors.add(folder.casefold())  # compared without case (F-30)
            folder = os.path.dirname(folder)
    return frozenset(anchors)


GLOB_ENTRIES_MAX = 4096  # folder entries one command's link-glob checks may read
GLOB_DEADLINE = 0.25  # seconds they may take; past either, the command asks


@dataclass
class GlobBudget:
    """What is left for one command's link-glob scans: entries and a monotonic deadline."""

    entries: int
    deadline: float

    @classmethod
    def fresh(cls) -> GlobBudget:
        return cls(GLOB_ENTRIES_MAX, time.monotonic() + GLOB_DEADLINE)

    def take(self) -> bool:
        """One more entry; False once the entries or the time are spent."""
        self.entries -= 1
        return self.entries >= 0 and time.monotonic() <= self.deadline


def glob_links(
    token: str,
    cwd: str | None,
    protected: list[Rule],
    budget: GlobBudget,
    named: Callable[[str], bool] | None = None,
) -> bool:
    """Whether a glob reaches a protected path through what it expands to: the folder before its
    first hole segment is listed (dotfiles included), and each entry that segment could match is
    read with the rest of the glob, through links and ``..``. Regular files are judged lexically
    already, so without ``named`` only links and folders are read; with it (a ``cd`` target, a
    move, a link, a deletion: the word stands for whole folders) every matching name with no hole
    left is judged as that literal name, since a glob only expands to names that exist. Past the
    budget it counts as a touch (ask)."""
    glob, _ = path_glob(os.path.expanduser(token))
    parts = os.path.join(cwd or os.getcwd(), glob).split("/")
    first = next((i for i, part in enumerate(parts) if GLOB_HOLES & set(part)), None)
    if first is None:
        return False
    folder = "/".join(parts[:first]) or "/"
    if not os.path.isdir(folder):
        return False
    rest = "/".join(parts[first + 1 :])
    try:
        with os.scandir(folder) as entries:
            for entry in entries:
                if not budget.take():
                    return True
                if not globs_meet(parts[first].casefold(), entry.name.casefold()):  # nocaseglob
                    continue
                if named is not None and not GLOB_HOLES & set(rest):
                    if named(os.path.join(entry.path, rest) if rest else entry.path):
                        return True
                    continue
                if rest and entry.is_dir() and link_reaches(entry.path, rest, protected):
                    return True
                if not rest and entry.is_symlink() and link_reaches(entry.path, "", protected):
                    return True
    except OSError:
        return False
    return False


def folder_and_patterns(rule: Rule) -> list[str]:
    """The rule's patterns (``~`` both ways), and for a folder row the folder itself."""
    patterns = rule_patterns(rule)
    return patterns + [pattern[:-2] for pattern in patterns if pattern.endswith("/*")]


def link_reaches(entry: str, rest: str, protected: list[Rule]) -> bool:
    """A matched entry, with what the glob still names under it, against the protected rows: a
    link anywhere up to the next hole, or a ``..``, is resolved first (``a*/l/config/x``,
    ``s*/../.gemini/config/x``)."""
    if not rest:
        return any(matches_file(r, file_forms(os.path.realpath(entry), None), fold=True) for r in protected)
    form = os.path.normpath(resolved_prefix(f"{entry}/{rest}")).casefold()
    return any(
        globs_meet(form, pattern.casefold()) or globs_meet(form, f"*/{pattern}".casefold())
        for r in protected
        for pattern in folder_and_patterns(r)
    )


def glob_meets_anchor(token: str, cwd: str | None, anchors: frozenset[str], relocating: bool) -> bool:
    """Whether a word with holes could name a protected folder's parent (``rm -r ~/.gem*``) or,
    for a move or a link, a customization root (``mv x .agen*``)."""
    glob, _ = path_glob(os.path.expanduser(token))
    form = os.path.normpath(os.path.join(cwd or os.getcwd(), glob)).casefold()
    if any(globs_meet(form, anchor) for anchor in anchors):
        return True
    name = os.path.basename(glob.rstrip("/")).casefold()
    literal = name.strip("*?" + SEGMENT_STAR)  # a bare ``*`` would meet every root: ``cp -r assets/* dist/``
    return relocating and bool(literal) and any(globs_meet(name, root) for root in CUSTOMIZATION_ROOTS_FOLDED)


def merges_into_an_anchor(segment: list[str], base: str, anchors: frozenset[str]) -> str | None:
    """The source of a copy or move into a folder that holds a protected folder's parent, when it
    may land on that parent: its name is the next folder down (``cp -r x/.gemini ~``), or it
    copies a folder's contents (a trailing ``/`` or ``/.``, ``-T``, a variable, a hole, find's
    ``{}``). The target is ``-t``/``--target-directory`` when given, else the last word.
    ``cp a ~`` stays silent."""
    target, sources, contents = merge_parts(program_of(segment)[1:])
    if target is None or not sources:
        return None
    folder = os.path.normpath(os.path.join(base, os.path.expanduser(home_forms(target)[-1]))).casefold()
    folder = folder.rstrip("/") + "/"
    children = {a[len(folder) :].split("/")[0] for a in anchors if a.startswith(folder)}
    if not children:
        return None
    for source in sources:
        name = os.path.basename(source.rstrip("/")).casefold()
        unknown = shell.has_sentinel(source) or "$" in source or "{}" in source
        whole = source.endswith(("/", "/.")) or source == "."
        if contents or unknown or whole or name in children:
            return source
    return None


def merge_parts(args: list[str]) -> tuple[str | None, list[str], bool]:
    """A copy or move's target, its sources, and whether it copies into the target itself
    (``-T``): ``-t DIR``, ``-tDIR``, ``--target-directory[=]DIR`` and a cluster ending in ``t``."""
    target, sources, contents, i = None, [], False, 0
    while i < len(args):
        word = args[i]
        following = args[i + 1] if i + 1 < len(args) else None
        if word.startswith("--target-directory"):
            target, i = (word.split("=", 1)[1], i + 1) if "=" in word else (following, i + 2)
            continue
        if word in ("-T", "--no-target-directory") or re.fullmatch(r"-[a-zA-Z]*T[a-zA-Z]*", word):
            contents = True
        cluster = re.fullmatch(r"-([a-zA-Z]*)t(.*)", word) if not word.startswith("--") else None
        if cluster:
            target, i = (cluster.group(2), i + 1) if cluster.group(2) else (following, i + 2)
            continue
        if not word.startswith("-"):
            sources.append(word)
        i += 1
    if target is None and len(sources) >= 2:
        target = sources.pop()
    return target, sources, contents


def holds_an_anchor(form: str, anchors: frozenset[str]) -> bool:
    """Whether a folder holds a protected folder's parent: HOME and ``/`` hold ``~/.gemini``, so
    deleting them deletes it (``rm -r ~``, ``find ~ -delete``)."""
    folder = os.path.normpath(form).casefold().rstrip("/") + "/"
    return any(anchor.startswith(folder) for anchor in anchors)


def word_touches(
    token: str,
    cwd: str | None,
    protected: list[Rule],
    relocating: bool,
    anchors: frozenset[str],
    destroying: bool = False,
    budget: GlobBudget | None = None,
    whole: bool = False,
) -> bool:
    """Whether one shell word names, or could name, a protected file. A bare word is a path in the
    working directory too, so ``tee hooks.json`` run inside ``.agents/`` is caught; a word that
    is only a substitution is not resolved, like a variable, while a bare glob reaches real files."""
    pathlike = "/" in token or token.startswith("~") or globstar(token)
    if shell.has_sentinel(token):
        bare_glob = all(shell.kind_of(key) == "glob" for key in shell.sentinels(token))
        if not (pathlike or bare_glob):
            return False
        acting = relocating or destroying or whole  # the word stands for whole folders
        if any(path_may_match(r, token, cwd, acting and not bare_glob) for r in protected):
            return True
        if not bare_glob:  # a substitution: its text is unknown, so read it lexically
            return (relocating or destroying) and glob_meets_anchor(token, cwd, anchors, relocating)
        if budget is None:
            return False

        def named(name: str) -> bool:
            return word_touches(name, cwd, protected, relocating, anchors, destroying, None, whole)

        return glob_links(token, cwd, protected, budget, named if acting else None)
    forms = file_forms(token, cwd)
    if any(matches_file(r, forms, fold=True) for r in protected):
        return True
    anchored = any(os.path.normpath(form).casefold() in anchors for form in forms)
    if destroying and (anchored or any(holds_an_anchor(form, anchors) for form in forms)):
        return True
    if not relocating:
        return False
    named_root = os.path.basename(token.rstrip("/")).casefold() in CUSTOMIZATION_ROOTS_FOLDED
    return named_root or anchored


def protected_file_touched(
    placed: list[tuple[list[str], Dirs]],
    cwd: str | None,
    rules: list[Rule],
    paths: list[str] | None = None,
    visited: Dirs = frozenset(),
) -> str | None:
    """A shell word that names, or with a hole in it could name, a file protected by a ``never``
    Edit/Write rule, or that moves or links a customization root or a protected folder. Each word
    is a path in every directory its segment may run in (``cd`` followed, F-31); ``paths`` (the
    redirection and runner targets) are checked word by word, never read as a command, in every
    directory the script visits."""
    protected = [r for r in rules if r.tool in FILE_TOOLS and r.decision == "never" and not r.agent]
    anchors = protected_anchors(protected)
    start = directories_of(Path(cwd or os.getcwd()))
    homed = home_cd_targets([segment for segment, _ in placed])
    budget = GlobBudget.fresh()
    jobs = [(segment, dirs, True) for segment, dirs in placed]
    if paths:
        jobs.append((paths, union(visited, start), False))
    for segment, dirs, command in jobs:
        program = own_tool_run(segment) if command else None
        relocating = command and relocates(segment)
        deleted = deleted_words(segment) if command else frozenset()
        entering = command and enters(segment)
        bases = sorted({str(d) for d in (dirs or start)} | homed)  # unknown: the payload cwd, and by name
        folders = folder_options(segment) if command else []
        if len(folders) > FOLDER_OPTIONS_MAX:
            return folders[-1]  # past the cap the segment asks rather than judge every folder
        origin, joined = list(bases), set()
        for folder in folders:
            for form in home_forms(folder):
                if any(
                    word_touches(form, base, protected, False, anchors, True, budget, True) for base in origin
                ):
                    return folder
            homed_folder = os.path.expanduser(home_forms(folder)[-1])
            joined.update(
                os.path.normpath(os.path.join(b, homed_folder)) for b in origin
            )  # linear, never compounded
        bases = sorted({*bases, *joined})
        moved = dirs != start  # a cd ran, or one the gate cannot follow (CDPATH may send it elsewhere)
        if FILES_FROM in deleted:
            return "-files0-from"
        merged = relocating and next(
            (found for found in (merges_into_an_anchor(segment, base, anchors) for base in bases) if found),
            None,
        )
        if merged:
            return merged
        if IMPLICIT_FOLDER in deleted and any(
            word_touches(".", base, protected, relocating, anchors, True, budget, entering) for base in bases
        ):
            return segment[0]
        for index, token in enumerate(segment):
            destroying = index in deleted
            value = token.split("=", 1)[1] if "=" in token else ""
            if value and any(
                word_touches(form, base, protected, False, anchors, False, budget)
                for form in home_forms(os.path.expanduser(value) if value.startswith("~") else value)
                for base in bases
            ):
                return token
            if token.startswith("-") or index == program:
                continue
            if DIRECTORY_STACK_RE.match(token):
                return token  # ``~-``, ``~1``: OLDPWD or the directory stack, unknown to the gate
            for form in home_forms(token):
                if PWD_TILDE_RE.match(form):
                    form = form[2:].lstrip("/") or "."  # ``~+`` is PWD: the segment's own folder
                anchored = os.path.isabs(form) or form.startswith("~")
                if any(
                    word_touches(form, base, protected, relocating, anchors, destroying, budget, entering)
                    for base in bases[: 1 if anchored else None]
                ):
                    return token
                if moved and not anchored and names_a_protected_file(form, protected, dirs is None):
                    return token
    return None


def protected_cwd(directories: list[Path], rules: list[Rule]) -> Verdict | None:
    """An ask when a command runs in a folder a ``never`` Edit/Write folder row protects: a command
    without a file word (``make clean``, ``git clean -fdx``) still writes there (F-32)."""
    rows = [
        r
        for r in rules
        if r.tool in FILE_TOOLS and r.decision == "never" and not r.agent and r.pattern.endswith("/*")
    ]
    for directory in directories:
        forms = file_forms(os.path.join(directory, "x"), None)
        found = next((r for r in rows if matches_file(r, forms, fold=True)), None)
        if found:
            note = (
                f"the working directory is inside a protected folder: {found.shown()} ({found.layer} layer)"
            )
            return Verdict(ASK, None, f"{note}: '{directory}'")  # the rule first: agy cuts long reasons
    return None


def home_cd_targets(segments: list[list[str]]) -> set[str]:
    """The folders a ``cd`` or ``pushd`` may reach that the directory walk leaves unknown: through
    ``~``, ``$HOME`` or ``${HOME}`` (read as HOME), a bare ``cd`` (HOME), and a relative operand
    under each ``CDPATH`` entry the command assigns or the hook inherits. The walk keeps them
    unknown so runners stay opaque after them; the protected check also reads every word in them,
    which can only add asks (``cd ~/.gemini && rm -r config``)."""
    cdpath = [
        entry
        for segment in segments
        for word in segment
        if word.startswith("CDPATH=")
        for entry in word[len("CDPATH=") :].split(":")
    ] + os.environ.get("CDPATH", "").split(":")
    roots = [os.path.expanduser(home_forms(e)[-1]) for e in cdpath if e and not shell.has_sentinel(e)]
    folders = set()
    for segment in segments:
        argv = directory_verb(segment)
        if not argv or argv[0] not in ("cd", "pushd"):
            continue
        operands = [w for w in argv[1:] if not w.startswith("-")]
        if not operands and argv[0] == "cd":
            folders.add(os.path.expanduser("~"))
        for word in operands:
            homed = home_forms(word)[-1]
            if shell.has_sentinel(homed):
                continue
            if homed.startswith("~"):
                folders.add(os.path.normpath(os.path.expanduser(homed)))
            elif not os.path.isabs(homed) and not homed.startswith(("./", "../")):
                folders.update(os.path.normpath(os.path.join(root, homed)) for root in roots)
    return folders


def names_a_protected_file(word: str, protected: list[Rule], unknown: bool = True) -> bool:
    """Whether a relative word's last part matches, without case, the last part of a protected
    file row (not a folder row): after a ``cd`` the gate cannot follow, ``tee settings.json`` may
    be writing ``.claude/settings.json``."""
    rows = [r for r in protected if not r.pattern.endswith("/*") and os.path.basename(r.pattern).strip("*")]
    if shell.has_sentinel(word):  # a glob only where the folder is unknown: a known one is listed
        if not unknown or not all(shell.kind_of(key) == "glob" for key in shell.sentinels(word)):
            return False
        name = os.path.basename(path_glob(word)[0].rstrip("/")).casefold()
        return any(globs_meet(name, os.path.basename(r.pattern).casefold()) for r in rows)
    name = os.path.basename(word.rstrip("/")).casefold()
    return any(fnmatch.fnmatchcase(name, os.path.basename(r.pattern).casefold()) for r in rows)


HOME_WORDS = ("$HOME", "${HOME}")
PWD_TILDE_RE = re.compile(r"^~\+(?:/|$)")  # ``~+``: bash's PWD, the folder the segment runs in
DIRECTORY_STACK_RE = re.compile(r"^~(?:-|[+-]?\d+)(?:/|$)")  # OLDPWD or a ``dirs`` entry


def home_forms(token: str) -> list[str]:
    """The word, and with a leading ``$HOME`` or ``${HOME}`` read as ``~``: the gate knows HOME's
    value, so ``tee $HOME/.gemini/config/x`` is the ``~/`` path. Both are checked, so a command
    that assigns HOME first only asks more."""
    for word in HOME_WORDS:
        if token == word or token.startswith(word + "/"):
            return [token, "~" + token[len(word) :]]
    return [token]


PYTHONS = frozenset({"python", "python3"})
PYTHON_SCRIPT_OPTIONS = frozenset({"-I", "-u", "-B", "-E", "-s", "-S", "-O", "-OO", "-q"})


def own_tool_run(segment: list[str]) -> int | None:
    """The index of the word that names the program a segment runs, when that is one of cobot's
    own ``bin/`` tools: the command word, or the script after ``python3`` and its plain options.
    Under agy the plugin lives in ``~/.gemini/config/plugins/``, a protected folder, and its
    brief runs ``python3 -I <plugin>/bin/<tool>``: running it is not writing it. Every other
    word naming the folder is still checked, so ``cp x <plugin>/bin/cobot-rules`` asks."""
    index = 0
    if segment and os.path.basename(segment[0]) in PYTHONS:
        index = 1
        while index < len(segment) and segment[index] in PYTHON_SCRIPT_OPTIONS:
            index += 1
    if index >= len(segment) or shell.has_sentinel(segment[index]):
        return None
    word = segment[index]
    if not os.path.isabs(os.path.expanduser(word)):
        return None
    folder = os.path.realpath(plugin_root() / "bin")
    return index if os.path.dirname(os.path.realpath(os.path.expanduser(word))) == folder else None


def globstar(token: str) -> bool:
    """``**`` (two ``*`` glob holes in a row): under ``globstar`` it crosses folders, ``/`` or not."""
    stars = [
        key
        for key in shell.sentinels(token)
        if shell.kind_of(key) == "glob" and shell.REGISTRY[key].span == "*"
    ]
    return any(a + b in token for a, b in itertools.pairwise(stars))


def reads_like_a_variable(token: str, key: str) -> bool:
    """A substitution stands for a whole unknown path where it leads the token (``$(pwd)/x``) or
    names its last part (``docs/$(date).md``); glued inside a folder name (``plu$(x)ins/``) or
    standing for a folder between literal ones (``.agents/$(x)/h.sh``), it does not."""
    at = token.index(key)
    return at == 0 or (token[at - 1] == "/" and "/" not in token[at + len(key) :])


def folder_named(rule: Rule, token: str) -> bool:
    """A folder row (``<dir>/*``) meets a token with a substitution through the full check unless
    every substitution reads like a variable and the token does not name the folder's last part
    with its ``/``: otherwise such a row would ask on every ``$(pwd)/README.md``. A substitution
    that hides the whole folder is read like a variable, which the gate does not resolve either. A
    glob reaches real files: it keeps the full check."""
    if not rule.pattern.endswith("/*"):
        return True
    holes = [key for key in shell.sentinels(token) if shell.kind_of(key) != "glob"]
    if not holes or not all(reads_like_a_variable(token, key) for key in holes):
        return True
    return rule.pattern[:-2].rsplit("/", 1)[-1] + "/" in token


def path_may_match(rule: Rule, token: str, cwd: str | None, whole: bool = False) -> bool:
    """Whether some text in place of the token's substitutions, or some file names for its globs,
    makes it a path the rule protects; with ``whole`` (a word a command acts on as a whole: a
    ``cd`` target, a move, a link, a deletion) also the protected folder itself."""
    if not folder_named(rule, token):
        return False
    glob, _ = path_glob(os.path.expanduser(token))
    forms = [glob] if os.path.isabs(glob) else [glob, os.path.join(cwd or os.getcwd(), glob)]
    forms += [resolved_prefix(form) for form in forms if os.path.isabs(form)]
    patterns = folder_and_patterns(rule) if whole else rule_patterns(rule)  # compared without case (F-30)
    forms, patterns = [form.casefold() for form in forms], [pattern.casefold() for pattern in patterns]
    return any(
        globs_meet(form, pattern) or globs_meet(form, f"*/{pattern}")
        for form in forms
        for pattern in patterns
    )


def resolved_prefix(glob: str) -> str:
    """The glob with the folders before its first hole resolved: ``door/*`` through a symlinked
    ``door`` reaches what ``door`` points at (F-28)."""
    hole = min((i for i, char in enumerate(glob) if char in GLOB_HOLES), default=len(glob))
    cut = glob.rfind("/", 0, hole)
    return os.path.realpath(glob[:cut]) + glob[cut:] if cut > 0 else glob


def path_glob(token: str) -> tuple[str, bool]:
    """The token as a glob for ``globs_meet``, and whether to compare without case. A substitution
    is ``*``, which crosses ``/``, and a later ``]`` widens it (its output can open a bracket the
    ``]`` closes); a glob hole is SEGMENT_STAR, which does not, except ``**`` (``globstar``). Shell
    options the command does not show may be on: a token with a glob compares without case
    (``nocaseglob``)."""
    fold = False
    for key in shell.sentinels(token):
        if shell.kind_of(key) == "glob":
            fold = True
            star = GLOBSTAR_MARK if shell.REGISTRY[key].span == "*" else SEGMENT_STAR
            token = token.replace(key, star)
        else:
            fold = fold or not shell.REGISTRY[key].quoted  # split output is globbed as well
            token = re.sub(re.escape(key) + r"(?:[^/]*\])?", "*", token)
    token = re.sub(f"{GLOBSTAR_MARK}{{2,}}", "*", token).replace(GLOBSTAR_MARK, SEGMENT_STAR)
    return token, fold


def globs_meet(left: str, right: str) -> bool:
    """Whether two globs (``*`` and literal characters; ``?`` read as ``*``; on the left also
    SEGMENT_STAR, any text without ``/``) match a common string: a walk over pairs of positions."""
    left, right = left.replace("?", "*"), right.replace("?", "*")
    seen: set[tuple[int, int]] = set()
    stack = [(0, 0)]
    while stack:
        i, j = stack.pop()
        if (i, j) in seen:
            continue
        seen.add((i, j))
        if i == len(left) and j == len(right):
            return True
        a, b = left[i : i + 1], right[j : j + 1]
        if a == "*":
            stack.extend([(i + 1, j)] + ([(i, j + 1)] if b else []))
        if a == SEGMENT_STAR:
            stack.extend([(i + 1, j)] + ([(i, j + 1)] if b and b != "/" else []))
        if b == "*":
            stack.extend([(i, j + 1)] + ([(i + 1, j)] if a else []))
        if a and b and not {a, b} & {"*", SEGMENT_STAR} and a == b:
            stack.append((i + 1, j + 1))
    return False


def ask_label(verdict: Verdict) -> str:
    """How another ask is named in a reason: its rule, or its note cut, then its ``via``: an ask
    from a runner's body says so, as the first reason does."""
    name = verdict.rule.shown() if verdict.rule else verdict.note[:ASK_NOTE_LIMIT]
    return f"{name} via {verdict.via}" if verdict.via else name


AGY_SESSION_ASK_PATTERNS = frozenset(
    {
        "git commit*",
        "git rebase*",
        "git init*",
        "docker run*",
        "podman run*",
        "cargo add*",
        "npm install *",
        "npm i *",
        "npm add*",
        "pnpm add*",
        "yarn add*",
        "bun add*",
        "go get*",
        "uv add*",
        "pip install*",
        "pip3 install*",
        "poetry add*",
        "nix flake update*",
        "nix flake lock*",
    }
)
AGY_DEV_OPAQUE_HEADS = frozenset({"make", "gmake", "just", "task", "uvx", "npx", "bunx"})
AGY_DEV_OPAQUE_SUBCOMMANDS = {
    "mise": frozenset({"run", "r"}),
    "npm": frozenset({"run", "run-script"}),
    "pnpm": frozenset({"run", "dlx"}),
    "yarn": frozenset({"run", "dlx"}),
    "bun": frozenset({"run", "x"}),
    "cargo": frozenset({"xtask"}),
    "uv": frozenset({"run"}),
}


def is_local_dev_rule(rule: Rule | None) -> bool:
    return (
        rule is not None
        and rule.decision == "ask"
        and rule.layer == "default"
        and rule.tool == "Bash"
        and rule.agent is None
        and rule.pattern in AGY_SESSION_ASK_PATTERNS
    )


def is_local_dev_opaque(plain: list[str], holes_free: bool) -> bool:
    """True when an opaque runner is a local repeatable dev task/package runner without holes."""
    if not plain or not holes_free:
        return False
    head = plain[0]
    if head in AGY_DEV_OPAQUE_HEADS:
        return True
    verb = canonical_package_manager(strip_global_options(plain)) if head in OPAQUE_SUBCOMMANDS else plain
    sub = verb[1] if len(verb) > 1 else ""
    if head in AGY_DEV_OPAQUE_SUBCOMMANDS and sub in AGY_DEV_OPAQUE_SUBCOMMANDS[head]:
        return True
    return head == "npm" and sub in NPM_SCRIPT_ALIASES


def verdict_is_session_ask(verdict: Verdict) -> bool:
    if verdict.decision != ASK:
        return False
    if verdict.session_ask is not None:
        return verdict.session_ask
    return is_local_dev_rule(verdict.rule)


def scoped(verdict: Verdict) -> bool:
    return verdict.rule is not None and verdict.rule.agent is not None


def named_asks(best: Verdict, asks: list[Verdict], agent: str | None) -> Verdict:
    """The winning ask with every other distinct ask of the command in ``also`` (F-40). For an
    agent-scoped call the agent-scoped ask leads, so a grader reading the reason sees it."""
    if best.decision != ASK:
        return best
    if agent:
        asks = sorted(asks, key=lambda verdict: not scoped(verdict))
        if asks and scoped(asks[0]) and not scoped(best):
            best = asks[0]
    named = {ask_key(best): ""}  # alike asks are one; asks alike only once cut stay apart
    for verdict in asks:
        named.setdefault(ask_key(verdict), ask_label(verdict))
        for label in verdict.also:
            named.setdefault(label, label)
    session_ok = all(verdict_is_session_ask(verdict) for verdict in (best, *asks))
    return replace(best, also=tuple(label for label in named.values() if label), session_ask=session_ok)


def ask_key(verdict: Verdict) -> tuple:
    return (verdict.rule, verdict.note if verdict.rule is None else "", verdict.via)


def outranks(new: Verdict, best: Verdict) -> bool:
    """The stricter decision wins. On a tie a rule-backed verdict replaces a ruleless one, and the
    first ruleless ask keeps its reason: it names what made the command opaque or protected."""
    if RANK[new.decision] != RANK[best.decision]:
        return RANK[new.decision] > RANK[best.decision]
    if best.rule is not None:
        return False
    return new.rule is not None or best.decision is None


# ---------------------------------------------------------------- substitutions (gate-substitution spec)

NAME_ASSIGNMENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
# builtins and keywords that can evaluate quoted text as code (array subscripts, arithmetic, PS4)
QUOTED_CODE_HEADS = frozenset(
    "printf test [ [[ (( let declare typeset local export readonly read mapfile readarray set trap "
    "unset".split()
)
# heads that evaluate a word as a name or arithmetic (``let x=*``, a file ``x=a[$(…)]``);
# printf, test and ``[`` only with ``-v``; ``[[`` and ``set`` glob or evaluate nothing
GLOB_CODE_HEADS = frozenset("let unset read mapfile readarray declare typeset local export readonly".split())
GLOB_CODE_WITH_V = frozenset({"printf", "test", "["})
# wrappers whose inner command or ``--run`` string can sit anywhere: a hole in them decides what runs
WHOLE_WRAPPERS = frozenset({"chroot", "nix-shell", "distrobox-enter"})
CAT_DEFINITION_RE = re.compile(r"(?:^|[\s;&|(){}])(?:function\s+cat\b|cat\s*\(\s*\)|alias\s+cat=)")
UNKNOWN_CHAR = "\x00"  # a hole read as one character nothing literal matches
SEGMENT_STAR = "\x01"  # a glob hole in a path: any text without ``/``
GLOBSTAR_MARK = "\x02"  # a ``*`` glob hole, until ``**`` runs are found
GLOB_HOLES = frozenset({"*", "?", SEGMENT_STAR})  # what globs_meet reads as a hole
EXPANSION_KINDS = frozenset({"glob", "brace"})  # holes a runner body may hold and stay readable
GLOB_ARGV_RUNNERS = frozenset({"docker", "podman", "docker-compose", "nix", "flatpak", "chroot"})
# ``NAME=`` or ``NAME[…]=`` (the subscript a bracket glob hole): an assignment in the prefix
ARRAY_ASSIGNMENT_RE = re.compile(f"^[A-Za-z_][A-Za-z0-9_]*({shell.SENTINEL_RE.pattern})?\\+?=")
RULE_WILDCARDS_RE = re.compile(r"[*?\[]")


def hole_keys(tokens: list[str]) -> list[str]:
    return [key for token in tokens for key in shell.sentinels(token)]


def show(text: str, holes: dict[str, shell.Hole]) -> str:
    """Text with each sentinel put back as the substitution it stands for."""
    for key in shell.sentinels(text):
        text = text.replace(key, holes[key].span if key in holes else "$(…)")
    return text


def literal_prefix(text: str, stop: re.Pattern) -> str:
    return stop.split(text, maxsplit=1)[0]


def viable(rule: Rule, form: str) -> bool:
    """Whether some text in place of the form's holes could make the rule match it: exact on a form
    without a hole; on one with a hole, the literal prefixes of rule and form must be compatible
    (a sound over-approximation of glob intersection)."""
    if not shell.has_sentinel(form):
        return fnmatch.fnmatchcase(form, rule.pattern)
    rule_head = literal_prefix(rule.pattern, RULE_WILDCARDS_RE)
    form_head = literal_prefix(form, shell.SENTINEL_RE)
    return rule_head.startswith(form_head) or form_head.startswith(rule_head)


def covers(rule: Rule, form: str) -> bool:
    """Whether an allow matches the form whatever its holes hold: ``<literal>*`` whose literal is a
    prefix of the form's text before its first hole, or an exact match on a form without one."""
    if not shell.has_sentinel(form):
        return fnmatch.fnmatchcase(form, rule.pattern)
    head = rule.pattern[:-1]
    exact_prefix = rule.pattern.endswith("*") and not RULE_WILDCARDS_RE.search(head)
    return exact_prefix and literal_prefix(form, shell.SENTINEL_RE).startswith(head)


def whole_segment_is_zone(plain: list[str]) -> bool:
    """A head whose arguments an expander, an interpreter or a canonicaliser reads anywhere, decided
    by name; or a segment that is opaque with its verb as written (``docker exec``, ``npm test``)."""
    head = plain[0]
    if any(head in group for group in (SHELLS, OPAQUE, INTERPRETERS, MAKE_NAMES, WHOLE_WRAPPERS)):
        return True
    if is_opaque(plain):
        return True
    verb = strip_global_options(plain)
    return head in API_CLIS and verb[1:2] == ["api"]


def verb_zone(plain: list[str], holes: dict[str, shell.Hole]) -> list[str]:
    """The tokens that decide which rule rows can match: the command word, global options and the
    verb (group and verb for alias CLIs and entry wrappers; through the first verb for ``gcloud``).
    A quoted hole that is the value of a global option taking one is one word and stays out."""
    head = plain[0]
    verb = strip_global_options(plain)
    options = plain[1 : len(plain) - len(verb) + 1]
    with_value = GLOBAL_OPTIONS.get(head, (frozenset(), frozenset()))[0]
    zone = [head] + [
        token
        for index, token in enumerate(options)
        if not (index and options[index - 1] in with_value and is_quoted_hole(token, holes))
    ]
    if head == "gcloud":
        cut = canonical_gcloud(verb)
        return zone + (cut[1:] if cut != verb else verb[1:])
    if head in CLI_ALIASES or head in WRAPPER_PARSERS:  # group and verb: ``docker compose exec``
        return zone + verb[1:3]
    return zone + verb[1:2] if head in GLOBAL_OPTIONS or head in OPAQUE_SUBCOMMANDS else zone


def is_quoted_hole(token: str, holes: dict[str, shell.Hole]) -> bool:
    """A token that is exactly one quoted substitution: one word, whatever it holds."""
    return shell.SENTINEL_RE.fullmatch(token) is not None and token in holes and holes[token].quoted


def prefix_key(segment: list[str], plain: list[str]) -> str | None:
    """The first hole in a token ``strip_wrappers`` consumed, except the value of a literal
    ``NAME=`` assignment before the first wrapper (it only sets a variable)."""
    in_prefix = True
    for token in segment[: len(segment) - len(plain)]:
        keys = shell.sentinels(token)
        if token in RESERVED_HEADS:
            continue
        if in_prefix and is_assignment(token):
            continue
        in_prefix = False
        if keys:
            return keys[0]
    return None


def is_assignment(token: str) -> bool:
    """``NAME=…`` or ``NAME[…]=…`` with a literal name: bash sets a variable and globs nothing, so
    the value's holes and a bracket glob in the subscript decide nothing."""
    match = ARRAY_ASSIGNMENT_RE.match(token)
    if match is None:
        return False
    subscript = match.group(1)
    return subscript is None or (
        shell.kind_of(subscript) == "glob" and shell.REGISTRY[subscript].span.startswith("[")
    )


def all_glob(tokens: list[str]) -> bool:
    return all(shell.kind_of(key) == "glob" for key in hole_keys(tokens))


def anchored(token: str) -> bool:
    """A token whose glob words all start with its literal text before the first hole, and that
    text is not an option name or a parameter: ``src/*``, ``./*.py``, ``--include=*.py``."""
    head = literal_prefix(token, shell.SENTINEL_RE)
    return bool(head) and (head[0] not in "-$" or (head[0] == "-" and "=" in head))


def anchored_glob(token: str) -> bool:
    return shell.has_sentinel(token) and all_glob([token]) and anchored(token)


def hole_noun(key: str) -> str:
    return "glob" if shell.kind_of(key) == "glob" else "substitution"


def holes_only_in_assignments(segment: list[str], plain: list[str]) -> bool:
    """Every hole of the segment sits in a leading assignment's value: the command it runs is
    literal and is judged, and expanded, as one without a substitution."""
    return not hole_keys(plain) and prefix_key(segment, plain) is None


def structural_key(segment: list[str], plain: list[str], holes: dict[str, shell.Hole]) -> str | None:
    """The first hole that could decide what runs: in the wrapper prefix (``prefix_key``), in the
    verb zone, or anywhere in a segment whose head reads its arguments as code or structure."""
    key = prefix_key(segment, plain)
    if key:
        return key
    evaluates = plain[0] in GLOB_CODE_HEADS or (plain[0] in GLOB_CODE_WITH_V and "-v" in plain)
    globbed = [k for k in hole_keys(plain) if shell.kind_of(k) == "glob"]
    if evaluates and globbed:  # a file name becomes code: ``a[$(…)]``
        return globbed[0]
    zone = plain if whole_segment_is_zone(plain) else verb_zone(plain, holes)
    if plain[0] in API_CLIS and strip_global_options(plain)[1:2] == ["api"]:
        # file names, never a flag; ``-X=D*`` names its flag, so its glob picks the method
        zone = [token for token in zone if not (anchored_glob(token) and not token.startswith("-"))]
    keys = hole_keys(zone)
    return keys[0] if keys else None


def quoted_code(segment: list[str], inert: bool) -> str | None:
    """Quoted ``$(…)`` or backtick text bash may still run: in an assignment, or under a builtin
    that evaluates its arguments (``x='a[$(…)]'; echo $((x))``, ``printf -v 'a[$(…)]'``)."""

    def holds_code(token: str) -> bool:
        return "$(" in token or "`" in token

    plain = strip_wrappers(segment)
    assignments = segment[: len(segment) - len(plain)]
    if any(NAME_ASSIGNMENT_RE.match(t) and holds_code(t) for t in assignments):
        return next(t for t in assignments if holds_code(t))
    if plain and plain[0] in QUOTED_CODE_HEADS:
        if inert:
            return plain[0]
        return next((t for t in plain[1:] if holds_code(t)), None)
    return None


def judge_words(
    segment: list[str],
    bash_rules: list[Rule],
    holes: dict,
    agent_allows: bool = True,
    refused: str | None = None,
) -> tuple[Verdict, list[Rule]]:
    """A segment without a hole in the command it runs, judged as before the scanner; agent-scoped
    allows are left out when it executes foreign code or holds a substitution (``agent_allows``),
    or when it, or the whole command (``refused``), writes a file or runs a program."""
    forms = candidates(segment)
    refused = refused or guarded(strip_wrappers(segment))
    foreign = executes_foreign(segment) or not agent_allows or bool(refused)
    agent_allow = [r for r in bash_rules if r.decision == "allow" and r.agent and matches_bash(r, forms)]
    matched = [r for r in bash_rules if matches_bash(r, forms) and not (foreign and r in agent_allow)]
    verdict = resolve(matched, "no rule matched")
    if verdict.decision == DENY:
        verdict = never_through_option_value(verdict, matched, segment, forms)
    if refused and agent_allow and verdict.decision == ASK:
        verdict = Verdict(ASK, None, refused)
    plain = strip_wrappers(segment)
    if is_opaque(plain) and verdict.decision != DENY:
        allowed = any(allow_counts(r) for r in matched)
        prior_ok = verdict.decision is None or is_local_dev_rule(verdict.rule)
        local_ok = prior_ok and is_local_dev_opaque(plain, agent_allows and not hole_keys(plain))
        verdict = (
            verdict
            if allowed
            else Verdict(ASK, None, f"opaque command '{show(forms[0], holes)[:60]}'", session_ask=local_ok)
        )
    return verdict, matched


def never_anyway(forms: list[str], bash_rules: list[Rule]) -> list[Rule]:
    """``never`` rows that match with each hole read as one unknown character."""
    unknown = [shell.SENTINEL_RE.sub(UNKNOWN_CHAR, form) for form in forms]
    return [
        r
        for r in bash_rules
        if r.decision == "never" and any(fnmatch.fnmatchcase(f, r.pattern) for f in unknown)
    ]


def could_match(
    decision: str, forms: list[str], bash_rules: list[Rule], hole: str
) -> tuple[Verdict, list[Rule]] | None:
    """An ask naming the first ``decision`` row some text in the holes could make match; ``hole``
    names the first hole (``substitution '$(x)'``, ``glob '*'``)."""
    found = [r for r in bash_rules if r.decision == decision and any(viable(r, f) for f in forms)]
    if not found:
        return None
    note = f"{hole} could match {found[0].shown()} ({found[0].layer} layer)"
    return Verdict(ASK, None, note), found


def agent_globs(segment: list[str], plain: list[str], refused: str | None = None) -> str:
    """How an agent-scoped allow meets the segment's holes: ``counts`` when every hole is an
    anchored glob and nothing executes foreign code, writes or runs; ``anchor`` when only
    unanchored globs stop it; ``never`` otherwise (a substitution could hold any option)."""
    if not all_glob(segment) or executes_foreign(segment) or refused or guarded(plain):
        return "never"
    globbed = [token for token in plain if shell.has_sentinel(token)]
    return "counts" if all(anchored(token) for token in globbed) else "anchor"


def judge_holed(
    segment: list[str], bash_rules: list[Rule], holes: dict, refused: str | None = None
) -> tuple[Verdict, list[Rule]]:
    """A segment with a hole: never matching anyway → deny; structural → ask; never viable → ask;
    an owner allow covering every value → silence; ask viable → ask; else silence."""
    plain = strip_wrappers(segment)
    if not plain:  # ``for x in $(…)``: data
        return judge_words(segment, bash_rules, holes, refused=refused)
    forms = candidates(segment)
    nevers = never_anyway(forms, bash_rules)
    if nevers:
        return Verdict(DENY, nevers[0]), nevers
    key = structural_key(segment, plain, holes)
    if key:
        return Verdict(ASK, None, f"{hole_noun(key)} '{holes[key].span}' decides what runs"), []
    if not hole_keys(plain):  # ``x=$(…) bash -c '…'``: the command is literal
        return judge_words(segment, bash_rules, holes, agent_allows=all_glob(segment), refused=refused)
    tested = forms[-1:] if plain[0] == "gcloud" else forms
    first = hole_keys(plain)[0]
    hole = f"{hole_noun(first)} '{holes[first].span}'"
    never = could_match("never", tested, bash_rules, hole)
    if never:
        return never
    agents = agent_globs(segment, plain, refused)
    covering = [
        r
        for r in bash_rules
        if allow_counts(r) and (not r.agent or agents == "counts") and covers(r, forms[-1])
    ]
    if covering:
        return Verdict(None, None, "allow rule"), covering
    if agents == "anchor" and any(allow_counts(r) and r.agent and covers(r, forms[-1]) for r in bash_rules):
        token = show(next(t for t in plain if shell.has_sentinel(t) and not anchored(t)), holes)
        note = f"glob '{token[:40]}' could expand to an option; anchor it: ./{token[:40]}"
        return Verdict(ASK, None, note), []
    return could_match("ask", tested, bash_rules, hole) or (Verdict(None, None, "no rule matched"), [])


def known_values(segment: list[str], holes: dict) -> list[str] | None:
    """The segment with each quoted known-value hole replaced by its text; None when there is none."""
    valued = []
    changed = False
    for token in segment:
        for key in shell.sentinels(token):
            hole = holes.get(key)
            if hole and hole.quoted and hole.value is not None:
                token, changed = token.replace(key, hole.value), True
        valued.append(token)
    return valued if changed else None


def program_folded(segment: list[str]) -> list[str] | None:
    """The segment with its program word, and each wrapper's before it, in lower case; None when
    nothing changes. A case-insensitive volume (macOS) runs ``GIT`` as ``git``; the arguments keep
    their case (``--FORCE`` is not ``--force``). Judged beside the segment, so it only adds an
    ask or a deny: ``outranks`` keeps the stricter (F-30)."""
    folded, changed = list(segment), False
    for _ in segment:
        program = strip_wrappers(folded)
        if not program or program[0] == program[0].lower():
            break
        at = len(folded) - len(program)
        folded[at], changed = folded[at].lower(), True
    return folded if changed else None


def judge_segment(
    segment: list[str],
    unit: shell.Scan,
    bash_rules: list[Rule],
    holes: dict,
    with_values: bool,
    refused: str | None = None,
) -> tuple[Verdict, list[Rule]]:
    """Judge the segment, and again with known values put in (stricter wins); quoted code asks."""
    variants = [segment]
    valued = known_values(segment, holes) if with_values else None
    if valued is not None:
        variants.append(valued)
    variants += [folded for folded in map(program_folded, variants) if folded is not None]
    best: tuple[Verdict, list[Rule]] = (Verdict(None, None, "no rule matched"), [])
    for variant in variants:
        judge = judge_holed if hole_keys(variant) else judge_words
        verdict, matched = judge(variant, bash_rules, holes, refused=refused)
        code = quoted_code(variant, unit.inert_code)
        if code and verdict.decision != DENY:
            verdict = Verdict(ASK, None, f"quoted code '{show(code, holes)[:60]}' may run")
        if outranks(verdict, best[0]):
            best = (verdict, matched)
    return best


WRITING_SCRIPT = "a script that writes files: edit them with Edit or Write, not a script (cobot protocol)"
PYTHON_RE = re.compile(r"python(?:\d+(?:\.\d+)?)?")
# what a Python script calls to write a file: open() or .open() with a writing mode, the pathlib
# writers, and the moves and copies of os and shutil
PYTHON_WRITES_RE = re.compile(
    r"\bopen\([^,)]*,\s*(?:mode\s*=\s*)?[rbt]*['\"][rbt]*[wax+]"
    r"|\.open\(\s*(?:mode\s*=\s*)?['\"][rbt]*[wax+]"
    r"|\.write_(?:text|bytes)\("
    r"|\bshutil\.(?:copy\w*|move)\("
    r"|\bos\.(?:replace|rename)\("
)


def writes_by_script(segment: list[str], unit: shell.Scan, holes: dict) -> bool:
    """Whether a segment edits files through an interpreter: a Python script read from stdin or
    ``-c`` whose code writes a file, or ``perl -i``. The protocol asks for Edit or Write, whose
    diff the owner sees and whose path the rules judge; a script is opaque to both, whatever the
    host suggests. A script that only reads keeps its ask."""
    argv = strip_wrappers(segment)
    if not argv:
        return False
    head = argv[0].lower()
    if head == "perl":
        return any(re.fullmatch(r"-[a-zA-Z]*i\S*", word) for word in argv[1:] if not word.startswith("--"))
    if not PYTHON_RE.fullmatch(head):
        return False
    words = argv[1:]
    code = [show(words[words.index("-c") + 1], holes)] if "-c" in words[:-1] else []
    reads_stdin = "-" in words or not [w for w in words if not w.startswith("-")]
    if reads_stdin and not code:
        code = [doc.body for doc in unit.heredocs]
    return any(PYTHON_WRITES_RE.search(text) for text in code)


# ---------------------------------------------------------------- shell writes (gate-f36-f40-f44, story 6)

SHELL_WRITE_EXEMPT = SAFE_WRITE_TARGETS | {"/dev/tty"}
PASS_THROUGH = frozenset(
    "cat tee dd sponge tr sed base64 xxd head tail sort uniq cut envsubst cp install".split()
)
PATCHERS = (["patch"], ["git", "apply"], ["ed"], ["ex"])
SHELL_RUNNERS = frozenset({"bash", "sh", "zsh", "dash", "ksh", "su"})
CODE_OPTIONS = {"nix-shell": ("--run", "--command")}  # runners whose option holds a code string
OPENERS = frozenset({"{", "("})
LEADING_WORDS = frozenset({"{", "(", "do", "then", "else", "elif", "if", "while", "until", "!", "time"})
EXPANSION_ONLY_RE = re.compile(
    r"(?:\$(?:\{[^}]*\}|[A-Za-z_][A-Za-z0-9_]*|[0-9?#@*$!-])|" + shell.SENTINEL_RE.pattern + r")+"
)
HERE_OPERATORS = frozenset({"<<", "<<-", "<<<"})
SHELL_WRITE_ASK = "text written into a file through the shell, or a write the gate cannot trace"
MAX_SHELL_WRITE_DEPTH = 4


def edits_in_place(segment: list[str]) -> bool:
    """``sed -i``, ``awk -i inplace``, ``ruby -i`` and ``yq -i``: an editor writing its file."""
    argv = strip_wrappers(segment)
    if not argv:
        return False
    head, words = argv[0].lower(), argv[1:]
    shorts = [word[1:] for word in words if word.startswith("-") and not word.startswith("--")]
    if head in ("sed", "gsed"):
        return any(word.startswith("--in-place") for word in words) or any("i" in s for s in shorts)
    if head in ("awk", "gawk"):
        pairs = itertools.pairwise([*words, ""])
        return any(
            w == "--include=inplace" or (w in ("-i", "--include") and v == "inplace") for w, v in pairs
        )
    if head == "ruby":  # -i after flags that take no value: -pi, -ni, -i.bak
        return any(re.match(r"[acdlnpsvwyU]*i", s) for s in shorts)
    if head == "yq":
        return "--inplace" in words or any(s.startswith("i") or s.endswith("i") for s in shorts)
    return False


def stage_words(scan: shell.Scan, stage: shell.Stage) -> tuple[list[str], list[str]]:
    """The stage's raw words (openers kept) and its program argv: wrappers and reserved words off,
    and a ``case`` pattern (``a)``) dropped, so ``case a in a) echo x`` is ``echo x``."""
    items = shell_items(scan.outer[stage.start : stage.end]) if stage.end > stage.start else []
    raw = [word for item in items for word in (item if isinstance(item, list) else [item])]
    if ")" in items and "(" not in items[: items.index(")")]:
        items = items[len(items) - items[::-1].index(")") :]
    words = [word for item in items if isinstance(item, list) for word in item if word not in ("{", "}")]
    return raw, strip_wrappers(words)


def lead(raw: list[str]) -> list[str]:
    """The raw words past the openers and reserved words that start a compound's body."""
    at = 0
    while at < len(raw) and raw[at] in LEADING_WORDS:
        at += 1
    return raw[at:]


def literal_word(word: str, scan: shell.Scan) -> bool:
    """Text the agent wrote: anything but expansions, or an expansion of text the command holds
    (a substitution printing a literal, a variable it assigns)."""
    plain = word.strip("'\"")
    if not EXPANSION_ONLY_RE.fullmatch(plain):
        return True
    holes = [scan.holes[key] for key in shell.sentinels(plain) if key in scan.holes]
    if any(hole.body is not None and holds_literal(hole.body) for hole in holes):
        return True
    names = re.findall(r"\$\{?([A-Za-z_][A-Za-z0-9_]*)", plain)
    return any(re.search(rf"(?:^|[\s;&|(]){name}=", scan.outer) for name in names)


def literal_program(plain: list[str], scan: shell.Scan | None = None) -> bool:
    """``echo``, ``printf``, ``jq -n`` and ``awk 'BEGIN{…}'``: a stage whose output is its own text.
    An ``echo`` or ``printf`` of expansions alone (``echo "$(git rev-parse HEAD)"``) is output."""
    if not plain:
        return False
    head, args = plain[0], [word for word in plain[1:] if not word.startswith("-")]
    if head in ("echo", "printf"):
        return scan is None or any(literal_word(word, scan) for word in args)
    if head == "jq":
        shorts = [w for w in plain[1:] if w.startswith("-") and not w.startswith("--")]
        return any("n" in w for w in shorts) or "--null-input" in plain
    return head in ("awk", "gawk", "mawk") and len(args) == 1 and args[0].lstrip().startswith("BEGIN")


def writer_targets(plain: list[str], scan: shell.Scan | None = None) -> list[str]:
    """Files a pass-through writer writes from its input: ``tee`` operands, ``dd of=``, ``sponge``,
    ``sort -o`` (in a cluster, or ``--output``), and ``cp``/``install`` from standard input or a
    process substitution holding text."""
    if not plain:
        return []
    head, args = plain[0], plain[1:]
    operands = [word for word in args if not word.startswith("-")]
    if head == "tee":
        return [word for word in operands if word != "-"]
    if head == "dd":
        return [word[3:] for word in args if word.startswith("of=")]
    if head == "sponge":
        return operands[:1]
    if head == "sort":
        found = []
        for word, following in itertools.pairwise([*args, ""]):
            if word.startswith("--output"):
                found.append(word.partition("=")[2] or following)
            elif word.startswith("-") and not word.startswith("--") and "o" in word:
                found.append(word[word.index("o") + 1 :] or following)
        return found
    stdin = {"/dev/stdin", "-", "/dev/fd/0", "/proc/self/fd/0"}
    fed = scan is not None and any(holds_text(word, scan) for word in operands[:-1])
    if head in ("cp", "install") and (set(operands) & stdin or fed):
        return operands[-1:]
    return []


def holds_text(word: str, scan: shell.Scan) -> bool:
    """A word that is a process substitution whose body holds literal text."""
    holes = [scan.holes[key] for key in shell.sentinels(word) if key in scan.holes]
    return any(hole.body is not None and holds_literal(hole.body) for hole in holes)


def written_by_stage(
    redirects: list[shell.Redirect], plain: list[str], scan: shell.Scan | None = None
) -> list[str]:
    """Files the stage's standard output reaches, its redirections read in order with an fd table
    (``2>f >&2`` and ``3>f >&3`` reach ``f``; ``/dev/stderr`` is wherever fd 2 points), or a
    writer's own operands. A device path is exempt only where it still reaches the terminal."""
    fds: dict[int, str | None] = {1: None, 2: None}  # None: the terminal, inherited
    for r in redirects:
        if r.operator not in shell.WRITING_OPERATORS:
            continue
        if r.operator.startswith("&>"):
            fds[1] = fds[2] = device_target(r.target, fds)
            continue
        fd = int(r.fd) if r.fd.isdigit() else 1 if r.fd == "" else None
        if fd is None:
            continue
        if r.operator == ">&" and shell.FD_WORD_RE.match(r.target):
            source = r.target.rstrip("-")
            fds[fd] = fds.get(int(source), f"/dev/fd/{source}") if source.isdigit() else None
            continue
        fds[fd] = device_target(r.target, fds)
    written = [fds[1]] if fds[1] is not None else []
    return written + [t for t in writer_targets(plain, scan) if device_target(t, fds) is not None]


def device_target(target: str, fds: dict[int, str | None]) -> str | None:
    """The file a redirection target reaches: None for the terminal or /dev/null, a /dev/fd/N or
    /dev/std* path read through the fd table, any other path (a hole included) itself."""
    path = os.path.normpath(target)
    aliases = {"/dev/stdout": 1, "/dev/stderr": 2}
    number = aliases.get(path) or (int(path[8:]) if re.fullmatch(r"/dev/fd/\d+", path) else None)
    if number is not None:
        return fds[number] if number in fds else target
    return None if path in SHELL_WRITE_EXEMPT else target


def shell_write(scan: shell.Scan, depth: int = 0) -> tuple[str | None, list[list[str]]]:
    """DENY when literal text reaches a file through pass-through stages, ASK when a write may carry
    it but the gate cannot trace that, else None; with every argv an owner allow must lift."""
    found: list[tuple[str | None, list[list[str]]]] = [pipeline_writes(scan)]
    for hole in scan.holes.values():
        if hole.body is not None and depth < MAX_SHELL_WRITE_DEPTH:
            found.append(shell_write(hole.body, depth + 1))
    for stage in scan.stages:
        body = shell_body(stage_words(scan, stage)[1])
        if body is not None and depth < MAX_SHELL_WRITE_DEPTH:
            inner = shell.scan(body, frozenset(shell.sentinels(body)))
            found.append(shell_write(inner, depth + 1) if not inner.error else (ASK, [[]]))
    denied = [argvs for verdict, argvs in found if verdict == DENY]
    if denied:
        return DENY, denied[0]
    asked = [argv for verdict, argvs in found if verdict == ASK for argv in argvs]
    return (ASK, asked) if asked else (None, [])


def shell_body(plain: list[str]) -> str | None:
    """The code string of ``bash -c '…'``, ``bash -lc``, ``bash -c -e '…'``, a shell behind a
    runner (``distrobox enter b -- sh -c``), ``su -c`` or ``nix-shell --run``."""
    for at, word in enumerate(plain):
        name = os.path.basename(word)
        if name in CODE_OPTIONS:
            following = plain[at + 1 :]
            for option, value in itertools.pairwise([*following, ""]):
                if option.split("=", 1)[0] in CODE_OPTIONS[name]:
                    return option.partition("=")[2] or value
        if name not in SHELL_RUNNERS:
            continue
        rest = plain[at + 1 :]
        clusters = [
            i for i, w in enumerate(rest) if w.startswith("-") and not w.startswith("--") and "c" in w
        ]
        if clusters:
            words = [w for w in rest[clusters[0] + 1 :] if not w.startswith("-")]
            return words[0] if words else None
    return None


def holds_literal(scan: shell.Scan) -> bool:
    return (
        any(here_literal(r, scan) for r in scan.redirects)
        or any(literal_program(stage_words(scan, stage)[1], scan) for stage in scan.stages)
        or any(hole.body is not None and holds_literal(hole.body) for hole in scan.holes.values())
    )


def here_literal(redirect: shell.Redirect, scan: shell.Scan) -> bool:
    """A here-document, or a here-string of written text (not ``<<<"$(git log)"`` alone)."""
    if redirect.operator not in HERE_OPERATORS:
        return False
    return redirect.operator != "<<<" or literal_word(redirect.target, scan)


def pipeline_writes(scan: shell.Scan) -> tuple[str | None, list[list[str]]]:
    """The verdict for one scanned text, from its stages and redirections."""
    if not holds_literal(scan):
        return None, []
    stages = {(s.item, s.index): (s, *stage_words(scan, s)) for s in scan.stages}
    redirects: dict[tuple[int, int], list[shell.Redirect]] = {}
    for r in scan.redirects:
        redirects.setdefault((r.item, r.index), []).append(r)
    asks: list[list[str]] = []
    functions = {
        raw[1] if raw[0] == "function" else raw[0]
        for _, raw, _ in stages.values()
        if len(raw) > 1 and (raw[1].startswith("(") or raw[0] == "function")
    }
    any_write = any(
        written_by_stage(redirects.get(key, []), plain, scan) for key, (_, _, plain) in stages.items()
    )
    for key, (_, raw, plain) in sorted(stages.items()):
        own = redirects.get(key, [])
        if written_by_stage([r for r in own if r.after_closer], []):
            asks.append(plain or raw)
        if lead(raw)[:1] == ["exec"] and any(r.operator in shell.WRITING_OPERATORS for r in own):
            asks.append(raw)
        if functions and any_write:
            asks.append(plain or raw)
    for item in sorted({item for item, _ in stages}):
        verdict, argv = item_writes(item, stages, redirects, scan, functions, any_write)
        if verdict == DENY:
            return DENY, [argv]
        if verdict == ASK:
            asks.append(argv)
    return (ASK, asks) if asks else (None, [])


def stage_source(scan: shell.Scan, raw: list[str], plain: list[str], own: list[shell.Redirect]) -> str | None:
    """``emits`` for a stage printing literal text, ``fed`` for one reading it, ``compound`` for
    a group or loop's output (``{ …; echo x; } | tee f``), else None."""
    if literal_program(plain, scan):
        return "emits"
    if any(here_literal(r, scan) for r in own):
        return "fed"
    if raw[:1] and raw[0] in shell.CLOSERS:
        return "compound"
    words = [*plain, *(r.target for r in own)]
    return "fed" if any(holds_text(word, scan) for word in words) else None


def item_writes(item, stages, redirects, scan, functions, any_write) -> tuple[str | None, list[str]]:
    """One pipeline: deny when its literal source reaches a file through pass-through stages."""
    pipeline = [stages[key] for key in sorted(stages) if key[0] == item]
    for at, (stage, raw, plain) in enumerate(pipeline):
        source = stage_source(scan, raw, plain, redirects.get((item, stage.index), []))
        if source is None:
            continue
        clean = source == "emits" or (source == "fed" and bool(plain[:1] and plain[0] in PASS_THROUGH))
        for later_stage, later_raw, later in pipeline[at:]:
            if any(later[: len(p)] == p for p in PATCHERS):
                return DENY, later
            downstream = later_stage.index != stage.index
            if downstream:
                clean = clean and bool(later) and later[0] in PASS_THROUGH
            own = [r for r in redirects.get((item, later_stage.index), []) if not r.after_closer]
            if written_by_stage(own, later, scan):
                return (DENY if clean else ASK), later
            nested = bool(later_raw[:1]) and later_raw[0] in OPENERS
            called = bool(later) and (later[0] in functions or runner_writes(later))
            if called or (downstream and nested and any_write):
                return ASK, later
        return None, []
    return None, []


def runner_writes(plain: list[str]) -> bool:
    """A ``bash -c`` body that writes a file (a redirection or a named writer), or one the
    scanner cannot read."""
    body = shell_body(plain)
    if body is None:
        return False
    inner = shell.scan(body, frozenset(shell.sentinels(body)))
    if inner.error:
        return True
    redirects: dict[tuple[int, int], list[shell.Redirect]] = {}
    for r in inner.redirects:
        redirects.setdefault((r.item, r.index), []).append(r)
    return any(
        written_by_stage(redirects.get((s.item, s.index), []), stage_words(inner, s)[1], inner)
        for s in inner.stages
    )


def judge_bash(
    command: str, rules: list[Rule], agent: str | None, cwd: str | None = None
) -> tuple[Verdict, list[tuple[str, list[Rule]]]]:
    """Judge every segment of the command and of every substitution body; the most restrictive
    verdict wins. Also return the trace."""
    bash_rules = [r for r in rules if applies(r, "Bash", agent)]
    scanned = shell.scan(command)
    if scanned.error:
        return Verdict(ASK, None, f"unparseable command ({scanned.error})"), [(command[:60], [])]
    holes = shell.REGISTRY  # every hole of the command, its bodies and its runners' inner commands
    with_values = not CAT_DEFINITION_RE.search(command)
    reached = Reached()
    entries: list[tuple[list[str], str, shell.Scan, Dirs]] = []
    start = directories_of(Path(cwd or os.getcwd()))
    expand_units(scanned, "", start, shell_state(command), reached, entries)
    best = Verdict(None, None, "no rule matched")
    placed = [(segment, dirs) for segment, _, _, dirs in entries]
    homed = {Path(folder) for folder in home_cd_targets([segment for segment, _ in placed])}
    directories = sorted({d for _, dirs in placed for d in (dirs or ())} | set(start or ()) | homed)
    touched = protected_file_touched(placed, cwd, rules, reached.paths, reached.visited)
    in_protected = protected_cwd(directories, rules)
    if in_protected:
        best = in_protected
    elif touched:
        best = Verdict(ASK, None, f"shell access to a protected file '{show(touched, holes)[:60]}'")
    asks = [best] if best.decision == ASK else []
    trace: list[tuple[str, list[Rule]]] = []
    refused = written_file(reached)
    config = RepositoryConfig(Path(cwd or os.getcwd()).resolve()) if agent else None
    for segment, origin, unit, _ in entries:
        own = refused or (config and repository_config(strip_wrappers(segment), origin, config))
        verdict, matched = judge_segment(segment, unit, bash_rules, holes, with_values, own or None)
        if writes_by_script(segment, unit, holes) or edits_in_place(segment):
            verdict = Verdict(DENY, None, WRITING_SCRIPT)
        if origin:
            verdict = replace(verdict, via=origin[:MAX_ORIGIN])
        form = show(" ".join(strip_wrappers(segment)), holes)
        trace.append((form + (f"  <- {origin[:MAX_ORIGIN]}" if origin else ""), matched))
        if verdict.decision == ASK:
            asks.append(verdict)
        if outranks(verdict, best):
            best = verdict
    written = shell_write_verdict(scanned, bash_rules)
    if written.decision == ASK:
        asks.append(written)
    if outranks(written, best):
        best = written
    return named_asks(best, asks, agent), trace


def shell_write_verdict(scanned: shell.Scan, bash_rules: list[Rule]) -> Verdict:
    """Story 6's verdict for the whole command: a deny with the Edit/Write reason, or an ask an
    owner allow on the writing stage lifts, as it would a default-layer ask row."""
    decision, argvs = shell_write(scanned)
    if decision == DENY:
        return Verdict(DENY, None, WRITING_SCRIPT)
    owner = [r for r in bash_rules if r.decision == "allow" and r.layer == "owner"]
    lifted = all(argv and any(matches_bash(r, candidates(argv)) for r in owner) for argv in argvs)
    if decision == ASK and not lifted:
        return Verdict(ASK, None, SHELL_WRITE_ASK)
    return Verdict(None, None, "no rule matched")


def file_forms(path: str, cwd: str | None) -> list[str]:
    """Every form a rule may name the path by (F-28): as written (``~`` expanded to HOME as given),
    with its parent resolved (a symlinked folder) and fully resolved (a symlinked file), each also
    relative to the working directory. A rule that matches any form matches the path."""
    base = cwd or os.getcwd()
    joined = os.path.join(base, os.path.expanduser(path))
    parent = os.path.join(os.path.realpath(os.path.dirname(joined)), os.path.basename(joined))
    absolutes = [os.path.normpath(joined), os.path.normpath(parent), os.path.realpath(joined)]
    bases = {Path(base), Path(os.path.realpath(base))}
    relatives = [
        str(Path(form).relative_to(root))
        for form in absolutes
        for root in bases
        if Path(form).is_relative_to(root)
    ]
    return list(dict.fromkeys(absolutes + relatives))


def rule_patterns(rule: Rule) -> list[str]:
    """The rule's pattern with ``~`` expanded to HOME as given, and to HOME resolved when HOME is a
    symlink: a path written through either names the same file (F-28)."""
    pattern = os.path.expanduser(rule.pattern)
    if rule.pattern != "~" and not rule.pattern.startswith("~/"):
        return [pattern]
    return list(dict.fromkeys([pattern, os.path.realpath(os.path.expanduser("~")) + rule.pattern[1:]]))


def matches_file(rule: Rule, forms: list[str], fold: bool = False) -> bool:
    """A form matches the pattern, at any depth for a relative one, with ``~`` read both ways
    (rule_patterns); a folder row (``<dir>/*``) also protects the folder itself, which a move or
    a link would carry away. ``fold`` compares without case: a case-insensitive volume (macOS)
    opens ``.Claude/settings.json`` as ``.claude/settings.json`` (F-30)."""
    if fold:
        forms = [form.casefold() for form in forms]
    for pattern in rule_patterns(rule):
        pattern = pattern.casefold() if fold else pattern
        patterns = [pattern, pattern[:-2]] if pattern.endswith("/*") else [pattern]
        for form in forms:
            for each in patterns:
                if fnmatch.fnmatchcase(form, each) or fnmatch.fnmatchcase(form, f"*/{each}"):
                    return True
    return False


def judge_file(tool: str, path: str, cwd: str | None, rules: list[Rule], agent: str | None) -> Verdict:
    forms = file_forms(path, cwd)
    matched = [r for r in rules if applies(r, tool, agent) and matches_file(r, forms, restrictive(r))]
    return resolve(matched, "no rule matched")


def restrictive(rule: Rule) -> bool:
    """``never`` and ``ask`` rows read a path without case; an ``allow`` row never does, so a
    fold can only add an ask or a deny (F-30)."""
    return rule.decision != "allow"


def mcp_words(tool: str) -> list[str]:
    """The words of an MCP tool's own name (after the last ``__``): snake, kebab and camel case."""
    name = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", tool.rsplit("__", 1)[-1])
    return [word for word in re.split(r"[^A-Za-z0-9]+", name.lower()) if word]


def mcp_is_read(tool: str) -> bool:
    """A read verb first, and no write word joined to it (``get_or_create_user``, ``list_and_delete``).
    A write word used as a noun stays a read (``get_commit``, ``get_workflow_run``); ``checkout`` is
    not ``check``."""
    words = mcp_words(tool)
    if not words or words[0] not in MCP_READ_VERBS:
        return False
    joined = (words[i + 1] for i, word in enumerate(words[:-1]) if word in MCP_JOINERS)
    return not MCP_WRITE_WORDS.intersection(joined)


def judge_mcp(tool: str, rules: list[Rule], agent: str | None) -> Verdict:
    """never > owner allow > owner or project ask > a read or a default allow (host UI tools) >
    default ask. A default rule never cancels an ask the owner or the project wrote."""
    matched = [r for r in rules if applies(r, tool, agent) and fnmatch.fnmatchcase(tool, r.pattern)]
    nevers = [r for r in matched if r.decision == "never"]
    if nevers:
        return Verdict(DENY, nevers[0])
    if any(allow_counts(r) for r in matched):
        return Verdict(None, None, "allow rule")
    tighter = [r for r in matched if r.decision == "ask" and r.layer != "default"]
    if tighter:
        return Verdict(ASK, tighter[0])
    if mcp_is_read(tool):
        return Verdict(None, None, "read tool")
    if any(r.decision == "allow" and r.layer == "default" for r in matched):
        return Verdict(None, None, "host tool")
    return resolve(matched, "no rule matched")


def judge(tool: str, tool_input: dict, cwd: str | None, rules: list[Rule], agent: str | None) -> Verdict:
    if tool == "Bash":
        return judge_bash(str(tool_input.get("command", "")), rules, agent, cwd)[0]
    if tool in FILE_TOOLS:
        path = tool_input.get("file_path") or tool_input.get("notebook_path") or ""
        return judge_file(tool, str(path), cwd, rules, agent) if path else Verdict(None, None, "no path")
    if tool.startswith("mcp__"):
        return judge_mcp(tool, rules, agent)
    return Verdict(None, None, "tool not governed")


# ---------------------------------------------------------------- commands


BUILDER_TYPE_RE = re.compile(r"^cobot:(builder|[a-z0-9-]+-builder)$")
CHECKS_HEADER_RE = re.compile(r"^\s*[-*]?\s*`?Checks`?:\s*(.*)$")
REPORT_SECTION_RE = re.compile(r"^\s*[-*]?\s*`?(Files|Deps added|Open|Noticed)`?:")
EXIT_MARKER_RE = re.compile(r"(?:\bexit(?: code)?\s*:?\s*\d+|(?:→|->)\s*\d+)")
COMMAND_RE = re.compile(r"`[^`\n]+`")
CHECKS_NONE_RE = re.compile(r"^none\s*[—–-]+\s*\S")
REPORT_BLOCK_REASON = (
    "builder report lacks command and exit code under Checks:; re-run the task and require each check as "
    "`<command>` → exit <n> with its output tail, or `Checks: none — <reason>`"
)


def checks_block(report: str) -> tuple[str, list[str]] | None:
    """The text after the Checks: header and the lines of its block, or None when absent."""
    lines = report.splitlines()
    for index, line in enumerate(lines):
        match = CHECKS_HEADER_RE.match(line)
        if not match:
            continue
        block: list[str] = []
        for following in lines[index + 1 :]:
            if REPORT_SECTION_RE.match(following):
                break
            block.append(following)
        return match.group(1).strip(), block
    return None


def check_report(report: str) -> tuple[bool, str]:
    """A builder report passes with `Checks: none — <reason>` or with a command carrying an exit marker."""
    found = checks_block(report)
    if found is None:
        return False, "no Checks: section"
    head, block = found
    if CHECKS_NONE_RE.match(head):
        return True, "checks: none, reason given"
    text = "\n".join([head, *block])
    if COMMAND_RE.search(text) and EXIT_MARKER_RE.search(text):
        return True, "command and exit code present"
    return False, "Checks: without a `command` and an exit marker"


def response_text(response: object) -> str:
    if isinstance(response, str):
        return response
    if isinstance(response, dict):
        return response_text(response.get("content", ""))
    if isinstance(response, list):
        return "\n".join(str(block.get("text", "")) for block in response if isinstance(block, dict))
    return ""


NOTICED_HEADER_RE = re.compile(r"^\s*[-*]?\s*`?Noticed`?:\s*(.*)$")
NOTICED_BULLET_RE = re.compile(r"^\s*[-*]\s+(.+)$")
NO_NOTICE_RE = re.compile(r"(?i)^(none|nothing|n/a|—|-)\.?$")


def noticed_items(report: str) -> list[str]:
    """The items under a builder's ``Noticed:``: the text on its line, then each bullet below it
    until the next section; ``none`` or ``nothing`` is no item (spec memory-and-ship, story 3)."""
    lines = report.splitlines()
    for index, line in enumerate(lines):
        match = NOTICED_HEADER_RE.match(line)
        if not match:
            continue
        items = [match.group(1).strip()]
        for following in lines[index + 1 :]:
            if REPORT_SECTION_RE.match(following) or CHECKS_HEADER_RE.match(following):
                break
            bullet = NOTICED_BULLET_RE.match(following)
            if bullet:
                items.append(bullet.group(1).strip())
        return [item for item in items if item and not NO_NOTICE_RE.match(item)]
    return []


def park_noticed(items: list[str], cwd: str | None, wait: bool = True) -> None:
    """Hand the items to ``cobot-memory noticed add`` in the session's checkout; never raises: a
    report hook must not strand a session over its notices. A hook passes ``wait=False``: the park
    runs detached, so it can never push the hook past its timeout and lose the decision."""
    argv = [sys.executable, "-I", str(plugin_root() / "bin" / "cobot-memory"), "noticed", "add"]
    text = "\n".join(items) + "\n"
    try:
        if wait:
            subprocess.run(  # noqa: S603 - fixed argv, no shell
                argv, cwd=cwd or None, input=text, capture_output=True, text=True, timeout=5, check=False
            )
            return
        child = subprocess.Popen(  # noqa: S603 - fixed argv, no shell
            argv, cwd=cwd or None, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, text=True, start_new_session=True,
        )  # fmt: skip
        child.stdin.write(text)
        child.stdin.close()
    except Exception:  # noqa: BLE001, S110 - parking is best effort; wrap reads what landed
        pass


# ---------------------------------------------------------------- builder reports in every host

UNPROVEN = "UNPROVEN: "  # what the orchestrator sees on a report let through without proof
UNPROVEN_CONTEXT = "UNPROVEN: the builder's report has no command and exit code; do not tick its task"
REPORT_STATE_DAYS = 7


def report_state_path(session: str) -> Path:
    return data_dir().parent / "reports" / f"{session}.json"


def load_report_state(path: Path) -> dict:
    """``{"refused": [keys], "allowed": [key:digest]}``; empty on any defect, so a broken or planted
    file never switches the check off."""
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        state = {}
    state = state if isinstance(state, dict) else {}
    lists = {key: state.get(key) for key in ("refused", "allowed")}
    return {
        key: [v for v in value if isinstance(v, str)] if isinstance(value, list) else []
        for key, value in lists.items()
    }


def save_report_state(path: Path, state: dict) -> None:
    """Through a temporary file and a rename (the temporary never outlives a failure); session files
    older than a week are pruned, and a pruning race is nobody's error."""
    temporary = path.with_suffix(f".{os.getpid()}.tmp")
    try:
        temporary.write_text(json.dumps(state), encoding="utf-8")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)
    try:
        cutoff = time.time() - REPORT_STATE_DAYS * 86400
        for old in [*path.parent.glob("*.json"), *path.parent.glob("*.tmp"), *path.parent.glob("*.lock")]:
            if old.stem.split(".")[0] != path.stem and old.stat().st_mtime < cutoff:
                old.unlink(missing_ok=True)
    except OSError:
        pass


def judge_report(text: str, agent_type: str, key: str, session: object) -> tuple[str, list[str]]:
    """``allow``, ``deny`` or ``unproven`` for one builder report, wherever it was delivered, and the
    notices to park. ``key`` names the builder (its agent id, or the call's tool_use_id). The state
    is read, decided and written under one lock, so parallel builders keep each other's records. A
    report this builder already had let through is not judged again; a first failure is refused
    once; a second failure, or one whose refusal cannot be recorded, goes through marked unproven."""
    digest = hashlib.sha256(text.removeprefix(UNPROVEN).encode()).hexdigest()
    path = report_state_path(session) if isinstance(session, str) and SESSION_RE.match(session) else None
    try:
        if not key or not path:
            raise OSError("no builder or session to record against")
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.with_suffix(".lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            state = load_report_state(path)
            if f"{key}:{digest}" in state["allowed"]:
                return "allow", []
            ok, why = check_report(text)
            verdict = "allow" if ok else "unproven" if key in state["refused"] else "deny"
            if verdict == "deny":
                state["refused"].append(key)
            else:  # let through, proven or marked: a later path does not judge it again
                state["allowed"].append(f"{key}:{digest}")
            save_report_state(path, state)
    except OSError:
        ok, why = check_report(text)
        verdict = "allow" if ok else "unproven"  # a refusal that cannot be recorded is never made
    log_event({"tool": "report", "head": agent_type, "decision": verdict, "reason": why})
    items = noticed_items(text) if verdict != "deny" else []
    if verdict == "unproven":
        first = next((line.strip() for line in text.splitlines() if line.strip()), "")[:120]
        items.insert(0, f"unproven report from {agent_type}: {first}")
    return verdict, items


def handback(stdin: str, wait: bool = True) -> str | None:
    """PreToolUse on SubagentHandback: the report a background builder hands back (the desktop app,
    probe of 2026-11-18). A failing first report is denied, so the builder works again; a second is
    let through with its message marked ``UNPROVEN:``. Anything odd allows."""
    try:
        payload = json.loads(stdin)
        agent_type = str(payload.get("agent_type", ""))
        if payload.get("tool_name") != "SubagentHandback" or not BUILDER_TYPE_RE.match(agent_type):
            return None
        tool_input = payload.get("tool_input")
        if not isinstance(tool_input, dict) or not isinstance(tool_input.get("message"), str):
            return None
        key = str(payload.get("agent_id") or "")
        verdict, items = judge_report(tool_input["message"], agent_type, key, payload.get("session_id"))
        if items:
            park_noticed(items, payload.get("cwd"), wait)
    except Exception as error:  # noqa: BLE001 - a report hook must never strand a session
        print(f"cobot report: unreadable hand-back ({type(error).__name__}); allowing", file=sys.stderr)
        return None
    if verdict == "deny":
        decision = {"permissionDecision": "deny", "permissionDecisionReason": REPORT_BLOCK_REASON}
    elif verdict == "unproven":
        marked = {**tool_input, "message": UNPROVEN + tool_input["message"]}
        decision = {"permissionDecision": "allow", "updatedInput": marked}
    else:
        return None
    return json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", **decision}})


def report(stdin: str, wait: bool = True) -> str | None:
    """PostToolUse on Agent: a foreground builder's report (the CLI), judged through the same state as
    the hand-back, so a report already let through is not judged twice. The builder is named by the
    result's agentId, else by the call's tool_use_id. Anything odd allows."""
    try:
        payload = json.loads(stdin)
        if payload.get("tool_name") != "Agent":
            return None
        subagent = str((payload.get("tool_input") or {}).get("subagent_type", ""))
        if not BUILDER_TYPE_RE.match(subagent):
            return None
        response = payload.get("tool_response")
        if isinstance(response, dict) and response.get("status") == "async_launched":
            return None  # the hand-back's PreToolUse judges it (probe of 2026-11-18)
        agent_id = str(response.get("agentId") or "") if isinstance(response, dict) else ""
        key = agent_id or str(payload.get("tool_use_id") or "")
        verdict, items = judge_report(response_text(response), subagent, key, payload.get("session_id"))
        if items:
            park_noticed(items, payload.get("cwd"), wait)
    except Exception as error:  # noqa: BLE001 - a report hook must never strand a session
        print(f"cobot report: could not read the payload ({type(error).__name__}); allowing", file=sys.stderr)
        return None
    if verdict == "deny":
        return json.dumps({"decision": "block", "reason": REPORT_BLOCK_REASON})
    if verdict == "unproven":
        context = {"hookEventName": "PostToolUse", "additionalContext": UNPROVEN_CONTEXT}
        return json.dumps({"hookSpecificOutput": context})
    return None


def hook_output(decision: str, reason: str) -> str:
    return json.dumps(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": decision,
                "permissionDecisionReason": reason[:REASON_LIMIT],
            }
        }
    )


def log_event(payload: dict) -> None:
    path = os.environ.get("COBOT_GATE_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(payload) + "\n")


PUSH_RE = re.compile(r"(?:^|[;&|]\s*|\s)(?:rtk\s+)?git\s+push\b")
STAMP_SUFFIX_LIMIT = 72


def stamp_suffix(cwd: str | None) -> str:
    """` · stamp: <line>` from cobot-memory for a git push that asks; empty when it cannot be read."""
    try:
        out = subprocess.run(  # noqa: S603 - fixed argv, no shell
            [sys.executable, "-I", str(plugin_root() / "bin" / "cobot-memory"), "stamp"],
            cwd=cwd or None,
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except Exception:  # noqa: BLE001 - a missing suffix must never block the push verdict
        return ""
    line = out.stdout.strip().splitlines()[0] if out.returncode == 0 and out.stdout.strip() else ""
    if not line:
        return ""
    if line.startswith("missing"):
        line += "; run /cobot:wrap"
    return f" · stamp: {line}"[:STAMP_SUFFIX_LIMIT]


def gate(stdin: str) -> str | None:
    try:
        payload = json.loads(stdin)
        tool = str(payload.get("tool_name", ""))
        cwd = payload.get("cwd")
        agent = payload.get("agent_type") or payload.get("agent_name")
        rules, warnings, _ = load_rules(cwd)
        for warning in warnings:
            print(f"cobot gate: {warning}", file=sys.stderr)
        verdict = judge(tool, payload.get("tool_input") or {}, cwd, rules, agent)
        tool_input = payload.get("tool_input") or {}
        head = str(
            tool_input.get("command") or tool_input.get("file_path") or tool_input.get("notebook_path") or ""
        )
        log_event(
            {
                "tool": tool,
                "head": head[:120],
                "decision": verdict.decision,
                "reason": verdict.reason(),
                "agent": agent,
            }
        )
    except Exception as error:  # noqa: BLE001 - any failure must end in "ask"
        return hook_output(ASK, f"cobot gate could not judge the call ({type(error).__name__}: {error})")
    if verdict.decision is None:
        return None
    suffix = stamp_suffix(cwd) if tool == "Bash" and verdict.decision == ASK and PUSH_RE.search(head) else ""
    reason = verdict.reason(REASON_LIMIT - len(suffix)) + suffix
    if tool == "Bash" and verdict.decision == ASK:
        reason = with_offer(reason, verdict, payload.get("session_id"), rules)
    return hook_output(verdict.decision, reason)


# ---------------------------------------------------------------- a repeated ask names its allow line

# rows whose ask guards local, undoable work: never an outward, install, credential, agent-scoped or
# owner-written row (an offer of ``allow Bash(*)`` would silence an agent's whole read list)
OFFERED_ROWS = frozenset({"ask Bash(git commit*)", "ask Bash(git rebase*)"})
OFFER_AFTER = 3  # the ask that names the line: two were shown before it
ASK_STATE_DAYS = 7
SESSION_RE = re.compile(r"^[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\Z")  # \Z: no trailing newline


def ask_state_path(session: str) -> Path:
    return data_dir().parent / "asks" / f"{session}.json"


def owner_rules_shown() -> str:
    """The owner layer's path as the owner would type it (``~`` for the home folder)."""
    path, home = str(fixed_layer_paths()["owner"]), str(Path.home())
    return "~" + path[len(home) :] if path.startswith(home + os.sep) else path


def offered_rows(verdict: Verdict, rules: list[Rule]) -> list[str]:
    """The offered rows among the verdict's asks, its own and those in ``also``; none that the
    owner layer also holds (the owner wrote that ask, and deletes it)."""
    owned = {r.text() for r in rules if r.layer == "owner"}
    labels = [verdict.rule.text()] if verdict.rule and verdict.rule.layer == "default" else []
    labels += [label.split(" via ", 1)[0] for label in verdict.also]
    return [row for row in dict.fromkeys(labels) if row in OFFERED_ROWS and row not in owned]


def load_ask_state(path: Path) -> dict:
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"counts": {}, "offered": []}
    if not isinstance(state, dict):
        return {"counts": {}, "offered": []}
    counts = state.get("counts") if isinstance(state.get("counts"), dict) else {}
    offered = state.get("offered") if isinstance(state.get("offered"), list) else []
    return {"counts": counts, "offered": offered}


def save_ask_state(path: Path, state: dict) -> None:
    """Write through a temporary file and a rename; prune session files older than a week."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps(state), encoding="utf-8")
    os.replace(temporary, path)
    cutoff = time.time() - ASK_STATE_DAYS * 86400
    for old in path.parent.glob("*.json"):
        if old != path and SESSION_RE.match(old.stem) and old.stat().st_mtime < cutoff:
            old.unlink(missing_ok=True)


def with_offer(reason: str, verdict: Verdict, session: object, rules: list[Rule]) -> str:
    """Count the verdict's offered rows for the session; from the third ask of one, end the reason
    with the owner allow line that would lift it, once, when it fits. Any error: the reason as is."""
    try:
        rows = offered_rows(verdict, rules)
        if not rows or not isinstance(session, str) or not SESSION_RE.match(session):
            return reason
        path = ask_state_path(session)
        state = load_ask_state(path)
        for row in rows:
            state["counts"][row] = int(state["counts"].get(row, 0)) + 1
        due = [r for r in rows if state["counts"][r] >= OFFER_AFTER and r not in state["offered"]]
        offer = f" · to stop asking: allow {due[0][4:]} in {owner_rules_shown()}" if due else ""
        if offer and len(reason) + len(offer) <= REASON_LIMIT:
            state["offered"].append(due[0])
            reason += offer
        save_ask_state(path, state)
    except Exception:  # noqa: BLE001 - the offer is a courtesy; the verdict stands without it
        return reason
    return reason


# ---------------------------------------------------------------- the gate under agy (spec antigravity)

AGY_DECISION = {None: "allow", ASK: "force_ask", DENY: "deny"}  # allow defers; never auto_approve
BY_NAME = {agy.NO_OPINION: None, agy.ASK: ASK, agy.DENY: DENY}
NO_WORKSPACE = "no workspacePaths: the project rules are unknown"
UNCOMMITTED_RULES = (
    "a new workspace reads the committed rules: .agent/cobot.rules is uncommitted or not in git"
)
RUNTIMES = frozenset({"claude", "agy"})


def agy_output(decision: str | None, reason: str) -> str:
    return json.dumps({"decision": AGY_DECISION[decision], "reason": reason[:REASON_LIMIT]})


def agy_verdict_decision(verdict: Verdict) -> str:
    """Session-cacheable ``ask`` for local repeatable dev asks; ``force_ask`` for everything else."""
    if verdict.decision == ASK:
        return "ask" if verdict_is_session_ask(verdict) else "force_ask"
    return AGY_DECISION[verdict.decision]


def rules_committed(workspaces: list[str]) -> bool:
    """Every workspace is in git, its .agent is a real folder, and its .agent/cobot.rules, when
    present, is tracked with no change: an ignored file (cobot's foreign mode excludes .agent) is
    not in a new checkout, and ``git status`` says nothing about it."""
    for workspace in workspaces:
        root = repo_root(workspace)
        if (root / ".agent").is_symlink():
            return False
        status = git(["status", "--porcelain", "--", RULES_FILE], root)
        if status is None or status:
            return False
        if (root / RULES_FILE).exists() and git(
            ["ls-files", "--error-unmatch", "--", RULES_FILE], root
        ) is None:
            return False
    return bool(workspaces)


def judge_plan(plan: agy.Plan, workspaces: list[str], cwd: str | None) -> Verdict:
    """The verdict for one translated agy call: the strictest over its Claude-shaped calls."""
    if plan.decision is not None:
        return Verdict(BY_NAME[plan.decision], None, plan.note)
    if not workspaces:
        return Verdict(ASK, None, NO_WORKSPACE)
    if plan.needs_committed_rules:
        return (
            Verdict(None, None, plan.note)
            if rules_committed(workspaces)
            else Verdict(ASK, None, UNCOMMITTED_RULES)
        )
    rules, warnings = load_rules_agy(workspaces)
    for warning in warnings:
        print(f"cobot gate: {warning}", file=sys.stderr)
    best = Verdict(None, None, plan.note or "no rule matched")
    calls = list(plan.calls)
    for tool, tool_input in plan.calls:
        if tool in FILE_TOOLS:
            calls += [
                (tool, {"file_path": alias})
                for alias in agy.root_aliases(tool_input["file_path"], workspaces)
            ]
    asks: list[Verdict] = []
    for tool, tool_input in calls:
        verdict = judge(tool, tool_input, plan.cwd or cwd or workspaces[0], rules, None)
        if verdict.decision == ASK:
            asks.append(verdict)
        if outranks(verdict, best):
            best = verdict
    if plan.at_least_ask and best.decision is None:
        return Verdict(ASK, None, plan.note)
    return named_asks(best, asks, None)


def agy_workspaces(value: object) -> list[str]:
    """agy's workspacePaths when it is a list of absolute paths, else none: a call that needs the
    project then asks, rather than reading a folder the hook's own cwd would pick."""
    if isinstance(value, list) and all(isinstance(path, str) and os.path.isabs(path) for path in value):
        return list(value)
    return []


def gate_agy(stdin: str) -> str:
    """One agy decision for a PreToolUse payload; any failure denies (agy runs a call whose hook
    fails)."""
    try:
        payload = json.loads(stdin)
        call = payload["toolCall"]
        name, args = str(call["name"]), call.get("args") or {}
        if not isinstance(args, dict):
            raise TypeError("toolCall.args is not an object")
        workspaces = agy_workspaces(payload.get("workspacePaths"))
        plan = agy.translate(name, args, agy.known_servers(Path.home(), workspaces))
        verdict = judge_plan(plan, workspaces, payload.get("cwd"))
        head = str(
            args.get("CommandLine") or args.get("Input") or args.get("TargetFile") or args.get("Path") or ""
        )
        log_event(
            {"tool": name, "head": head[:120], "decision": verdict.decision, "reason": verdict.reason()}
        )
        base = plan.cwd or payload.get("cwd") or (workspaces[0] if workspaces else None)
        pushes = base and name == "run_command" and verdict.decision == ASK and PUSH_RE.search(head)
        suffix = stamp_suffix(base) if pushes else ""  # no project, no stamp: the hook's folder is the plugin
        reason = verdict.reason(REASON_LIMIT - len(suffix)) + suffix
    except Exception as error:  # noqa: BLE001 - any failure must end in "deny" under agy
        return agy_output(DENY, f"cobot gate could not judge the call ({type(error).__name__}: {error})")
    return json.dumps({"decision": agy_verdict_decision(verdict), "reason": reason[:REASON_LIMIT]})


VALUE_OPTIONS = {
    "check": {"tool", "agent"},
    "explain": {"tool", "agent"},
    "sync": {"settings", "runtime"},
    "gate": {"runtime"},
}
SWITCHES: dict[str, set[str]] = {}


def parse_options(argv: list[str]) -> tuple[list[str], dict[str, str]]:
    """Raises HelpRequested or UsageError (see _cobot_common.parse_cli); the gate takes no option."""
    positional, options, _ = parse_cli(argv, VALUE_OPTIONS, SWITCHES)
    return positional, options


def tool_input_for(tool: str, target: str) -> dict:
    if tool == "Bash":
        return {"command": target}
    if tool in FILE_TOOLS:
        return {"file_path": target}
    return {}


def cmd_check(target: str, options: dict[str, str]) -> str:
    tool = options.get("tool", "Bash")
    rules, _, _ = load_rules(None)
    verdict = judge(tool, tool_input_for(tool, target), None, rules, options.get("agent"))
    return f"{verdict.decision or 'none'}  ({verdict.reason()})"


def cmd_explain(target: str, options: dict[str, str]) -> str:
    tool = options.get("tool", "Bash")
    rules, warnings, _ = load_rules(None)
    agent = options.get("agent")
    lines = [f"tool: {tool}" + (f"  agent: {agent}" if agent else "")]
    if tool == "Bash":
        verdict, trace = judge_bash(target, rules, agent)
        for form, matched in trace:
            lines.append(f"segment: {form}")
            lines.extend(f"  {r.text()}  [{r.layer}:{r.line}]" for r in matched)
            if not matched:
                lines.append("  (no rule)")
    else:
        verdict = judge(tool, tool_input_for(tool, target), None, rules, agent)
    lines.append(f"decision: {verdict.decision or 'none'}  ({verdict.reason()})")
    lines.extend(f"warning: {w}" for w in warnings)
    return "\n".join(lines)


def cmd_show() -> str:
    rules, warnings, paths = load_rules(None)
    lines = [f"{layer}: {path}{'' if path.is_file() else '  (absent)'}" for layer, path in paths.items()]
    counts = {d: sum(r.decision == d for r in rules) for d in ("never", "ask", "allow")}
    lines.append(
        f"rules: {len(rules)}  never={counts['never']}  ask={counts['ask']}  allow={counts['allow']}"
    )
    lines.extend(f"{r.text():60} [{r.layer}:{r.line}]" for r in rules)
    lines.extend(f"warning: {w}" for w in warnings)
    return "\n".join(lines)


def permission_patterns(rule: Rule) -> list[str]:
    """Claude Code permission syntax: prefix patterns only; both plain and rtk forms for Bash."""
    if rule.tool == "mcp":
        # a trailing ``__*`` is a permission form; a * inside the name has none, the hook covers it
        return [] if "*" in rule.pattern[:-1] else [rule.pattern]
    if rule.tool != "Bash":
        return [f"{rule.tool}({rule.pattern})"]
    if "*" in rule.pattern[:-1]:
        return []  # a wildcard inside the pattern has no prefix form; the hook covers it
    prefix = rule.pattern[:-1] if rule.pattern.endswith("*") else rule.pattern
    suffix = ":*" if rule.pattern.endswith("*") else ""
    return [f"Bash({prefix}{suffix})", f"Bash(rtk {prefix}{suffix})"]


def agy_permission_patterns(rule: Rule) -> list[str]:
    """Antigravity settings.json permission syntax: command(...), write_file(...), mcp(srv/tool)."""
    if rule.tool == "mcp":
        parts = rule.pattern.split("__", 2)
        if len(parts) != 3 or parts[0] != "mcp":
            return []
        srv, tool = parts[1], parts[2]
        if "*" in srv or ("*" in tool and tool != "*"):
            return []
        return [f"mcp({srv}/{tool})"]
    if rule.tool in FILE_TOOLS:
        if "*" in rule.pattern[:-1]:
            return []
        prefix = rule.pattern.removesuffix("*")
        return [f"write_file({prefix})"] if prefix else []
    if rule.tool == "Bash":
        if "*" in rule.pattern[:-1]:
            return []
        prefix = rule.pattern.removesuffix("*").rstrip()
        return [f"command({prefix})"] if prefix else []
    return []


def sync_fragment(rules: list[Rule], runtime: str) -> tuple[dict[str, dict[str, list[str]]], list[str]]:
    render = agy_permission_patterns if runtime == "agy" else permission_patterns
    deny = sorted({p for r in rules if r.decision == "never" and not r.agent for p in render(r)})
    allow = sorted(
        {p for r in rules if r.decision == "allow" and r.layer == "owner" and not r.agent for p in render(r)}
    )
    skipped = [r.text() for r in rules if r.decision == "never" and not render(r)]
    if runtime != "agy":
        return {"permissions": {"deny": deny, "allow": allow}}, skipped
    ask = sorted(
        {
            p
            for r in rules
            if not r.agent and (is_local_dev_rule(r) or (r.decision == "ask" and r.layer != "default"))
            for p in render(r)
        }
    )
    return {"permissions": {"deny": deny, "ask": ask, "allow": allow}}, skipped


def default_settings_path(runtime: str) -> Path:
    if runtime == "agy":
        return Path.home() / ".gemini" / "antigravity-cli" / "settings.json"
    return config_dir() / "settings.json"


def cmd_sync(options: dict[str, str]) -> str:
    runtime = options.get("runtime", "claude")
    rules, _, _ = load_rules(None)
    fragment, skipped = sync_fragment(rules, runtime)
    settings_path = Path(options.get("settings") or default_settings_path(runtime))
    current = json.loads(settings_path.read_text(encoding="utf-8")) if settings_path.is_file() else {}
    merged = json.loads(json.dumps(current))
    perms = merged.setdefault("permissions", {})
    for key, entries in fragment["permissions"].items():
        perms[key] = sorted(set(perms.get(key, [])) | set(entries))
    diff = difflib.unified_diff(
        json.dumps(current, indent=2).splitlines(),
        json.dumps(merged, indent=2).splitlines(),
        fromfile=str(settings_path),
        tofile=f"{settings_path} (with cobot rules)",
        lineterm="",
    )
    out = ["# fragment", json.dumps(fragment, indent=2), "# diff (nothing written; apply by hand)", *diff]
    if skipped:
        out.append("# not expressible as permission rules (the hook enforces them): " + "; ".join(skipped))
    return "\n".join(out)


def main(argv: list[str]) -> int:
    try:
        positional, options = parse_options(argv)
    except HelpRequested:
        print(__doc__.strip())
        return 0
    except UsageError as error:
        print(f"cobot-rules: {error}\n\n{__doc__.strip()}", file=sys.stderr)
        return 2
    command = positional[0] if positional else ""
    if command in ("gate", "sync"):
        runtime = options.get("runtime", "claude")
        if runtime not in RUNTIMES:
            print(f"cobot-rules: unknown runtime {runtime!r} (claude or agy)", file=sys.stderr)
            return 2
    if command == "gate":
        output = gate_agy(sys.stdin.read()) if options.get("runtime") == "agy" else gate(sys.stdin.read())
        if output:
            print(output)
        return 0
    if command in ("report", "handback"):
        output = (report if command == "report" else handback)(sys.stdin.read(), wait=False)
        if output:
            print(output)
        return 0
    if command == "check" and len(positional) == 2:
        print(cmd_check(positional[1], options))
        return 0
    if command == "explain" and len(positional) == 2:
        print(cmd_explain(positional[1], options))
        return 0
    if command == "show":
        print(cmd_show())
        return 0
    if command == "sync":
        print(cmd_sync(options))
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
