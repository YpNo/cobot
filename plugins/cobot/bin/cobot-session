#!/usr/bin/env python3
"""cobot-session: the SessionStart payload (protocol + rule counts + memory brief + machine, knowledge and deps lines).

Usage: cobot-session start [--runtime claude|agy] < hook.json
Claude Code: prints hookSpecificOutput.additionalContext, at most 10 000 characters.
Antigravity (agy): prints one injectSteps system message (not a user message: committed memory
must not read as the owner's words), the project from workspacePaths[0], the agy section after
the protocol; the serialised JSON stays within 10 000 characters. Never blocks a session: on any
error it still prints the protocol and one line naming the error.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # python3 -I drops the script dir
import _cobot_agy as agy  # noqa: E402
from _cobot_common import (  # noqa: E402
    memory_dir,
    plugin_root,
    repo_root,
    repo_trust,
    resolve_model_overrides,
)

TOTAL_CAP = 10_000
BRIEF_CAP = 6_000
MACHINE_LINE_CAP = 160  # cobot-env brief (_cobot_env.BRIEF_CAP)
LINES_RESERVE = 500 + MACHINE_LINE_CAP  # room kept for the machine, knowledge and dependency lines
DEADLINE = 25  # seconds shared by every tool call; the hook has 30
RUNTIMES = ("claude", "agy")
CLAUDE_MODELS = frozenset({"sonnet", "opus", "haiku", "inherit"})
AGY_SECTION_CAP = 1_850
AGY_HEADING = "## cobot under Antigravity"
# a hook or plugin in a customization root runs beside the gate and may answer before it
CUSTOMIZATION_FILES = ("hooks.json", "plugins.json", "plugins")
WORKSPACE_WARNING = "warning: agy customizations in this workspace run beside cobot's gate"
WORKSPACE_SHOWN = 5
DEFAULT_GROUP_WARNING = (
    "warning: cobot's agy hook group has its default name `cobot`, which a repository's"
    " .agents/hooks.json can switch off: tell the owner to reinstall with ./install.sh --agy"
)
WORKSPACE_PATH_SHOWN = 160  # the tail of a deep path: the root and file names stay readable
WORKSPACE_WARNING_CAP = 1_200


def protocol_text() -> str:
    return (plugin_root() / "protocol.md").read_text(encoding="utf-8").strip()


class Clock:
    """One deadline shared by the tool calls of a payload."""

    def __init__(self, seconds: float = DEADLINE) -> None:
        self.end = time.monotonic() + seconds

    def left(self) -> float:
        return max(self.end - time.monotonic(), 0.5)


def run_tool(name: str, args: list[str], cwd: str | None, clock: Clock | None = None) -> str:
    timeout = min(20.0, clock.left()) if clock else 20.0
    try:
        out = subprocess.run(  # noqa: S603 - fixed argv, no shell
            [sys.executable, "-I", str(plugin_root() / "bin" / name), *args],
            capture_output=True,
            text=True,
            cwd=cwd,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return f"{name} {args[0]}: timed out"
    return out.stdout.strip()


def rule_counts(cwd: str | None, clock: Clock) -> str:
    for line in run_tool("cobot-rules", ["show"], cwd, clock).splitlines():
        if line.startswith("rules:"):
            return line
    return "rules: unavailable"


def status_lines(cwd: str | None, clock: Clock) -> str:
    """Knowledge staleness (decision 23) and dependency currency from its cache (decision 21)."""
    knowledge = run_tool("cobot-memory", ["knowledge", "--brief"], cwd, clock) or "knowledge: unavailable"
    dependencies = run_tool("cobot-deps", ["brief"], cwd, clock) or "deps: unavailable"
    return "\n".join(line.splitlines()[0] if line else "" for line in (knowledge, dependencies))


def machine_line(cwd: str | None, clock: Clock) -> str:
    """The machine by presence and the owner's answers (decision 29); cobot-env runs no program."""
    line = run_tool("cobot-env", ["brief"], cwd, clock)
    return (line.splitlines()[0] if line else "machine: unavailable")[:MACHINE_LINE_CAP]


def brief_parts(cwd: str | None, room: int) -> list[str]:
    """Rule counts, the memory brief within ``room`` (capped at BRIEF_CAP), the machine line and
    the status lines."""
    clock = Clock()
    budget = min(BRIEF_CAP, room - LINES_RESERVE)
    return [
        rule_counts(cwd, clock),
        run_tool("cobot-memory", ["brief", "--budget", str(budget)], cwd, clock),
        machine_line(cwd, clock),
        status_lines(cwd, clock),
    ]


def error_line(error: Exception) -> str:
    return f"cobot session: brief unavailable ({type(error).__name__}: {error})"


def model_overrides_line(runtime: str, cwd: str | None) -> str:
    """Active per-agent model overrides (project < owner < COBOT_AGENT_MODELS), if any."""
    allowed = agy.AGENT_TIERS if runtime == "agy" else CLAUDE_MODELS
    agent_dir: Path | None = None
    trusted = False
    if cwd and os.path.isdir(cwd):
        agent_dir = memory_dir(cwd)
        trusted = repo_trust(repo_root(cwd), agent_dir)[0]
    try:
        overrides = resolve_model_overrides(runtime, allowed, agent_dir=agent_dir, trusted=trusted)
    except (OSError, ValueError) as error:
        return f"agent models: invalid override ({error})"
    if not overrides:
        return ""
    summary = ", ".join(f"{agent}={model}" for agent, model in sorted(overrides.items()))
    return f"agent models (overrides): {summary}"


def build_payload(stdin: str) -> str:
    protocol = protocol_text()
    try:
        payload = json.loads(stdin) if stdin.strip() else {}
        cwd = payload.get("cwd")
        overrides = model_overrides_line("claude", cwd)
        head_parts = [p for p in (protocol, overrides) if p]
        room = TOTAL_CAP - sum(len(p) for p in head_parts)
        parts = [*head_parts, *brief_parts(cwd, room)]
    except Exception as error:  # noqa: BLE001 - a session must still start
        parts = [protocol, error_line(error)]
    return "\n\n".join(p for p in parts if p)[:TOTAL_CAP]


# ---------------------------------------------------------------- Antigravity (agy)


def agy_section() -> str:
    """Antigravity host adapter: tool/skill/agent mapping, plan mode, model routing and gaps."""
    return f"""{AGY_HEADING}
- Plugin folder `{plugin_root()}`: bin/ is not on PATH; run `python3 -I <plugin folder>/bin/<tool> ...` \
for cobot-memory, cobot-rules, cobot-deps and cobot-env. Skills live at `<plugin folder>/skills/<name>/SKILL.md`: \
read with `read_file` (or `view_file`), or type `/<name>` (without `cobot:`).
- Tools & names: Agent → `invoke_subagent` with unprefixed TypeName (`challenger`, `auditor`, `consultant`, \
`learner`, `builder`, `*-builder`), AskUserQuestion → `ask_question`, parallel lanes → `Workspace="share"`, \
reviews → `challenger` + `auditor` on `git diff`.
- Plan mode: respect `plan` mode; do not edit repository files until the owner switches out of plan mode.
- Models: defaults match task (`pro` for design/audit/languages, `flash` for `consultant`/`builder`); pass \
`Model="pro"` on `invoke_subagent` for `[risk]` or overridden agents. For `swarm`: Carbon (design/audit), \
Hydrogen (code), Argon (research), Flash (checklists).
- Owner-only: onboard, rules and security-sweep run only when the owner types them; security-sweep and learn \
run through `invoke_subagent` or not at all.
- Children receive the workspace's AGENTS.md and GEMINI.md.
- A builder's proof (command and exit code) is requested, not enforced: read it before you trust the report.
- Builders' tool calls are not proven gated under agy: review their diff before any outward step."""


def workspace_warning(workspaces: list[str]) -> str:
    """One line naming the hook and plugin files agy would load beside cobot, or empty."""
    found = [
        str(folder / root / name)
        for workspace in workspaces
        if os.path.isabs(workspace) and os.path.isdir(workspace)
        for folder in agy.folders_to_root(Path(workspace))
        for root in agy.CUSTOMIZATION_ROOTS
        for name in CUSTOMIZATION_FILES
        if (folder / root / name).exists()
    ]
    if not found:
        return ""
    found = list(dict.fromkeys(found))
    more = f" and {len(found) - WORKSPACE_SHOWN} more" if len(found) > WORKSPACE_SHOWN else ""
    shown = [
        path if len(path) <= WORKSPACE_PATH_SHOWN else "…" + path[-WORKSPACE_PATH_SHOWN:] for path in found
    ]
    line = (
        f"{WORKSPACE_WARNING} and may answer before it. Tell the owner before your first tool call,"
        f" and do not edit them: {', '.join(shown[:WORKSPACE_SHOWN])}{more}"
    )
    return line[:WORKSPACE_WARNING_CAP]


def default_group_warning(root: Path | None = None) -> str:
    """The warning when the installed hook group kept the guessable name (a bare ``agy plugin
    install``), or empty."""
    try:
        groups = json.loads(((root or plugin_root()) / "hooks.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    return DEFAULT_GROUP_WARNING if isinstance(groups, dict) and "cobot" in groups else ""


def agy_project(payload: dict) -> str | None:
    """The first workspace, when it is an absolute folder; hooks run in the plugin folder."""
    paths = payload.get("workspacePaths") or []
    first = paths[0] if isinstance(paths, list) and paths else None
    return first if isinstance(first, str) and os.path.isabs(first) and os.path.isdir(first) else None


def agy_message(text: str) -> str:
    return json.dumps({"injectSteps": [{"systemMessage": {"systemMessage": text}}]})


def agy_answer(stdin: str) -> str:
    """The agy SessionStart answer: the protocol, the agy section, then the brief; the tail is cut
    until the serialised JSON fits, so the cap never reaches the agy section."""
    protocol = protocol_text()
    head = [protocol]
    try:
        head.append(agy_section())
        payload = json.loads(stdin) if stdin.strip() else {}
        payload = payload if isinstance(payload, dict) else {}
        project = agy_project(payload)
        paths = payload.get("workspacePaths")
        warning = workspace_warning(
            [p for p in paths if isinstance(p, str)] if isinstance(paths, list) else []
        )
        head += [line for line in (model_overrides_line("agy", project), default_group_warning(), warning) if line]
        room = TOTAL_CAP - sum(len(part) for part in head)
        tail = (
            brief_parts(project, room)
            if project
            else ["cobot session: project unknown (no workspace folder)"]
        )
    except Exception as error:  # noqa: BLE001 - a session must still start
        tail = [error_line(error)]
    fixed = "\n\n".join(head)
    rest = "\n\n".join(p for p in tail if p)
    out = agy_message(f"{fixed}\n\n{rest}" if rest else fixed)
    while len(out) > TOTAL_CAP and rest:
        rest = rest[: max(len(rest) - (len(out) - TOTAL_CAP), 0)]
        out = agy_message(f"{fixed}\n\n{rest}" if rest else fixed)
    return out


def runtime_of(argv: list[str]) -> str | None:
    """``start`` or ``start --runtime <claude|agy>``; None for anything else."""
    if argv == ["start"]:
        return "claude"
    if len(argv) == 3 and argv[:2] == ["start", "--runtime"] and argv[2] in RUNTIMES:
        return argv[2]
    return None


def main(argv: list[str]) -> int:
    runtime = runtime_of(argv)
    if runtime is None:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if runtime == "agy":
        print(agy_answer(sys.stdin.read()))
        return 0
    context = build_payload(sys.stdin.read())
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
