allow Bash(gh release view*) @consultant
allow Bash(gh release list*) @consultant
allow Bash(gh api repos/*) @consultant
allow Bash(gh api users/*) @consultant
allow Bash(gh api orgs/*) @consultant
allow Bash(glab api projects/*) @consultant
