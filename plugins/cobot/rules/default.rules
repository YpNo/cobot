ask Bash(tea assets delete*)
ask Bash(tea repos create*)
ask Bash(tea repos fork*)
ask Bash(tea repos migrate*)
ask Bash(tea repos edit*)
ask Bash(tea webhooks*)
ask Bash(tea branches*)
ask Bash(tea actions*)
ask Bash(tea api -X POST*)
ask Bash(tea api -X PUT*)
ask Bash(tea api -X PATCH*)
ask Bash(gh pr comment*)
ask Bash(gh pr review*)
ask Bash(gh issue create*)
ask Bash(gh issue comment*)
ask Bash(gh api -X POST*)
ask Bash(gh api -X PUT*)
ask Bash(gh api -X PATCH*)
ask Bash(gh api --method POST*)
ask Bash(gh api --method PUT*)
ask Bash(gh api --method PATCH*)
# a body flag without -X is an implicit POST: the canonical form rewrites it, so these rows see it
ask Bash(glab api -X POST*)
ask Bash(glab api -X PUT*)
ask Bash(glab api -X PATCH*)
ask Bash(glab api --method POST*)
ask Bash(glab api --method PUT*)
ask Bash(glab api --method PATCH*)
ask Bash(ansible-playbook*)
