# cobot default rules (layer: default). Owner layer: ~/.claude/cobot.rules.
# Project layer: .agent/cobot.rules (never / ask only). Syntax: decision Tool(pattern) [@agent]
# never: denied in every layer, cannot be relaxed. ask: the gate asks unless an owner allow matches.

# outward and irreversible: never
never Bash(git push --force*)
never Bash(git push -f*)
never Bash(git push * --force*)
never Bash(git push * -f)
never Bash(git push * -f *)
never Bash(git push * --force-with-lease*)
never Bash(git push +*)
# authorship: no attribution footer, no AI named as author (decision 18; not a word ban)
never Bash(git commit*Co-Authored-By*)
never Bash(git commit*Co-authored-by*)
never Bash(gh pr create*Generated with*)
never Bash(gh pr edit*Generated with*)
never Bash(glab mr create*Generated with*)
never Bash(glab mr update*Generated with*)
never Bash(gt pr create*Generated with*)
never Bash(gt pr edit*Generated with*)
never Bash(tea pulls create*Generated with*)
never Bash(tea pulls edit*Generated with*)
never Bash(git push * +*)
# Terraform state surgery and unlocked runs (spec session-grants): no prompt and no grant reaches
# them; `-lock=` takes every false spelling Go accepts, with one dash or two
never Bash(terraform state rm*)
never Bash(terraform state mv*)
never Bash(terraform state push*)
never Bash(terraform state replace-provider*)
never Bash(terraform force-unlock*)
never Bash(terraform import*)
never Bash(terraform taint*)
never Bash(terraform untaint*)
never Bash(terraform workspace delete*-force*)
never Bash(terraform *-lock=[0fF]*)
never Bash(tofu state rm*)
never Bash(tofu state mv*)
never Bash(tofu state push*)
never Bash(tofu state replace-provider*)
never Bash(tofu force-unlock*)
never Bash(tofu import*)
never Bash(tofu taint*)
never Bash(tofu untaint*)
never Bash(tofu workspace delete*-force*)
never Bash(tofu *-lock=[0fF]*)
never Bash(terragrunt *state rm*)
never Bash(terragrunt *state mv*)
never Bash(terragrunt *state push*)
never Bash(terragrunt *state replace-provider*)
never Bash(terragrunt *force-unlock*)
never Bash(terragrunt *import*)
never Bash(terragrunt *taint*)
never Bash(terragrunt *workspace delete*-force*)
never Bash(terragrunt *-lock=[0fF]*)
# cloud state, projects, IAM replacement and keys (spec session-grants)
never Bash(gcloud storage rm*tfstate*)
never Bash(gcloud storage buckets delete*tfstate*)
never Bash(gsutil *rm *tfstate*)
never Bash(gcloud projects delete*)
never Bash(gcloud * set-iam-policy*)
never Bash(gcloud iam service-accounts keys create*)
# the kubeconfig names what a context means: a rename would carry a grant to another cluster
never Bash(kubectl config rename-context*)
never Bash(kubectl config set-context*)
never Bash(kubectl config set-cluster*)
never Bash(kubectl config set-credentials*)
never Bash(kubectl config delete-*)
never Edit(~/.kube/*)
never Write(~/.kube/*)
# a diff that prints secret values in clear (spec debug-path, story 2)
never Bash(kubectl diff*--show-secrets*)
# cluster-wide wipes
never Bash(kubectl delete*--all-namespaces*)
never Bash(kubectl delete* -A)
never Bash(kubectl delete* -A *)
never Bash(kubectl delete namespace kube-system*)
never Bash(kubectl delete namespaces kube-system*)
never Bash(kubectl delete ns kube-system*)
never Bash(kubectl delete namespace/kube-system*)
never Bash(kubectl delete ns/kube-system*)
# a recursive delete of the root or of home, and only those
never Bash(rm -* /)
never Bash(rm -* ~)
never Bash(rm -* ~/)
never Bash(rm -* $HOME)
never Bash(rm -* $HOME/)
never Bash(rm -* ${HOME})
never Bash(rm -* ${HOME}/)
# cobot's owner files: a grant or a rule written here would widen the gate (sealed: shell access
# to them is refused too)
never Edit(~/.claude/cobot.rules)
never Write(~/.claude/cobot.rules)
never Edit(~/.claude/cobot/*)
never Write(~/.claude/cobot/*)
never Bash(cargo publish*)
never Bash(npm publish*)
never Bash(pnpm publish*)
never Bash(uv publish*)
never Bash(gh release create*)
never Bash(glab release create*)
never Bash(gt release create*)
never Bash(gt release publish*)
never Bash(tea releases create*)
never Bash(gh repo delete*)
never Bash(glab repo delete*)
never Bash(gt repo delete*)
never Bash(tea repos delete*)
# forge deletions (spec gate-f36-f40-f44, story 2): refused like gh repo delete; aliases and -R
# are rewritten first, so `gh secret remove` and `gh release -R o/r delete` reach these rows
never Bash(gh release delete*) # deletes a release on the forge
never Bash(gh secret delete*) # deletes a repository secret
never Bash(gh variable delete*) # deletes a repository variable
never Bash(gh label delete*) # deletes a label
never Bash(gh cache delete*) # deletes an Actions cache
never Bash(gh run delete*) # deletes a workflow run
never Bash(gh gist delete*) # deletes a gist
never Bash(gh ssh-key delete*) # deletes an SSH key from your account
never Bash(gh gpg-key delete*) # deletes a GPG key from your account
never Bash(gh issue delete*) # deletes an issue
never Bash(gh repo deploy-key delete*) # deletes a deploy key
never Bash(gh codespace delete*) # deletes a codespace
never Bash(glab ci delete*) # deletes a pipeline
never Bash(glab variable delete*) # deletes a CI variable
never Bash(glab release delete*) # deletes a release on the forge
never Bash(glab issue delete*) # deletes an issue
never Bash(glab mr delete*) # deletes a merge request
never Bash(glab label delete*) # deletes a label
never Bash(glab schedule delete*) # deletes a pipeline schedule
never Bash(glab deploy-key delete*) # deletes a deploy key
never Bash(glab ssh-key delete*) # deletes an SSH key from your account
never Bash(glab gpg-key delete*) # deletes a GPG key from your account
never Bash(gt pr delete*) # deletes a pull request
never Bash(gt issue delete*) # deletes an issue
never Bash(gt release delete*) # deletes a release on the forge
never Bash(tea comments delete*) # deletes a comment
never Bash(tea releases delete*) # deletes a release on the forge
never Bash(tea assets delete*) # deletes a release asset
never Bash(gh repo autolink delete*) # deletes an autolink
never Bash(gh project delete*) # deletes a project
never Bash(gh project item-delete*) # deletes a project item
never Bash(gh project field-delete*) # deletes a project field
never Bash(glab snippet delete*) # deletes a snippet
never Bash(glab token revoke*) # revokes an access token
never Bash(glab securefile remove*) # deletes a secure file
never Bash(glab securefile delete*) # deletes a secure file
never Bash(glab mr del*) # deletes a merge request
never Bash(glab issue del*) # deletes an issue
never Bash(tea labels delete*) # deletes a label
never Bash(tea milestones delete*) # deletes a milestone
never Bash(tea webhooks delete*) # deletes a webhook
never Bash(gt label delete*) # deletes a label
never Bash(gt milestone delete*) # deletes a milestone
never Bash(git tag -a v*)
never Bash(gh api -X DELETE*)
never Bash(gh api --method DELETE*)
never Bash(glab api -X DELETE*)
never Bash(glab api --method DELETE*)
never Bash(gt api -X DELETE*)
never Bash(tea api -X DELETE*)
never Edit(~/.claude/settings*.json)
never Write(~/.claude/settings*.json)
never Edit(.claude/settings*.json)
never Write(.claude/settings*.json)
# Antigravity (agy): its settings, hooks, MCP servers, installed plugins, command sidecars and
# access grants; and in every customization root, at any depth, the files that add a hook or a
# plugin, which run outside the gate and may answer auto_approve. `*` crosses folders here.
never Edit(~/.gemini/antigravity-cli/settings*.json)
never Edit(~/.gemini/config/*)
never Edit(~/.gemini/jetski/*)
never Write(~/.gemini/antigravity-cli/settings*.json)
never Write(~/.gemini/config/*)
never Write(~/.gemini/jetski/*)
never Edit(.agents/hooks.json)
never Edit(.agents/plugins.json)
never Edit(.agents/skills.json)
never Edit(.agents/plugins/*)
never Edit(.agent/hooks.json)
never Edit(.agent/plugins.json)
never Edit(.agent/skills.json)
never Edit(.agent/plugins/*)
never Edit(_agents/hooks.json)
never Edit(_agents/plugins.json)
never Edit(_agents/skills.json)
never Edit(_agents/plugins/*)
never Edit(_agent/hooks.json)
never Edit(_agent/plugins.json)
never Edit(_agent/skills.json)
never Edit(_agent/plugins/*)
never Write(.agents/hooks.json)
never Write(.agents/plugins.json)
never Write(.agents/skills.json)
never Write(.agents/plugins/*)
never Write(.agent/hooks.json)
never Write(.agent/plugins.json)
never Write(.agent/skills.json)
never Write(.agent/plugins/*)
never Write(_agents/hooks.json)
never Write(_agents/plugins.json)
never Write(_agents/skills.json)
never Write(_agents/plugins/*)
never Write(_agent/hooks.json)
never Write(_agent/plugins.json)
never Write(_agent/skills.json)
never Write(_agent/plugins/*)
# agy plugin and its alias plugins: disabling, removing or relinking cobot drops the gate
never Bash(agy *plugin* disable*cobot*)
never Bash(agy *plugin* uninstall*cobot*)
never Bash(agy *plugin* link*cobot*)

# outward or destructive: ask
# apply and destroy (spec session-grants): the owner answers each at the prompt; an owner allow
# line and a grant never answer them for the owner
ask Bash(terragrunt apply*) # prompt only: each apply is yours to approve
ask Bash(terragrunt destroy*) # prompt only: each destroy is yours to approve
ask Bash(terragrunt * apply*) # prompt only: each apply is yours to approve
ask Bash(terragrunt * destroy*) # prompt only: each destroy is yours to approve
ask Bash(terraform apply*) # prompt only: each apply is yours to approve
ask Bash(terraform destroy*) # prompt only: each destroy is yours to approve
ask Bash(tofu apply*) # prompt only: each apply is yours to approve
ask Bash(tofu destroy*) # prompt only: each destroy is yours to approve
# agy plugin install replaces a plugin in place, and a nested agy session runs outside this gate;
# the owner layer may add `allow Bash(agy plugin validate*)`
ask Bash(agy) # may replace or bypass the cobot gate
ask Bash(agy *) # may replace or bypass the cobot gate
ask Bash(install.sh*) # installs or refreshes cobot itself
ask Bash(git push*)
ask Bash(gh pr create*)
ask Bash(gh repo fork*)
ask Bash(gh alias set*) # a gh alias can run any command, and the gate cannot read it later
ask Bash(gh alias import*) # a gh alias can run any command, and the gate cannot read it later
