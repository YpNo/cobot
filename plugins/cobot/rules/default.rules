ask Bash(nix flake update*)
ask Bash(nix flake lock*)
# installing a tool on the machine is the owner's: onboarding prints these routes, never runs them
# (decision 29); mise use without -g writes the repository's mise.toml, so every form asks
ask Bash(mise use*)
ask Bash(mise install*)
ask Bash(brew install*)
ask Bash(uv tool install*)
ask Bash(pipx install*)
ask Bash(apt install*)
ask Bash(apt-get install*)
ask Bash(dnf install*)
