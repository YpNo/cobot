never Bash(gcloud * print-identity-token) # prints a credential into the transcript
never Bash(gcloud * config-helper) # prints a credential into the transcript
never Bash(gcloud secrets versions access*) # prints a credential into the transcript
ask Bash(git credential fill*) # prints a credential into the transcript
ask Bash(git credential-* get*) # prints a credential into the transcript
ask Bash(docker-credential-* get*) # prints a credential into the transcript
