# cloud reads for the read-only agents (decision 28): silent like gh api repos/*. The gate cuts a
# gcloud command after its verb, so the gcloud rows carry no trailing star; a segment that could
# run repository content (an environment assignment, git -c, --kubeconfig, --post-renderer,
# --enable-exec, --enable-helm) never matches these allows. Secret values stay out: the never
# rows below win over every allow.
never Bash(kubectl get *[sS][eE][cC][rR][eE][tT]*) @consultant
never Bash(kubectl get *[sS][eE][cC][rR][eE][tT]*) @learner
never Bash(kubectl get *-f *) @consultant
never Bash(kubectl get *-f *) @learner
never Bash(kubectl get *-k *) @consultant
never Bash(kubectl get *-k *) @learner
never Bash(kubectl get *--filename*) @consultant
never Bash(kubectl get *--filename*) @learner
never Bash(kubectl get *--kustomize*) @consultant
never Bash(kubectl get *--kustomize*) @learner
never Bash(kubectl config view*--raw*) @consultant
never Bash(kubectl config view*--raw*) @learner
never Bash(kubectl config view*--flatten*) @consultant
never Bash(kubectl config view*--flatten*) @learner
# the kubeconfig holds cluster credentials; anchored at the command so a glob elsewhere is no match
never Bash(cat ~/.kube/*) @consultant
never Bash(cat -* ~/.kube/*) @consultant
never Bash(cat $HOME/.kube/*) @consultant
never Bash(head ~/.kube/*) @consultant
never Bash(head -* ~/.kube/*) @consultant
never Bash(head $HOME/.kube/*) @consultant
never Bash(tail ~/.kube/*) @consultant
never Bash(tail -* ~/.kube/*) @consultant
never Bash(tail $HOME/.kube/*) @consultant
never Bash(cat ~/.kube/*) @learner
never Bash(cat -* ~/.kube/*) @learner
never Bash(cat $HOME/.kube/*) @learner
never Bash(head ~/.kube/*) @learner
never Bash(head -* ~/.kube/*) @learner
never Bash(head $HOME/.kube/*) @learner
never Bash(tail ~/.kube/*) @learner
never Bash(tail -* ~/.kube/*) @learner
never Bash(tail $HOME/.kube/*) @learner
