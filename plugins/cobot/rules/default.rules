ask Bash(istioctl uninstall*)
ask Bash(istioctl x*)
ask Bash(gcloud container fleet mesh*)
ask Bash(gcloud * create*)
ask Bash(gcloud * delete*)
ask Bash(gcloud * update*)
ask Bash(gcloud * ssh*)
# gcloud verbs the first rows missed (decision 26, slice 3): the gate cuts the command after its
# verb, so these match the canonical form exactly; add-*/set-*/remove-* families included
ask Bash(gcloud * add-*)
ask Bash(gcloud * remove-*)
ask Bash(gcloud * set-*)
ask Bash(gcloud * attach-*)
ask Bash(gcloud * detach-*)
ask Bash(gcloud * restore*)
