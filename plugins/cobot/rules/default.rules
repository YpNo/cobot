ask Bash(helm registry login*)
ask Bash(istioctl waypoint apply*)
ask Bash(istioctl waypoint delete*)
ask Bash(istioctl tag set*)
ask Bash(istioctl tag remove*)
ask Bash(istioctl create-remote-secret*)
# adding a dependency is a decision (decision 22); bare installs from a lockfile stay silent
ask Bash(cargo add*)
ask Bash(cargo install*)
ask Bash(npm install *)
ask Bash(npm i *)
ask Bash(npm add*)
ask Bash(pnpm add*)
ask Bash(yarn add*)
ask Bash(bun add*)
ask Bash(go get*)
ask Bash(uv add*)
ask Bash(pip install*)
ask Bash(pip3 install*)
ask Bash(poetry add*)
ask Bash(nix flake update*)
ask Bash(nix flake lock*)
# promoting learned lines into the plugin repository is the owner's decision (ADR-0002)
ask Bash(*cobot-memory learn *--promote*)
# goreleaser release publishes unless --snapshot or --skip=publish; the owner layer may allow the snapshot form
ask Bash(goreleaser release*)
ask Bash(gh codespace ssh*)
ask Bash(rm -rf*)
ask Bash(rm -fr*)
ask Bash(git reset --hard*)
ask Bash(git clean*)
ask Bash(git rebase*)
ask Bash(git commit*)
ask Bash(docker run*)
ask Bash(docker push*)
ask Bash(podman push*)
ask Bash(docker system prune*)
ask Bash(podman system prune*)
ask Bash(docker volume rm*)
ask Bash(docker rm*)
ask Bash(docker rmi*)
ask Bash(docker login*)
ask Bash(podman login*)
ask Bash(podman run*)
# MCP: every tool asks, except a read (the last part of its name starts with list, get, describe,
# search or read, and joins no write word to it as get_or_create or list_and_delete do:
# MCP_READ_VERBS, MCP_JOINERS, MCP_WRITE_WORDS in cobot-rules) and the desktop host's UI tools
# named below, each by its exact name so a tool the host adds later asks until it is reviewed. Order for MCP:
# never > owner allow > owner or project ask > a read or a host tool > this catch-all. Owners
# widen one server with `allow mcp__<server>__*` (a browser server acts with your sign-ins, so it
# asks until you do).
ask mcp__*
allow mcp__ccd_turn__update_plan
allow mcp__ccd_turn__wrap_up
allow mcp__ccd_session__mark_chapter
allow mcp__ccd_session__dismiss_task
allow mcp__ccd_view__show_pane
allow mcp__ccd_view__close_pane
allow mcp__ccd_view__get_layout
allow mcp__ccd_view__set_transcript_view
allow mcp__visualize__read_me
allow mcp__visualize__show_widget

# agent scopes: consultant and learner are read-only. Everything asks except this read list
# (an agent-scoped allow in this layer silences the gate; never rules above still win).
ask Bash(*) @consultant
ask Bash(*) @learner
allow Bash(git status*) @consultant
allow Bash(git log*) @consultant
allow Bash(git show*) @consultant
