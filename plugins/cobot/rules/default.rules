ask Bash(pacman -Sy*)
ask Bash(zypper install*)
ask Bash(zypper in *)
ask Bash(apk add*)
ask Bash(nix profile install*)
# promoting learned lines into the plugin repository is the owner's decision (ADR-0002)
# anchored on the command word: a leading * would match any substituted argument (gate-substitution spec)
ask Bash(cobot-memory learn *--promote*)
ask Bash(python3 *cobot-memory learn *--promote*)
ask Bash(python *cobot-memory learn *--promote*)
# goreleaser release publishes unless --snapshot or --skip=publish; the owner layer may allow the snapshot form
ask Bash(goreleaser release*)
ask Bash(gh codespace ssh*)
ask Bash(rm -rf*)
ask Bash(rm -fr*)
ask Bash(git reset --hard*)
ask Bash(git clean*)
ask Bash(git rebase*)
ask Bash(git commit*)
# a new project: git init only on the owner's yes (a folder inside another repository, or ~)
ask Bash(git init*)
ask Bash(docker run*)
ask Bash(docker push*)
ask Bash(podman push*)
ask Bash(docker system prune*)
ask Bash(podman system prune*)
ask Bash(docker volume rm*)
ask Bash(docker rm*)
ask Bash(docker rmi*)
ask Bash(docker login*)
ask Bash(podman login*)
ask Bash(podman run*)
# MCP: every tool asks, except a read (the last part of its name starts with list, get, describe,
# search or read, and joins no write word to it as get_or_create or list_and_delete do:
# MCP_READ_VERBS, MCP_JOINERS, MCP_WRITE_WORDS in cobot-rules) and the desktop host's UI tools
# named below, each by its exact name so a tool the host adds later asks until it is reviewed. Order for MCP:
# never > owner allow > owner or project ask > a read or a host tool > this catch-all. Owners
# widen one server with `allow mcp__<server>__*` (a browser server acts with your sign-ins, so it
# asks until you do).
ask mcp__*
allow mcp__ccd_turn__update_plan
allow mcp__ccd_turn__wrap_up
allow mcp__ccd_session__mark_chapter
allow mcp__ccd_session__dismiss_task
allow mcp__ccd_view__show_pane
allow mcp__ccd_view__close_pane
allow mcp__ccd_view__get_layout
allow mcp__ccd_view__set_transcript_view
allow mcp__visualize__read_me
allow mcp__visualize__show_widget

# Google Cloud remote MCP servers registered as gcp-* (expert-gcp, "Google Cloud MCP servers"):
# their writes are refused, not asked; writes stay with gcloud and Terraform under the rules
# above. Verbs from tools/list of logging, container, run, bigquery, compute, sqladmin, firestore,
# pubsub, monitoring, cloudresourcemanager and iam, 2026-11-11 (GOOGLE_MCP_TOOLS in
# tests/test_cobot_rules.py); a write with another first word still asks through the catch-all. execute is exact: execute_sql_readonly is a read.
never mcp__gcp-*__add_*
never mcp__gcp-*__apply_*
never mcp__gcp-*__cancel_*
never mcp__gcp-*__clone_*
never mcp__gcp-*__create_*
never mcp__gcp-*__delete_*
never mcp__gcp-*__deploy_*
never mcp__gcp-*__import_*
never mcp__gcp-*__insert_*
never mcp__gcp-*__patch_*
never mcp__gcp-*__publish_*
never mcp__gcp-*__remove_*
never mcp__gcp-*__reset_*
never mcp__gcp-*__restore_*
never mcp__gcp-*__set_*
never mcp__gcp-*__start_*
never mcp__gcp-*__stop_*
never mcp__gcp-*__undelete_*
never mcp__gcp-*__update_*
never mcp__gcp-*__upload_*
never mcp__gcp-*__write_*
never mcp__gcp-*__publish
never mcp__gcp-*__execute_sql
# Google Cloud CLI server (Preview, cloudcli.googleapis.com/mcp): run_gcloud_command and
# run_bq_command take a whole command the gate cannot see into, under a cloud-platform token.
# Refused under any server name, so a rename does not lift it (spec gcp-mcp-opt-in, owner Q2).
never mcp__gcp-cloudcli__*
never mcp__*__run_gcloud_command
never mcp__*__run_bq_command

# The owner registers every MCP server (spec gcp-mcp-opt-in): an injected `claude mcp add` could
# name an attacker URL gcp-*, so registration asks by every route. list and get stay silent.
ask Bash(claude *mcp add*)
ask Bash(claude *mcp remove*)
ask Bash(claude *--mcp-config*)
# a settings file can turn on every project server (enableAllProjectMcpServers), skipping the
# approval a repository .mcp.json needs; reset-project-choices forgets the owner's refusals
ask Bash(claude *--settings*)
ask Bash(claude *mcp reset-project-choices*)
ask Bash(claude-code *mcp *)
# Claude Code run through node by its own cli.js reaches the same verbs (bunx is opaque, F-53)
ask Bash(node *@anthropic-ai/claude-code/*)
ask Edit(~/.claude.json)
ask Write(~/.claude.json)
ask Edit(.mcp.json)
ask Write(.mcp.json)
# A shell word naming either file asks too (cp, tee, a redirection, dd of=, curl -o), as for a
# protected file; a glob that only could name them does not (protected_file_touched).

# agent scopes: consultant and learner are read-only. Everything asks except this read list
