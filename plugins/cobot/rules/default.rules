# credential printers (story 4): the named printers, not every way a secret can be printed
ask Bash(gh auth token*) # prints a credential into the transcript
ask Bash(gh auth status --prints-credential) # prints a credential into the transcript
ask Bash(glab auth status --prints-credential) # prints a credential into the transcript
ask Bash(glab config*get*token*) # prints a credential into the transcript
ask Bash(git-credential-* get*) # prints a credential into the transcript
never Bash(kubectl config view*--flatten*) # prints a credential into the transcript
