{
  "$description": "Semantic design tokens, W3C Design Tokens Format Module 2025.10 (.tokens.json). Modes: light is the default, dark is listed under $extensions.cobot.modes.dark. Generated outputs (CSS custom properties, Tailwind @theme) come from this file, never the other way round.",
  "color": {
    "$type": "color",
    "text": {
      "primary": { "$value": "#1a1a1a", "$description": "Body text on surface; 4.5:1 minimum against color.surface.base", "$extensions": { "cobot": { "modes": { "dark": "#f2f2f2" } } } },
      "muted": { "$value": "#595959", "$description": "Secondary text; still 4.5:1 on surface.base (7.0:1 measured)", "$extensions": { "cobot": { "modes": { "dark": "#b3b3b3" } } } }
    },
    "surface": {
      "base": { "$value": "#ffffff", "$extensions": { "cobot": { "modes": { "dark": "#121212" } } } },
      "raised": { "$value": "#f5f5f5", "$extensions": { "cobot": { "modes": { "dark": "#1e1e1e" } } } }
    },
    "accent": {
      "default": { "$value": "#0b57d0", "$description": "Buttons and links; 3:1 against surface.base for the component edge (1.4.11), 4.5:1 as text" },
      "on-accent": { "$value": "#ffffff" }
    },
    "focus": { "ring": { "$value": "#0b57d0", "$description": "2 px ring, offset 2 px, 3:1 against adjacent colours" } }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } }
    },
    "target": { "min": { "$value": { "value": 24, "unit": "px" }, "$description": "WCAG 2.5.8" }, "touch": { "$value": { "value": 48, "unit": "px" } } },
    "radius": { "sm": { "$value": { "value": 4, "unit": "px" } }, "md": { "$value": { "value": 8, "unit": "px" } } }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "body": { "$value": { "value": 1, "unit": "rem" } },
      "small": { "$value": { "value": 0.875, "unit": "rem" } },
      "h3": { "$value": { "value": 1.25, "unit": "rem" } },
      "h2": { "$value": { "value": 1.5625, "unit": "rem" } },
      "h1": { "$value": { "value": 1.953, "unit": "rem" } }
    },
    "lineHeight": { "$type": "number", "body": { "$value": 1.5 }, "heading": { "$value": 1.2 } }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" }, "$description": "0 ms under prefers-reduced-motion: reduce" }
  }
}
