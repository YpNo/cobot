#!/usr/bin/env python3
"""partner-session: the SessionStart payload (protocol + rule counts + memory brief).

Usage: partner-session start < hook.json
Prints hookSpecificOutput.additionalContext, at most 10 000 characters. Never blocks a session:
on any error it still prints the protocol and one line naming the error.
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # python3 -I drops the script dir
from _partner_common import plugin_root  # noqa: E402

TOTAL_CAP = 10_000
BRIEF_CAP = 6_000


def protocol_text() -> str:
    return (plugin_root() / "protocol.md").read_text(encoding="utf-8").strip()


def run_tool(name: str, args: list[str], cwd: str | None) -> str:
    out = subprocess.run(  # noqa: S603 - fixed argv, no shell
        [sys.executable, "-I", str(plugin_root() / "bin" / name), *args], capture_output=True, text=True, cwd=cwd, timeout=20, check=False
    )
    return out.stdout.strip()


def rule_counts(cwd: str | None) -> str:
    for line in run_tool("partner-rules", ["show"], cwd).splitlines():
        if line.startswith("rules:"):
            return line
    return "rules: unavailable"


def build_payload(stdin: str) -> str:
    protocol = protocol_text()
    try:
        payload = json.loads(stdin) if stdin.strip() else {}
        cwd = payload.get("cwd")
        budget = min(BRIEF_CAP, TOTAL_CAP - len(protocol) - 200)
        parts = [protocol, rule_counts(cwd), run_tool("partner-memory", ["brief", "--budget", str(budget)], cwd)]
    except Exception as error:  # noqa: BLE001 - a session must still start
        parts = [protocol, f"partner session: brief unavailable ({type(error).__name__}: {error})"]
    return "\n\n".join(p for p in parts if p)[:TOTAL_CAP]


def main(argv: list[str]) -> int:
    if argv[:1] != ["start"]:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    context = build_payload(sys.stdin.read())
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context}}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
