{
  "description": "Rules gate: judges every command before it runs; never widens permissions; blocks on any failure.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
