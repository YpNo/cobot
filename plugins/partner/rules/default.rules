allow Bash(git tag --list*) @learner
allow Bash(gh pr view*) @learner
allow Bash(gh pr checks*) @learner
allow Bash(gh pr diff*) @learner
allow Bash(gh pr list*) @learner
allow Bash(gh issue view*) @learner
allow Bash(gh issue list*) @learner
allow Bash(gh run view*) @learner
allow Bash(gh run list*) @learner
allow Bash(gh release view*) @learner
allow Bash(gh release list*) @learner
allow Bash(gh api repos/*) @learner
allow Bash(gh api users/*) @learner
allow Bash(gh api orgs/*) @learner
